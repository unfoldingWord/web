{
  "name": "unfoldingword-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "predev": "node scripts/build-font-css.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-font-css.mjs",
    "build": "astro build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "npm run check:locales && npm run check:redirects && npm run check:links && npm run check:experiments",
    "check:locales": "node scripts/check-locales.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test worker/*.test.mjs",
    "geo": "uvx --from geo-optimizer-skill geo audit",
    "check:experiments": "node scripts/check-experiments.mjs",
    "embeds:upload": "wrangler r2 object put unfoldingword-media/embeds/virtuous-signup.html --file embeds/virtuous-signup.html --remote --content-type 'text/html; charset=utf-8' --cache-control 'public, max-age=300'"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "@astrojs/sitemap": "3.7.6",
    "astro": "7.4.13",
    "html-to-text": "10.0.1",
    "marked": "18.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261125.1",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-myanmar": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/pt-serif": "5.3.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/html-to-text": "9.0.4",
    "pagefind": "1.6.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "wrangler": "4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true
  }
}
