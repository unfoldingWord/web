---
// /styleguide/ — every design token and every content block on one page, so a
// design change in src/styles/global.css can be checked in one place (open it
// on a phone too). Not linked from the site and not indexed.
import Base from '../layouts/Base.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import type { Block } from '../content.config';

const colors = [
  ['inspire', '#31ADE3', 'Primary brand blue: shapes, rules, large text on Ocean'],
  ['inspire-ink', '#0B6E9E', 'Links and small blue text on white'],
  ['ocean', '#014263', 'Headlines, number bands, give band, primary button'],
  ['ocean-900', '#012C42', 'Deep Ocean: heroes, footer'],
  ['tech', '#231F20', 'Body text'],
  ['ink-muted', '#5B5557', 'Muted text: leads, dates, captions'],
  ['cultivate', '#70C9CC', 'Teal: links and labels on dark grounds'],
  ['kindle', '#E59D33', 'The Give button; emphasis on Ocean only'],
  ['mist', '#F4F9FB', 'Ground for grids of cards'],
  ['line', '#DCE6EB', 'Borders and dividers'],
];
const portfolios = [
  ['transformation', 'Transformation', '#70C9CC', '#E2F4F5'],
  ['innovation', 'Innovation', '#31ADE3', '#D6EFFA'],
  ['catalyzation', 'Catalyzation', '#014263', '#CCD9E0'],
  ['equipping', 'Equipping Partners', '#E59D33', '#FAEBD6'],
];
const img = 'styleguide/sample.jpg';
const alt = 'unfoldingWord logo on a deep blue background';
const blocks: Block[] = [
  { type: 'hero', variant: 'ocean', eyebrow: 'Eyebrow', title: 'Hero · ocean variant', lead: 'A lead paragraph of one or two sentences that introduces the page.', actions: [{ label: 'Give', href: '/give/', style: 'give' }, { label: 'Secondary', href: '/about/', style: 'secondary' }] },
  { type: 'hero', variant: 'split', eyebrow: 'Eyebrow', title: 'Hero · split variant', lead: 'Text beside a photo.', image: img, imageAlt: alt, actions: [{ label: 'Primary', href: '/about/', style: 'primary' }] },
  { type: 'hero', variant: 'light', title: 'Hero · light variant', lead: 'For utility and long-form pages.', actions: [] },
  { type: 'prose', title: 'Prose block', eyebrow: 'Prose', background: 'white', width: 'prose', serif: false, body: 'Body text with **bold**, a [link](/about/) and a list:\n\n- First item\n- Second item\n\n> A blockquote for emphasis.\n\n### A third-level heading\n\nMore text.' },
  { type: 'cards', title: 'Cards · 3 columns', intro: 'Optional introduction.', columns: 3, background: 'mist', items: [
    { title: 'With an image', body: 'Short description.', href: '/about/', image: img, imageAlt: alt },
    { title: 'With an icon', body: 'Short description.', href: '/about/', icon: 'church' },
    { title: 'Text only', body: 'No link, no image.' },
  ] },
  { type: 'split', eyebrow: 'Split', title: 'Text beside an image', body: 'Paragraph text.', image: img, imageAlt: alt, imagePosition: 'end', background: 'white', actions: [{ label: 'Learn more', href: '/about/', style: 'primary' }] },
  { type: 'stats', title: 'Stats', background: 'ocean', items: [{ value: '1.45 billion', label: 'people without the whole Bible' }, { value: '16', label: 'site languages' }, { value: '100%', label: 'open-licensed' }, { value: '3,000', label: 'illustrations' }] },
  { type: 'quote', quote: 'A quotation from someone in the story.', attribution: 'Name', role: 'Role, place' },
  { type: 'steps', title: 'Steps', items: [{ title: 'First', body: 'What happens first.' }, { title: 'Second', body: 'Then this.' }, { title: 'Third', body: 'And finally this.' }] },
  { type: 'faq', title: 'FAQ', items: [{ q: 'A question?', a: 'The answer, in **Markdown**.' }, { q: 'Another question?', a: 'Another answer.' }] },
  { type: 'resources', title: 'Resources', items: [{ title: 'A PDF', description: 'Description.', href: '/about/', kind: 'pdf', meta: '24 pages' }, { title: 'An app', href: '/about/', kind: 'app' }] },
  { type: 'trust', title: 'Trust' },
  { type: 'cta', variant: 'ocean', title: 'Call to action · ocean', body: 'Supporting sentence.', actions: [{ label: 'Give', href: '/give/', style: 'give' }] },
  { type: 'cta', variant: 'kindle', title: 'Call to action · kindle', actions: [{ label: 'Primary', href: '/give/', style: 'primary' }] },
  { type: 'cta', variant: 'mist', title: 'Call to action · mist', actions: [{ label: 'Secondary', href: '/give/', style: 'secondary' }] },
];
---

<Base switcherPath="/" locale="en" basePath="/styleguide/" title="Style guide" description="Every design token and content block of the unfoldingword.org design system, for reviewing design changes." noindex pageType="styleguide">
  <section class="bg-mist">
    <div class="container-page flex flex-col gap-4 pt-12 pb-14 md:pt-16">
      <h1>Style guide</h1>
      <p class="lead max-w-[760px]">Tokens and shared classes live in <code>src/styles/global.css</code>; blocks in <code>src/components/blocks/</code>; how to use them in <code>docs/content-guide.md</code>; the specification in <code>docs/design-system/</code>.</p>
    </div>
  </section>

  <div class="container-page flex flex-col gap-16 py-[var(--spacing-section)]">
    <section class="flex flex-col gap-6">
      <h2>Color</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {colors.map(([name, hex, use]) => (
          <li class="uw-card-flat">
            <div class="h-20 border-b border-line" style={`background:var(--color-${name})`} />
            <div class="p-4 text-sm"><strong class="block font-heading text-ocean">{name}</strong><code>{hex}</code><p class="mt-1 text-ink-muted">{use}</p></div>
          </li>
        ))}
      </ul>
      <h3>Portfolios</h3>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {portfolios.map(([key, name, hex, tint]) => (
          <li class:list={['uw-card-flat', `pf-${key}`]}>
            <div class="pf-bg flex h-24 items-end p-4 font-heading text-h5 font-black">{name}</div>
            <div class="flex flex-col items-start gap-2 p-4 text-sm">
              <span class="pf-chip">{name}</span>
              <code>{hex} · tint {tint}</code>
              <code>.pf-{key}</code>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="flex flex-col gap-5">
      <h2>Type</h2>
      <p class="font-heading text-display font-black text-ocean">Display</p>
      <h1>Heading 1</h1>
      <h2>Heading 2</h2>
      <h3>Heading 3</h3>
      <h4>Heading 4 · card title</h4>
      <p class="lead max-w-[760px]">Lead paragraph (<code>.lead</code>): one or two sentences under a heading.</p>
      <p class="max-w-[760px]">Body text, 17px. The church is the hero: local believers translate Scripture into their own language. <a href="#">A link</a>.</p>
      <p class="label">Label inside a card</p>
      <blockquote class="uw-quote uw-quote-rule max-w-[760px]">“A person’s own words are always PT Serif.”</blockquote>
      <div class="flex flex-wrap items-end gap-12">
        <div><p class="uw-impact text-ocean">130</p><p class="text-ink-muted">.uw-impact: one per moment</p></div>
        <div><p class="uw-figure text-ocean">1.45B</p><p class="text-ink-muted">.uw-figure: number bands</p></div>
      </div>
      <div class="prose prose-serif"><p>Stories and prayer requests read in PT Serif at 20px on the 720px column (<code>.prose-serif</code>).</p></div>
    </section>

    <section class="flex flex-col gap-5">
      <h2>Buttons, links and pills</h2>
      <div class="flex flex-wrap items-center gap-3">
        <a class="uw-btn uw-btn-give" href="#">Give</a>
        <a class="uw-btn uw-btn-primary" href="#">Primary</a>
        <a class="uw-btn uw-btn-secondary" href="#">Secondary</a>
        <a class="uw-btn uw-btn-give uw-btn-lg" href="#">Give · large</a>
        <a class="uw-more" href="#">Text link with arrow →</a>
      </div>
      <div class="uw-grain on-dark flex flex-wrap gap-3 rounded-card p-6">
        <a class="uw-btn uw-btn-give" href="#">Give</a>
        <a class="uw-btn uw-btn-primary" href="#">Primary on dark</a>
        <a class="uw-btn uw-btn-secondary" href="#">Secondary on dark</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {portfolios.map(([key, name]) => (
          <div class:list={['pf-bg flex flex-col items-start gap-3 rounded-card p-6', `pf-${key}`]}>
            <strong>{name} panel</strong>
            <a class="uw-btn uw-btn-give" href="#">Give</a>
            <a class="uw-btn uw-btn-secondary" href="#">Secondary</a>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="uw-pill" aria-pressed="true">All regions</button>
        <button type="button" class="uw-pill" aria-pressed="false">Africa</button>
        <button type="button" class="uw-pill" aria-pressed="false">Pacific</button>
        <span class="chip">Chip</span>
        <span class="chip chip-outline">Chip outline</span>
        {portfolios.map(([key, name]) => <span class:list={['pf-chip', `pf-${key}`]}>{name}</span>)}
      </div>
    </section>

    <section class="flex flex-col gap-5">
      <h2>Cards and grounds</h2>
      <div class="grid gap-6 rounded-media bg-mist p-6 sm:grid-cols-3 sm:p-10">
        <div class="uw-card p-7"><h3 class="text-h4">.uw-card</h3><p class="text-ink-muted">White, 20px corners, soft shadow. For cards on Mist.</p></div>
        <div class="uw-card-flat p-7"><h3 class="text-h4">.uw-card-flat</h3><p class="text-ink-muted">White with a 1px line. For cards on white.</p></div>
        <div class="rounded-small border border-line bg-white p-5"><h3 class="text-h5">rounded-small</h3><p class="text-ink-muted">Small cards and fields.</p><input class="uw-input mt-3" placeholder=".uw-input" aria-label="Sample field" /></div>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="uw-grain on-dark rounded-media p-8"><h3>.uw-grain</h3><p class="lead">Ocean: number bands, give band.</p></div>
        <div class="uw-grain-deep on-dark rounded-media p-8"><h3>.uw-grain-deep</h3><p class="lead">Deep Ocean: heroes.</p></div>
        <div class="rounded-media bg-mist p-8"><h3>bg-mist</h3><p class="lead">Grids of cards.</p></div>
      </div>
    </section>

    <section class="flex flex-col gap-3">
      <h2>Content blocks</h2>
      <p class="lead max-w-[760px]">Every block below is rendered by BlockRenderer from sample data.</p>
    </section>
  </div>
  <BlockRenderer blocks={blocks} locale="en" />
</Base>
