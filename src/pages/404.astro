---
// Served by Workers for any path with no asset (not_found_handling:
// "404-page"), with a 404 status. One English page: the request's locale is
// not known at build time. A Mist header with the title, two lines of help,
// the way home and a search box that uses the site's Pagefind index.
import Base from '../layouts/Base.astro';
import { ui } from '../i18n';
const t = ui('en');
---

<Base switcherPath="/" locale="en" basePath="/404/" title={t.notFoundTitle} description="The page you were looking for could not be found on unfoldingword.org." noindex pageType="404">
  <section class="bg-mist">
    <div class="container-page flex min-h-[70vh] flex-col justify-center gap-5 py-[var(--spacing-section)]">
      <p class="uw-impact text-ocean" aria-hidden="true">404</p>
      <h1>{t.notFoundTitle}</h1>
      <div class="lead flex max-w-[640px] flex-col gap-2">
        <p>Sorry, the page you were looking for does not exist.</p>
        <p>We recently updated our website. Feel free to <a href="/contact/">contact us</a> and let us know what page you were trying to find.</p>
      </div>
      <div class="mt-3 flex flex-wrap gap-3">
        <a href="/" class="uw-btn uw-btn-primary">Back to Home</a>
        <a href="/contact/" class="uw-btn uw-btn-secondary">Contact us</a>
      </div>
      <form action="/search/" method="get" class="mt-4 flex w-full max-w-[560px] flex-wrap gap-3" role="search">
        <label for="q404" class="sr-only">Search unfoldingword.org</label>
        <input id="q404" name="q" type="search" placeholder="Search unfoldingword.org" class="uw-input min-w-0 flex-[1_1_240px]" />
        <button type="submit" class="uw-btn uw-btn-primary">{t.search}</button>
      </form>
    </div>
  </section>
</Base>
