---
// Every content page on the site, in every locale. The list of URLs comes
// from src/lib/routes.ts; this file only picks the template.
import { allRoutes, type Route } from '../lib/routes';
import { ui, localizePath } from '../i18n';
import PageTemplate from '../components/templates/PageTemplate.astro';
import StoryTemplate from '../components/templates/StoryTemplate.astro';
import PrayerTemplate from '../components/templates/PrayerTemplate.astro';
import SweetTemplate from '../components/templates/SweetTemplate.astro';
import experiments from '../data/experiments.json';

export async function getStaticPaths() {
  const routes = await allRoutes();
  const byKey = new Map(routes.map((r) => [`${r.locale}:${r.basePath}`, r]));
  return routes.map((route) => {
    const data = route.entry.data as { variantOf?: string; experiment?: string };
    // Generate the variant at its hidden asset path, with the public page's
    // canonical, breadcrumbs, language links and indexing policy.
    let page = route;
    let experiment;
    if (route.kind === 'variant') {
      const control = byKey.get(`${route.locale}:${data.variantOf}`);
      const test = experiments.find((e) => e.id === data.experiment && e.path === control?.path);
      const variant = test?.variants.find((v) => v.page === route.path);
      if (!control || !test || !variant) throw new Error(`Unregistered A/B variant: ${route.path}`);
      page = { ...control, entry: route.entry };
      experiment = { id: test.id, variant: variant.id };
    }
    const crumbs: { name: string; href?: string }[] = [{ name: ui(page.locale).home, href: localizePath('/', page.locale) }];
    const parts = page.basePath.split('/').filter(Boolean);
    for (let i = 1; i < parts.length; i++) {
      const p = `/${parts.slice(0, i).join('/')}/`;
      const parent = byKey.get(`${page.locale}:${p}`);
      if (parent) crumbs.push({ name: parent.entry.data.title, href: parent.path });
    }
    crumbs.push({ name: route.entry.data.title });
    const path = route.path === '/' ? undefined : route.path.replace(/^\/|\/$/g, '');
    return { params: { path }, props: { route: page, crumbs, experiment } };
  });
}

interface Props {
  route: Route;
  experiment?: { id: string; variant: string };
  crumbs: { name: string; href?: string }[];
}
const { route, crumbs, experiment } = Astro.props;
---

{route.kind === 'pages' && <PageTemplate route={route} crumbs={crumbs} experiment={experiment} />}
{route.kind === 'stories' && <StoryTemplate route={route} crumbs={crumbs} />}
{route.kind === 'prayer' && <PrayerTemplate route={route} crumbs={crumbs} />}
{route.kind === 'sweet' && <SweetTemplate route={route} crumbs={crumbs} />}
