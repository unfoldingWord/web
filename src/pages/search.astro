---
// /search/ — full-text search of the site, powered by Pagefind: a static
// index built from dist/ after `astro build` (scripts/postbuild.mjs), served
// as plain files. No server, no third party. ?q=… runs a search on load
// (the WebSite SearchAction in the JSON-LD points here). A Mist header, then
// Pagefind's interface dressed in the design system (field, pills, links).
import Base from '../layouts/Base.astro';
import { ui } from '../i18n';
const t = ui('en');
---

<Base switcherPath="/" locale="en" basePath="/search/" title="Search" description="Search unfoldingword.org: stories, Bible translation strategy, resources for translators and ways to give." noindex pageType="search">
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <section class="bg-mist">
    <div class="container-page flex flex-col gap-4 pt-12 pb-14 md:pt-16 md:pb-[72px]">
      <h1>{t.search}</h1>
      <p class="lead max-w-[640px]">Stories, Bible translation strategy, resources for translators and ways to give.</p>
    </div>
  </section>
  <div class="container-page max-w-[calc(var(--container-prose)+2*var(--spacing-gutter))] py-12 md:py-16">
    <div id="site-search"></div>
    <noscript><p>Search needs JavaScript. <a href="/">Go to the home page</a> or browse the <a href="/stories/">{t.allStories}</a>.</p></noscript>
  </div>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    (function () {
      var ui = new PagefindUI({ element: '#site-search', showSubResults: true, showImages: false, resetStyles: false, translations: { placeholder: 'Search unfoldingword.org' } });
      var q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
    })();
  </script>
  <style is:global>
    #site-search {
      --pagefind-ui-scale: 0.8;
      --pagefind-ui-primary: var(--color-ocean);
      --pagefind-ui-text: var(--color-tech);
      --pagefind-ui-background: #fff;
      --pagefind-ui-border: var(--color-input-border);
      --pagefind-ui-tag: var(--color-inspire-50);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: var(--radius-input);
      --pagefind-ui-font: var(--font-sans);
    }
    /* The field matches .uw-input. */
    #site-search .pagefind-ui__search-input { min-height: 52px; font-size: 1.0625rem; font-weight: 400; color: var(--color-tech); }
    #site-search .pagefind-ui__search-input:focus { border-color: var(--color-ocean); }
    #site-search .pagefind-ui__result-link { color: var(--color-ocean); font-family: var(--font-heading); font-weight: 900; text-decoration: none; }
    #site-search .pagefind-ui__result-link:hover { color: var(--color-inspire-ink); }
    #site-search .pagefind-ui__result-excerpt { color: var(--color-ink-muted); }
    #site-search .pagefind-ui__result-excerpt mark { background: var(--color-inspire-100); color: var(--color-tech); }
    #site-search .pagefind-ui__button { font-family: var(--font-heading); font-weight: 800; border-radius: var(--radius-button); background: #fff; color: var(--color-ocean); border: 1px solid var(--color-ocean); }
    #site-search .pagefind-ui__button:hover { background: var(--color-ocean); color: #fff; }
  </style>
</Base>
