---
// /search/ — full-text search of the site, powered by Pagefind: a static
// index built from dist/ after `astro build` (scripts/postbuild.mjs), served
// as plain files. No server, no third party. ?q=… runs a search on load
// (the WebSite SearchAction in the JSON-LD points here). Production has no
// styled search page: this one uses the site's banner title, the 1000px
// column, the theme's input style and Kindle links and buttons.
import Base from '../layouts/Base.astro';
import { ui } from '../i18n';
const t = ui('en');
---

<Base switcherPath="/" locale="en" basePath="/search/" title="Search" description="Search unfoldingword.org: stories, Bible translation strategy, resources for translators and ways to give." noindex pageType="search">
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <section class="uw-banner on-dark">
    <div class="container-page flex min-h-[200px] items-center justify-center py-10 text-center">
      <h1 class="text-h2 text-white uppercase">Search</h1>
    </div>
  </section>
  <div class="container-page py-10">
    <div id="site-search"></div>
    <noscript><p>Search needs JavaScript. <a href="/">Go to the home page</a> or browse the <a href="/stories/">{t.allStories}</a>.</p></noscript>
  </div>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    (function () {
      var ui = new PagefindUI({ element: '#site-search', showSubResults: true, showImages: false, resetStyles: false, translations: { placeholder: 'Search unfoldingword.org' } });
      var q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
    })();
  </script>
  <style is:global>
    #site-search {
      --pagefind-ui-scale: 0.8;
      --pagefind-ui-primary: var(--color-kindle);
      --pagefind-ui-text: var(--color-tech);
      --pagefind-ui-background: #fff;
      --pagefind-ui-border: var(--color-input-border);
      --pagefind-ui-tag: var(--color-tint);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: var(--radius-input);
      --pagefind-ui-font: var(--font-sans);
    }
    #site-search .pagefind-ui__search-input { font-weight: 400; }
    #site-search .pagefind-ui__result-link { color: var(--color-link); font-weight: 900; text-decoration: none; }
    #site-search .pagefind-ui__result-link:hover { color: var(--color-link-hover); }
    #site-search .pagefind-ui__result-excerpt { font-weight: 300; }
    #site-search .pagefind-ui__button { font-family: var(--font-heading); font-weight: 900; border-radius: var(--radius-button); background: var(--color-kindle); color: #fff; border: 0; }
    #site-search .pagefind-ui__button:hover { background: var(--color-inspire); }
  </style>
</Base>
