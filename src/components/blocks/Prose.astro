---
// Long text: a section header (title, optional lead) over Markdown in the
// reading column. `align: center` / `title` center the header only. A narrow
// Ocean block is a rounded Ocean panel inside a white section (wbwn
// "Prayers"). `inset`, `textSize`, `divider`, `accent` and `compactLists`
// are older cosmetic flags and are ignored.
import type { Block } from '../../content.config';
import { md } from '../../lib/md';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Actions from '../ui/Actions.astro';
import Icon from '../ui/Icon.astro';

type Prose = Extract<Block, { type: 'prose' }>;
interface Props {
  block: Prose;
  locale: string;
}
const { block, locale } = Astro.props;
const centerHeader = block.align === 'center' || block.align === 'title';
const hasBody = Boolean(block.body.trim());
// A title with no text is a heading over the next block.
const strip = !hasBody && !block.lead;
const box = block.width === 'narrow' && block.background === 'ocean';
---

<Section background={box ? 'white' : block.background} width={block.width === 'wide' ? 'page' : 'prose'} class={strip ? '!pb-0' : undefined}>
  <div class:list={[box && 'uw-grain on-dark rounded-media px-6 py-10 md:px-12 md:py-12']}>
    {block.icon && <Icon name={block.icon} class:list={['mb-4 size-10', box || block.background === 'ocean' ? 'text-cultivate' : 'text-inspire-ink', centerHeader && 'mx-auto']} />}
    <SectionHeader title={block.title} intro={block.lead} align={centerHeader ? 'center' : 'start'} locale={locale} class={strip || box || !hasBody ? '!mb-0' : undefined} />
    {hasBody && <div class:list={['prose', block.serif && 'prose-serif', box && block.title && 'mt-5', block.width === 'wide' && '!max-w-none']} set:html={md(block.body, locale)} />}
    <Actions actions={block.actions ?? []} locale={locale} class:list={['mt-8 gap-3', centerHeader && 'justify-center']} />
  </div>
</Section>
