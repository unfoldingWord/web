---
// A video, as production's Elementor video widget: 600px wide, centered,
// square corners, with the section heading centered above it (white on an
// Ocean band, `background: ocean`). `variant: landing` (give/* pages): an
// Inspire 6% band, an 800px video, the heading kept for screen readers only.
import type { Block } from '../../content.config';
import { md, mdInline } from '../../lib/md';
import { ui } from '../../i18n';
import Section from '../ui/Section.astro';
import VideoFrame from '../ui/VideoFrame.astro';

type Video = Extract<Block, { type: 'video' }>;
interface Props {
  block: Video;
  locale: string;
}
const { block, locale } = Astro.props;
const landing = block.variant === 'landing';
---

<Section background={block.background} class={landing ? 'video-landing' : undefined}>
  <h2 class:list={[landing ? 'sr-only' : 'mb-5 text-center']} set:html={mdInline(block.heading ?? block.title, locale)} />
  <div class:list={['mx-auto', landing ? 'max-w-[800px]' : 'max-w-[600px]']}>
    <VideoFrame provider={block.provider} id={block.id} hash={block.hash} title={block.title} />
    {block.caption && <p class="mt-3 text-center">{block.caption}</p>}
    {
      block.transcript && (
        <details class="mt-5 border border-rule p-[10px]">
          <summary class="cursor-pointer font-heading font-bold">{ui(locale).transcript}</summary>
          <div class="prose mt-4" set:html={md(block.transcript, locale)} />
        </details>
      )
    }
  </div>
</Section>

<style>
  :global(section.video-landing) {
    background-color: rgb(49 173 227 / 0.06);
  }
</style>
