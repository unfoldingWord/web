---
// A video: section heading, then the rounded video frame (poster with a
// "Watch the video" pill; the player loads on press). `heading: ''` shows no
// heading. `variant: landing` (give/* pages) keeps the heading for screen
// readers only, on Mist.
import type { Block } from '../../content.config';
import { md, mdInline } from '../../lib/md';
import { ui } from '../../i18n';
import Section from '../ui/Section.astro';
import VideoFrame from '../ui/VideoFrame.astro';

type Video = Extract<Block, { type: 'video' }>;
interface Props {
  block: Video;
  locale: string;
}
const { block, locale } = Astro.props;
const landing = block.variant === 'landing';
const background = landing ? 'mist' : block.background === 'tint' ? 'mist' : block.background;
---

<Section background={background}>
  <div class="mx-auto max-w-[960px]">
    {block.heading !== '' && <h2 class:list={[landing ? 'sr-only' : 'mb-9 max-w-[760px] md:mb-11']} set:html={mdInline(block.heading ?? block.title, locale)} />}
    <VideoFrame provider={block.provider} id={block.id} hash={block.hash} title={block.title} poster={block.poster} />
    {block.caption && <p class="mt-3 text-[15px] text-ink-muted [.on-dark_&]:text-inspire-100">{block.caption}</p>}
    {
      block.transcript && (
        <details class="uw-card-flat mt-6 rounded-small px-5 py-4 text-ink">
          <summary class="cursor-pointer font-heading font-extrabold text-ocean">{ui(locale).transcript}</summary>
          <div class="prose mt-4" set:html={md(block.transcript, locale)} />
        </details>
      )
    }
  </div>
</Section>
