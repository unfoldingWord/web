---
import type { Block } from '../../content.config';
import { md } from '../../lib/md';
import { ui } from '../../i18n';
import Section from '../ui/Section.astro';
import VideoFrame from '../ui/VideoFrame.astro';

type Video = Extract<Block, { type: 'video' }>;
interface Props {
  block: Video;
  locale: string;
}
const { block, locale } = Astro.props;
---

<Section>
  <div class="mx-auto max-w-4xl">
    <h2 class="mb-6 text-h3">{block.title}</h2>
    <VideoFrame provider={block.provider} id={block.id} hash={block.hash} title={block.title} />
    {block.caption && <p class="mt-3 text-sm text-ink-muted">{block.caption}</p>}
    {
      block.transcript && (
        <details class="mt-5 rounded-card border border-line p-5">
          <summary class="cursor-pointer font-heading font-extrabold text-ocean">{ui(locale).transcript}</summary>
          <div class="prose mt-4" set:html={md(block.transcript, locale)} />
        </details>
      )
    }
  </div>
</Section>
