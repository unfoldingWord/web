---
// Stories from the field, newest first (or the hand-picked `slugs`), as a
// grid of StoryCards three to a row (Stories.dc.html). Every layout now
// renders as that grid; `rows` (the full stories index) also gets a "Load
// more stories" button that shows nine more at a time.
//
// The full index (no `slugs` or `limit`, and `rows` or `showFilter`) opens
// with one featured story: the newest with `featured: true`, else the newest.
// With `showFilter`, region pills filter the grid in the browser and a count
// follows the choice. Every story stays in the HTML, so crawlers and visitors
// without JavaScript see them all.
import { getCollection } from 'astro:content';
import type { Block } from '../../content.config';
import { ui, fmt, localizePath } from '../../i18n';
import { basePathFor, splitId } from '../../lib/routes';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import StoryCard from '../ui/StoryCard.astro';
import Picture from '../ui/Picture.astro';
import Icon from '../ui/Icon.astro';
import type { PortfolioKey } from '../../lib/portfolios';

type StoryList = Extract<Block, { type: 'storyList' }>;
interface Props {
  block: StoryList;
  locale: string;
  portfolio?: PortfolioKey;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const s = t as Record<string, unknown>;
const all = await getCollection('stories');
const bySlug = new Map<string, (typeof all)[number]>();
for (const st of all) {
  const { locale: l, rest } = splitId(st.id);
  if (l === 'en' && !bySlug.has(rest)) bySlug.set(rest, st);
  if (l === locale) bySlug.set(rest, st);
}
let stories = [...bySlug.values()].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
if (block.slugs) {
  const missing = block.slugs.filter((x) => !bySlug.has(x));
  if (missing.length) throw new Error(`storyList: no story file for ${missing.join(', ')} (src/content/stories/en/<slug>.md)`);
  stories = block.slugs.map((x) => bySlug.get(x)!);
}
if (block.region) stories = stories.filter((st) => st.data.region === block.region);
if (block.limit) stories = stories.slice(0, block.limit);

const regionName = (r: string) => (t.regions as Record<string, string>)[r] ?? r;
const isIndex = !block.slugs && !block.limit && (block.layout === 'rows' || block.showFilter);
const featured = isIndex ? (stories.find((st) => st.data.featured) ?? stories[0]) : undefined;
if (featured) stories = stories.filter((st) => st !== featured);
const regions = [...new Set(stories.map((st) => st.data.region))].sort();
const showFilter = block.showFilter && regions.length > 1;
const perPage = block.layout === 'rows' ? 9 : 0;
const level = block.title ? 'h3' : 'h2';
const H = level;
const background = block.background === 'white' ? 'white' : 'mist';
const countLabel = (s.storiesCount as string) ?? '{count} stories';
const countOne = (s.storiesCountOne as string) ?? '1 story';
const countText = (n: number) => (n === 1 ? countOne : fmt(countLabel, { count: n }));
const filterId = `story-filter-${stableId(JSON.stringify(block))}`;
const featuredHref = featured ? localizePath(basePathFor('stories', splitId(featured.id).rest), locale) : '';
// A short id that is the same on every build (derived from the block).
function stableId(text: string) {
  let h = 0;
  for (let i = 0; i < text.length; i++) h = (h * 31 + text.charCodeAt(i)) | 0;
  return (h >>> 0).toString(36);
}
---

<Section background={background}>
  <div data-story-list data-per-page={perPage || undefined} data-count-label={countLabel} data-count-one={countOne} class="flex flex-col gap-9">
    {
      (block.title || block.intro || block.limit || block.slugs) && (
        <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
          <div class="max-w-[760px] [&>div]:mb-0"><SectionHeader title={block.title} intro={block.intro} locale={locale} /></div>
          {(block.limit || block.slugs) && (
            <a href={localizePath('/stories/', locale)} class="uw-more">
              {t.allStories}
              <Icon name="arrow-right" class="size-4 rtl:-scale-x-100" />
            </a>
          )}
        </div>
      )
    }

    {
      featured && (
        <article class="uw-grain-deep on-dark relative flex flex-wrap overflow-hidden rounded-media">
          <div class="relative h-[280px] min-w-0 flex-[1_1_480px] sm:h-[420px] lg:h-[500px]">
            <Picture path={featured.data.image} alt={featured.data.imageAlt} sizes="(min-width: 66rem) 640px, 100vw" widths={[480, 640, 960, 1280]} fill eager />
          </div>
          <div class="flex min-w-0 flex-[1_1_440px] flex-col justify-center gap-4 px-7 py-10 sm:px-[clamp(28px,4vw,64px)] sm:py-14">
            <p class="label">{(s.featured as string) ?? 'Featured'} · {regionName(featured.data.region)}</p>
            <H class="font-serif text-[clamp(1.75rem,1.2rem+1.6vw,2.75rem)] leading-[1.15] font-normal text-white">
              <a href={featuredHref} class="text-white after:absolute after:inset-0 after:content-['']">{featured.data.title}</a>
            </H>
            {(featured.data.excerpt ?? featured.data.description) && <p class="text-[1.1875rem] text-inspire-100">{featured.data.excerpt ?? featured.data.description}</p>}
            <span class="flex items-center gap-2 font-extrabold text-white" aria-hidden="true">
              {t.readStory}
              <Icon name="arrow-right" class="size-[18px] text-cultivate rtl:-scale-x-100" />
            </span>
          </div>
        </article>
      )
    }

    {
      showFilter && (
        <div class="flex flex-wrap items-center gap-2">
          <span class="me-2 text-[0.9375rem] font-extrabold text-ink-muted" id={filterId}>{t.region}</span>
          <div class="story-filter flex flex-wrap gap-2" role="group" aria-labelledby={filterId}>
            <button type="button" data-region="" aria-pressed="true" class="uw-pill">{t.allRegions}</button>
            {regions.map((r) => (
              <button type="button" data-region={r} aria-pressed="false" class="uw-pill">
                {regionName(r)}
              </button>
            ))}
          </div>
          <p class="ms-auto text-[0.9375rem] text-ink-muted" data-story-count aria-live="polite">{countText(stories.length)}</p>
        </div>
      )
    }

    <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {stories.map((st) => (
        <li data-region={st.data.region}>
          <StoryCard story={st} locale={locale} headingLevel={level} />
        </li>
      ))}
    </ul>

    {perPage > 0 && stories.length > perPage && (
      <div data-more-wrap hidden>
        <button type="button" class="uw-btn uw-btn-secondary" data-more>{(s.loadMoreStories as string) ?? 'Load more stories'}</button>
      </div>
    )}
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLElement>('[data-story-list]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('li[data-region]')];
    const bar = root.querySelector<HTMLElement>('.story-filter');
    const count = root.querySelector<HTMLElement>('[data-story-count]');
    const moreWrap = root.querySelector<HTMLElement>('[data-more-wrap]');
    const more = root.querySelector<HTMLButtonElement>('[data-more]');
    const perPage = Number(root.dataset.perPage) || 0;
    const label = root.dataset.countLabel ?? '{count} stories';
    const one = root.dataset.countOne ?? '1 story';
    let region = '';
    let shown = perPage;

    const matching = () => items.filter((li) => !region || li.dataset.region === region);
    const render = () => {
      const m = matching();
      items.forEach((li) => {
        const i = m.indexOf(li);
        li.hidden = i < 0 || (perPage > 0 && i >= shown);
      });
      if (count) count.textContent = m.length === 1 ? one : label.replace('{count}', String(m.length));
      if (moreWrap) moreWrap.hidden = !perPage || m.length <= shown;
    };

    bar?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-region]');
      if (!btn) return;
      region = btn.dataset.region ?? '';
      shown = perPage;
      bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      render();
    });
    // Show the next page and move focus to its first story, for keyboard users.
    more?.addEventListener('click', () => {
      const next = matching()[shown];
      shown += perPage;
      render();
      next?.querySelector<HTMLElement>('a')?.focus();
    });
    render();
  });
</script>
