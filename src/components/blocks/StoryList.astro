---
// Stories from the field, newest first. With `showFilter`, a row of region
// buttons filters the list in the browser (every story stays in the HTML, so
// crawlers and no-JS visitors see them all).
import { getCollection } from 'astro:content';
import type { Block } from '../../content.config';
import { ui, localizePath } from '../../i18n';
import { splitId } from '../../lib/routes';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import StoryCard from '../ui/StoryCard.astro';
import Icon from '../ui/Icon.astro';

type StoryList = Extract<Block, { type: 'storyList' }>;
interface Props {
  block: StoryList;
  locale: string;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const all = await getCollection('stories');
const bySlug = new Map<string, (typeof all)[number]>();
for (const s of all) {
  const { locale: l, rest } = splitId(s.id);
  if (l === 'en' && !bySlug.has(rest)) bySlug.set(rest, s);
  if (l === locale) bySlug.set(rest, s);
}
let stories = [...bySlug.values()].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
if (block.slugs) {
  const missing = block.slugs.filter((s) => !bySlug.has(s));
  if (missing.length) throw new Error(`storyList: no story file for ${missing.join(', ')} (src/content/stories/en/<slug>.md)`);
  stories = block.slugs.map((s) => bySlug.get(s)!);
}
if (block.region) stories = stories.filter((s) => s.data.region === block.region);
if (block.limit) stories = stories.slice(0, block.limit);
const regions = [...new Set(stories.map((s) => s.data.region))].sort();
const regionName = (r: string) => (t.regions as Record<string, string>)[r] ?? r;
---

<Section background={block.background}>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <SectionHeader eyebrow={block.eyebrow} title={block.title} locale={locale} />
    {
      (block.limit || block.slugs) && (
        <a href={localizePath('/stories/', locale)} class="mb-8 inline-flex items-center gap-1.5 font-heading font-extrabold lg:mb-12">
          {t.allStories}
          <Icon name="arrow-right" class="size-4 rtl:-scale-x-100" />
        </a>
      )
    }
  </div>
  {
    block.showFilter && regions.length > 1 && (
      <div class="story-filter -mx-1 mb-8 flex gap-2 overflow-x-auto px-1 pb-2" role="group" aria-label={t.filterByRegion}>
        <button type="button" data-region="" aria-pressed="true" class="filter-chip">{t.allRegions}</button>
        {regions.map((r) => (
          <button type="button" data-region={r} aria-pressed="false" class="filter-chip">
            {regionName(r)}
          </button>
        ))}
      </div>
    )
  }
  <ul class="story-grid grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      stories.map((s) => (
        <li data-region={s.data.region} class="flex">
          <StoryCard story={s} locale={locale} headingLevel={block.title ? 'h3' : 'h2'} />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  @reference '../../styles/global.css';
  .filter-chip {
    @apply min-h-11 shrink-0 rounded-full border border-line bg-white px-4 text-sm font-bold whitespace-nowrap text-ocean;
  }
  .filter-chip[aria-pressed='true'] {
    @apply border-ocean bg-ocean text-white;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.story-filter').forEach((bar) => {
    const grid = bar.parentElement?.querySelector('.story-grid');
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-region]');
      if (!btn || !grid) return;
      const region = btn.dataset.region;
      bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      grid.querySelectorAll<HTMLElement>('li[data-region]').forEach((li) => {
        li.hidden = !!region && li.dataset.region !== region;
      });
    });
  });
</script>
