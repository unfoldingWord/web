---
// Partner logos, as on production's home page: a heading row (an optional
// logo beside the h2) over 150px logos that drift sideways in a loop.
// The loop pauses on hover, on keyboard focus and with the pause button,
// and does not run for visitors who prefer reduced motion or have no
// JavaScript: they see the logos wrapped in centered rows.
import type { Block } from '../../content.config';
import { mdInline } from '../../lib/md';
import { ui } from '../../i18n';
import Picture from '../ui/Picture.astro';

type LogoMarquee = Extract<Block, { type: 'logoMarquee' }>;
interface Props {
  block: LogoMarquee;
  locale: string;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const copies = [0, 1];
---

<section class="logo-marquee py-20" data-marquee>
  <div class="container-page">
    <div class="flex flex-col items-center justify-center gap-5 p-[10px] min-[1057px]:flex-row">
      {block.titleImage && <Picture path={block.titleImage} alt={block.titleImageAlt ?? ''} sizes="150px" widths={[150, 300]} class="!w-[150px] shrink-0" />}
      <h2 class="text-center text-tech text-wrap" set:html={mdInline(block.title, locale)} />
    </div>
    <div class="marquee-viewport relative mt-5">
      <div class="marquee-track">
        {
          copies.map((c) => (
            <ul class="marquee-set" aria-hidden={c === 1 ? 'true' : undefined}>
              {block.logos.map((logo) => (
                <li>
                  {logo.href ? (
                    <a href={logo.href} rel="noopener" tabindex={c === 1 ? -1 : undefined}>
                      <Picture path={logo.image} alt={c === 1 ? '' : logo.alt} sizes="150px" widths={[150, 300]} aspect="1 / 1" />
                    </a>
                  ) : (
                    <Picture path={logo.image} alt={c === 1 ? '' : logo.alt} sizes="150px" widths={[150, 300]} aspect="1 / 1" />
                  )}
                </li>
              ))}
            </ul>
          ))
        }
      </div>
      <button type="button" class="marquee-pause" data-pause hidden aria-pressed="false" aria-label={t.pause} data-label-pause={t.pause} data-label-play={t.play}>
        <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 5h3v14H7zM14 5h3v14h-3z" /></svg>
        <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z" /></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .marquee-viewport { overflow: hidden; }
  .marquee-track { display: flex; width: max-content; }
  .marquee-set {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .marquee-set li { width: 150px; height: 150px; flex: none; }
  /* Static (no JS, reduced motion): one centered, wrapping set. */
  .marquee-track { width: auto; justify-content: center; }
  .marquee-set[aria-hidden] { display: none; }
  .logo-marquee.is-moving .marquee-track {
    width: max-content;
    justify-content: flex-start;
    animation: marquee 40s linear infinite;
  }
  .logo-marquee.is-moving .marquee-set { flex-wrap: nowrap; padding-inline-end: 20px; }
  .logo-marquee.is-moving .marquee-set[aria-hidden] { display: flex; }
  .logo-marquee.is-moving .marquee-viewport:hover .marquee-track,
  .logo-marquee.is-moving .marquee-viewport:focus-within .marquee-track,
  .logo-marquee.is-paused .marquee-track { animation-play-state: paused; }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(var(--marquee-end, -50%)); }
  }
  .marquee-viewport:dir(rtl) { --marquee-end: 50%; }
  .marquee-pause {
    position: absolute;
    inset-block-end: 6px;
    inset-inline-end: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    color: #fff;
    background: rgb(35 31 32 / 0.6);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .marquee-viewport:hover .marquee-pause, .marquee-pause:focus-visible, .marquee-pause[aria-pressed='true'] { opacity: 1; }
  @media (hover: none) { .marquee-pause { opacity: 0.8; } }
  .marquee-pause[hidden] { display: none; }
  .marquee-pause svg { width: 16px; height: 16px; }
  .marquee-pause .icon-play, .marquee-pause[aria-pressed='true'] .icon-pause { display: none; }
  .marquee-pause[aria-pressed='true'] .icon-play { display: block; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((root) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const btn = root.querySelector<HTMLButtonElement>('[data-pause]');
    root.classList.add('is-moving');
    if (!btn) return;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const paused = root.classList.toggle('is-paused');
      btn.setAttribute('aria-pressed', String(paused));
      btn.setAttribute('aria-label', (paused ? btn.dataset.labelPlay : btn.dataset.labelPause) ?? '');
    });
  });
</script>
