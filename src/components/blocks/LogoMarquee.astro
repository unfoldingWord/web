---
// Partner logos (the home page's alliance section): the heading, with the
// alliance logo (`titleImage`) in a bordered box beside it, over a wrapping
// grid of square logo tiles. Nothing moves.
import type { Block } from '../../content.config';
import type { PortfolioKey } from '../../lib/portfolios';
import { mdInline } from '../../lib/md';
import Picture from '../ui/Picture.astro';

type LogoMarquee = Extract<Block, { type: 'logoMarquee' }>;
interface Props {
  block: LogoMarquee;
  locale: string;
  portfolio?: PortfolioKey;
}
const { block, locale } = Astro.props;
---

<section class="section-y bg-white">
  <div class="container-page flex flex-col gap-9">
    <div class="flex flex-wrap items-center justify-between gap-x-16 gap-y-6">
      <h2 class="min-w-0 flex-[1_1_480px] text-[clamp(1.625rem,1.2rem+1.2vw,2.25rem)] leading-[1.15]" set:html={mdInline(block.title, locale)} />
      {
        block.titleImage && (
          <div class="shrink-0 rounded-small border border-line bg-white px-7 py-4">
            <Picture path={block.titleImage} alt={block.titleImageAlt ?? ''} sizes="160px" widths={[160, 320]} class="!h-24 !w-auto" />
          </div>
        )
      }
    </div>
    <ul class="flex flex-wrap gap-4">
      {
        block.logos.map((logo) => (
          <li class="min-w-0 max-w-[232px] flex-[1_1_140px] rounded-small border border-line bg-white p-1 sm:flex-[1_1_180px]">
            {logo.href ? (
              <a href={logo.href} rel="noopener" class="block rounded-input">
                <Picture path={logo.image} alt={logo.alt} sizes="232px" widths={[232, 464]} aspect="1 / 1" class="block !object-contain" />
              </a>
            ) : (
              <Picture path={logo.image} alt={logo.alt} sizes="232px" widths={[232, 464]} aspect="1 / 1" class="block !object-contain" />
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
