---
// Current prayer requests (Pray.dc.html), on Mist: the heading and intro, a
// "You prayed for N requests" counter, the newest request as a featured
// Ocean panel, then the rest as white cards. Each request has an "I prayed
// for this" toggle. The toggle is local only: it is remembered in this
// browser (localStorage) and sent nowhere. Without JavaScript the toggles
// stay hidden and the requests read as plain cards.
import { getCollection } from 'astro:content';
import type { Block } from '../../content.config';
import type { PortfolioKey } from '../../lib/portfolios';
import { ui, formatDate, localizePath } from '../../i18n';
import { basePathFor, splitId } from '../../lib/routes';
import { md, mdInline } from '../../lib/md';
import Icon from '../ui/Icon.astro';

type PrayerList = Extract<Block, { type: 'prayerList' }>;
interface Props {
  block: PrayerList;
  locale: string;
  portfolio?: PortfolioKey;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const s = t as Record<string, unknown>;
const all = await getCollection('prayer');
const bySlug = new Map<string, (typeof all)[number]>();
for (const p of all) {
  const { locale: l, rest } = splitId(p.id);
  if (l === 'en' && !bySlug.has(rest)) bySlug.set(rest, p);
  if (l === locale) bySlug.set(rest, p);
}
let entries = [...bySlug.entries()].sort(([, a], [, b]) => b.data.date.getTime() - a.data.date.getTime());
// "All prayer requests" leads to /pray/ from anywhere but /pray/ itself.
const prayHref = localizePath('/pray/', locale);
const onPrayPage = Astro.url.pathname === prayHref;
// On /pray/ itself a `limit` keeps every request in the page: the ones past
// the limit are "earlier requests", hidden behind a button that reveals
// them in place (without JavaScript they all show). Elsewhere the list is cut.
const limit = block.limit ?? 0;
const keepEarlier = limit > 0 && onPrayPage && entries.length > limit;
if (limit && !keepEarlier) entries = entries.slice(0, limit);
const regions = t.regions as Record<string, string>;
const items = entries.map(([slug, p]) => ({
  slug,
  title: p.data.title,
  description: p.data.description,
  href: localizePath(basePathFor('prayer', slug), locale),
  date: formatDate(p.data.date, locale),
  datetime: p.data.date.toISOString(),
  region: p.data.region ? (regions[p.data.region] ?? p.data.region) : undefined,
}));
// `i` indexes `rest`; the featured request is position 0 of the full list.
const isEarlier = (i: number) => keepEarlier && i + 1 >= limit;
const earlierLabel = (s.earlierRequests as string) ?? 'Earlier requests';
const listId = `prayer-items-${stableId(JSON.stringify(block))}`;
const [featured, ...rest] = items;
const headingId = `prayer-list-${stableId(JSON.stringify(block))}`;
const iPrayed = (s.iPrayed as string) ?? 'I prayed for this';
const prayed = (s.prayed as string) ?? 'Prayed';
const countOne = (s.prayedCountOne as string) ?? 'You prayed for 1 request';
const countMany = (s.prayedCount as string) ?? 'You prayed for {count} requests';
const showAll = limit > 0 && !onPrayPage;
// A short id that is the same on every build (derived from the block).
function stableId(text: string) {
  let h = 0;
  for (let i = 0; i < text.length; i++) h = (h * 31 + text.charCodeAt(i)) | 0;
  return (h >>> 0).toString(36);
}
---

<section class="bg-mist py-[var(--spacing-section)]" aria-labelledby={block.title ? headingId : undefined} data-prayer-list data-count-one={countOne} data-count-many={countMany}>
  <div class="container-page flex flex-col gap-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      {
        (block.title || block.intro) && (
          <div class="flex max-w-[760px] flex-col gap-3">
            {block.title && <h2 id={headingId} set:html={mdInline(block.title, locale)} />}
            {block.intro && <div class="lead flex flex-col gap-3 [&_a]:font-extrabold" set:html={md(block.intro, locale)} />}
          </div>
        )
      }
      <p class="text-[1.0625rem] font-semibold text-ocean" data-prayed-count aria-live="polite" hidden></p>
    </div>

    {
      featured && (
        <article class="uw-grain on-dark flex flex-wrap items-center gap-x-14 gap-y-6 rounded-media p-[clamp(28px,4vw,48px)]">
          <div class="flex min-w-0 flex-[999_1_480px] flex-col gap-3">
            <p class="text-[0.9375rem] text-inspire-100">
              <time datetime={featured.datetime}>{featured.date}</time>
              {featured.region && <> · {featured.region}</>}
            </p>
            <h3 class="font-serif text-[clamp(1.75rem,1.3rem+1.4vw,2.625rem)] leading-[1.15] font-normal">
              <a href={featured.href} class="text-white hover:text-inspire-100" set:html={mdInline(featured.title)} />
            </h3>
            <p class="max-w-[640px] text-[1.1875rem] text-inspire-100">{featured.description}</p>
          </div>
          <button type="button" class="pray-toggle pray-toggle-lg" data-pray-toggle={featured.slug} aria-pressed="false" hidden>
            <span data-off>{iPrayed}</span>
            <span data-on hidden class="inline-flex items-center gap-2"><Icon name="check" class="size-5" />{prayed}</span>
          </button>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <ul id={listId} class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {rest.map((r, i) => (
            <li class="flex" data-earlier={isEarlier(i) ? '' : undefined}>
              <article class="uw-card flex flex-1 flex-col gap-3 p-7">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
                  {r.region && <span class="chip">{r.region}</span>}
                  <time datetime={r.datetime} class="text-sm text-ink-muted">{r.date}</time>
                </p>
                <h3 class="text-h4 font-black">
                  <a href={r.href} class="text-ocean hover:text-inspire-ink" set:html={mdInline(r.title)} />
                </h3>
                <p class="text-ink-muted">{r.description}</p>
                <button type="button" class="pray-toggle uw-pill mt-auto self-start" data-pray-toggle={r.slug} aria-pressed="false" hidden>
                  <span data-off>{iPrayed}</span>
                  <span data-on hidden class="inline-flex items-center gap-1.5"><Icon name="check" class="size-4" />{prayed}</span>
                </button>
              </article>
            </li>
          ))}
        </ul>
      )
    }

    {
      keepEarlier && (
        <div data-earlier-wrap hidden>
          <button type="button" class="uw-btn uw-btn-secondary bg-white" data-earlier-toggle aria-expanded="false" aria-controls={listId}>{earlierLabel}</button>
        </div>
      )
    }

    {
      showAll && (
        <div>
          <a href={prayHref} class="uw-btn uw-btn-secondary bg-white">{t.allPrayerRequests}</a>
        </div>
      )
    }
  </div>
</section>

<style>
  .pray-toggle-lg {
    flex: none;
    min-height: 56px;
    padding: 14px 30px;
    border: 2px solid #fff;
    border-radius: var(--radius-button);
    background: transparent;
    color: #fff;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 800;
    cursor: pointer;
  }
  .pray-toggle-lg[aria-pressed='true'] { background: #fff; color: var(--color-ocean); }
  .pray-toggle-lg:focus-visible { outline-color: #fff; }
</style>

<script>
  // "I prayed for this": remembered in this browser only. Storage can be
  // unavailable (private windows, blocked site data); the toggle still works
  // for the visit.
  const KEY = 'uw-prayed';
  const load = (): Set<string> => {
    try {
      return new Set(JSON.parse(localStorage.getItem(KEY) ?? '[]'));
    } catch {
      return new Set();
    }
  };
  const save = (ids: Set<string>) => {
    try {
      localStorage.setItem(KEY, JSON.stringify([...ids]));
    } catch {
      /* not saved; fine */
    }
  };

  document.querySelectorAll<HTMLElement>('[data-prayer-list]').forEach((root) => {
    let prayed = load();
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-pray-toggle]')];
    const counter = root.querySelector<HTMLElement>('[data-prayed-count]');
    const paint = () => {
      let n = 0;
      buttons.forEach((b) => {
        const on = prayed.has(b.dataset.prayToggle!);
        if (on) n++;
        b.setAttribute('aria-pressed', String(on));
        b.querySelector<HTMLElement>('[data-off]')!.hidden = on;
        b.querySelector<HTMLElement>('[data-on]')!.hidden = !on;
      });
      if (counter) {
        counter.hidden = n === 0;
        counter.textContent = n === 1 ? (root.dataset.countOne ?? '') : (root.dataset.countMany ?? '').replace('{count}', String(n));
      }
    };
    buttons.forEach((b) => {
      b.hidden = false;
      b.addEventListener('click', () => {
        const id = b.dataset.prayToggle!;
        // Start from storage so a toggle on another page or tab is kept.
        const on = !prayed.has(id);
        prayed = new Set([...load(), ...prayed]);
        if (on) prayed.add(id);
        else prayed.delete(id);
        save(prayed);
        paint();
      });
    });
    paint();

    // Earlier requests: hidden until asked for, then shown in place.
    const earlier = [...root.querySelectorAll<HTMLElement>('[data-earlier]')];
    const wrap = root.querySelector<HTMLElement>('[data-earlier-wrap]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-earlier-toggle]');
    if (earlier.length && wrap && toggle) {
      earlier.forEach((li) => (li.hidden = true));
      wrap.hidden = false;
      toggle.addEventListener('click', () => {
        earlier.forEach((li) => (li.hidden = false));
        toggle.setAttribute('aria-expanded', 'true');
        wrap.hidden = true;
        earlier[0].querySelector<HTMLElement>('a')?.focus();
      });
    }
  });
</script>
