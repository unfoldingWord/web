---
// Renders a page's `sections` in order. One case per block type in
// src/content.config.ts.
import type { Block } from '../../content.config';
import Hero from './Hero.astro';
import Prose from './Prose.astro';
import Cards from './Cards.astro';
import Split from './Split.astro';
import Stats from './Stats.astro';
import Quote from './Quote.astro';
import Cta from './Cta.astro';
import Video from './Video.astro';
import Giving from './Giving.astro';
import Faq from './Faq.astro';
import People from './People.astro';
import StoryList from './StoryList.astro';
import PrayerList from './PrayerList.astro';
import Resources from './Resources.astro';
import Steps from './Steps.astro';
import Gallery from './Gallery.astro';
import Trust from './Trust.astro';
import ContactForm from './ContactForm.astro';
import Embed from './Embed.astro';
import SweetBooks from './SweetBooks.astro';
import Signup from './Signup.astro';
import HeroSlideshow from './HeroSlideshow.astro';
import Statement from './Statement.astro';
import Testimonials from './Testimonials.astro';
import LogoMarquee from './LogoMarquee.astro';
import ScrollStory from './ScrollStory.astro';
import PortfolioGrid from './PortfolioGrid.astro';
import PortfolioNav from './PortfolioNav.astro';
import Takeaway from './Takeaway.astro';
import Pillars from './Pillars.astro';
import BeforeAfter from './BeforeAfter.astro';
import GiveBand from './GiveBand.astro';
import LogoGrid from './LogoGrid.astro';
import type { PortfolioKey } from '../../lib/portfolios';

interface Props {
  blocks: Block[];
  locale: string;
  crumbs?: { name: string; href?: string }[];
  /** The page's portfolio, passed to every block (colors, labels). */
  portfolio?: PortfolioKey;
}
const { blocks, locale, crumbs, portfolio } = Astro.props;
const C = {
  hero: Hero, prose: Prose, cards: Cards, split: Split, stats: Stats, quote: Quote, cta: Cta, video: Video,
  giving: Giving, faq: Faq, people: People, storyList: StoryList, prayerList: PrayerList, resources: Resources,
  steps: Steps, gallery: Gallery, trust: Trust, contactForm: ContactForm, embed: Embed, sweetBooks: SweetBooks, signup: Signup,
  heroSlideshow: HeroSlideshow, statement: Statement, testimonials: Testimonials, logoMarquee: LogoMarquee,
  scrollStory: ScrollStory, portfolioGrid: PortfolioGrid, portfolioNav: PortfolioNav, takeaway: Takeaway, pillars: Pillars,
  beforeAfter: BeforeAfter, giveBand: GiveBand, logoGrid: LogoGrid,
} as const;
---

{
  blocks.map((block, i) => {
    const Component = C[block.type] as any;
    return <Component block={block} locale={locale} portfolio={portfolio} crumbs={i === 0 && block.type === 'hero' ? crumbs : undefined} />;
  })
}
