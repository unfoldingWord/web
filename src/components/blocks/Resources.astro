---
// Downloads and links (publications, PDFs, apps, training).
//   cards, list — one bordered list: a kind badge, the title, a muted line
//                 under it and an arrow. In `list`, an item's image is a
//                 cover shown beside the list (annual reports).
//   accordion   — one collapsible row per item, as the FAQ: the title
//                 opens the link, description and (with `licenseBadge`)
//                 the CC BY-SA badge. The first row starts open; a link
//                 to an anchor inside a row (#TGLS) opens that row.
import type { Block } from '../../content.config';
import type { PortfolioKey } from '../../lib/portfolios';
import { md, mdInline, localizeHref } from '../../lib/md';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Picture from '../ui/Picture.astro';
import Icon from '../ui/Icon.astro';

type Resources = Extract<Block, { type: 'resources' }>;
interface Props {
  block: Resources;
  locale: string;
  portfolio?: PortfolioKey;
}
const { block, locale } = Astro.props;
const isExternal = (h: string) => /^https?:\/\//.test(h);
const ext = (h: string) => (isExternal(h) ? { rel: 'noopener' } : {});
const plainTitle = (t: string) => t.replace(/<[^>]+>/g, '');
const accordion = block.variant === 'accordion';
// list: an item's image is the cover beside the list
const cover = block.variant === 'list' ? block.items.find((it) => it.image) : undefined;
const kindLabel = { pdf: 'PDF', link: 'LINK', video: 'VIDEO', audio: 'AUDIO', book: 'BOOK', app: 'APP' } as const;
// "By A, B" reads as "… by A, B" after the link; anything else follows in brackets.
const byline = (m?: string) => (!m ? '' : /^by\s/i.test(m) ? ` by ${m.slice(3)}` : ` (${m})`);
---

<Section id={block.id} background={block.background} class={accordion ? 'uw-acc-section' : undefined}>
  <div class="flex flex-col gap-9">
    <SectionHeader title={block.title} intro={block.intro} locale={locale} />
    {
      accordion ? (
        <div class="acc">
          {block.items.map((it, i) => (
            <details class="acc-item" open={i === 0}>
              <summary class="acc-q">
                <span set:html={mdInline(it.title)} />
                <span class="acc-sign" aria-hidden="true" />
              </summary>
              <div class="acc-a prose">
                {it.image && <Picture path={it.image} alt={it.imageAlt ?? ''} sizes="200px" widths={[200, 400]} class="!w-[200px] rounded-small" />}
                {it.href && (
                  <p>
                    {it.kind === 'pdf' || it.kind === 'book' ? 'Download ' : ''}
                    <a href={localizeHref(it.href, locale)} {...ext(it.href)}>
                      {plainTitle(it.title)}
                      {it.kind === 'pdf' && <span class="sr-only"> (PDF)</span>}
                    </a>
                    {byline(it.meta)}
                  </p>
                )}
                {it.description && <Fragment set:html={md(it.description, locale)} />}
                {block.licenseBadge && (
                  <div>
                    <Picture path="for-translators/cc-by-sa-badge.png" alt="CC BY-SA license badge" sizes="88px" widths={[88]} class="!w-[88px] !rounded-none" />
                  </div>
                )}
              </div>
            </details>
          ))}
        </div>
      ) : (
        <div class="flex flex-col gap-8 md:flex-row md:items-start">
          {cover && (
            <div class="w-full max-w-[260px] shrink-0">
              <Picture path={cover.image!} alt={cover.imageAlt ?? ''} sizes="260px" widths={[260, 520]} class="block rounded-small shadow-card" />
            </div>
          )}
          <ul class="res-list">
            {block.items.map((it) => {
              const inner = (
                <>
                  <span class="res-kind" aria-hidden="true">{kindLabel[it.kind]}</span>
                  <span class="flex min-w-0 flex-1 flex-col">
                    <span class="res-title">
                      <span set:html={mdInline(it.title)} />
                      {it.kind === 'pdf' && <span class="sr-only"> (PDF)</span>}
                    </span>
                    {it.description && <span class="res-meta" set:html={mdInline(it.description, locale)} />}
                    {it.meta && <span class="res-meta">{it.meta}</span>}
                  </span>
                  {it.href && <Icon name={it.kind === 'pdf' ? 'download' : 'arrow-right'} class="size-5 text-inspire-ink rtl:-scale-x-100" />}
                </>
              );
              return (
                <li>
                  {it.href ? (
                    <a href={localizeHref(it.href, locale)} class="res-row" {...ext(it.href)}>{inner}</a>
                  ) : (
                    <div class="res-row">{inner}</div>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
  </div>
</Section>

<style>
  /* Accordion groups that follow each other (or a video) read as one section. */
  :global(:is(.uw-acc-section, .uw-flow) + .uw-acc-section) { padding-top: 0; }

  .res-list { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-card); background: #fff; }
  .res-list > li + li { border-top: 1px solid var(--color-line); }
  .res-row { display: flex; align-items: center; gap: 18px; padding: 18px 22px; color: var(--color-ink); text-decoration: none; }
  a.res-row:hover { background: var(--color-mist); color: var(--color-ink); }
  a.res-row:hover .res-title { text-decoration: underline; text-underline-offset: 3px; }
  .res-kind { flex: 0 0 64px; padding: 8px 0; border-radius: 8px; background: var(--color-inspire-50); color: var(--color-ocean); font-size: 0.8125rem; font-weight: 800; letter-spacing: 0.06em; text-align: center; }
  .res-title { font-size: 1.1875rem; line-height: 1.35; font-weight: 800; color: var(--color-ocean); }
  .res-meta { font-size: 0.9375rem; color: var(--color-ink-muted); }
  @media (width < 30rem) {
    .res-row { gap: 12px; padding: 16px; }
    .res-kind { flex-basis: 52px; }
  }

  /* Accordion: the FAQ look */
  .acc { border-bottom: 1px solid var(--color-line); background: inherit; }
  .acc-item { border-top: 1px solid var(--color-line); }
  .acc-q { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 64px; padding: 18px 0; cursor: pointer; list-style: none; font-family: var(--font-heading); font-size: 1.25rem; line-height: 1.3; font-weight: 800; color: var(--color-ocean); }
  .acc-q::-webkit-details-marker { display: none; }
  .acc-sign { position: relative; flex: none; width: 18px; height: 18px; color: var(--color-inspire-ink); }
  .acc-sign::before, .acc-sign::after { content: ''; position: absolute; top: 8px; inset-inline-start: 0; width: 18px; height: 2px; background: currentColor; }
  .acc-sign::after { transform: rotate(90deg); transition: transform 0.2s; }
  details[open] > .acc-q .acc-sign::after { transform: rotate(0deg); }
  .acc-a { padding: 0 0 22px; color: var(--color-ink-muted); }
  /* On an Ocean ground the rows are white text. */
  :global(.on-dark) .acc-q, :global(.on-dark) .acc-sign { color: #fff; }
  :global(.on-dark) .acc, :global(.on-dark) .acc-item { border-color: rgb(255 255 255 / 0.25); }
  :global(.on-dark) .acc-a { color: var(--color-inspire-100); }
</style>

<script>
  // Deep links into an accordion (/publications/#TGLS): open the row that
  // holds the target and bring it into view, on load and on later hash changes.
  const openFromHash = () => {
    const raw = location.hash.slice(1);
    if (!raw) return;
    let target: HTMLElement | null = null;
    try {
      target = document.getElementById(decodeURIComponent(raw));
    } catch {
      target = document.getElementById(raw);
    }
    const item = target?.closest<HTMLDetailsElement>('details.acc-item');
    if (!item) return;
    item.open = true;
    requestAnimationFrame(() => item.scrollIntoView({ block: 'start' }));
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>
