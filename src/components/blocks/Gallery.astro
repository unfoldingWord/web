---
// Images with optional captions. One image runs the full column width at
// its own proportions; several form a grid of 3:2 photos.
import type { Block } from '../../content.config';
import type { PortfolioKey } from '../../lib/portfolios';
import { mdInline } from '../../lib/md';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Picture from '../ui/Picture.astro';

type Gallery = Extract<Block, { type: 'gallery' }>;
interface Props {
  block: Gallery;
  locale: string;
  portfolio?: PortfolioKey;
}
const { block, locale } = Astro.props;
const single = block.images.length === 1;
---

<Section>
  <div class="flex flex-col gap-9">
    <SectionHeader title={block.title} intro={block.intro} locale={locale} />
    {
      single ? (
        <figure class="flex flex-col gap-3">
          <Picture path={block.images[0].src} alt={block.images[0].alt} sizes="(min-width: 84rem) 1280px, 100vw" widths={[480, 800, 1280, 1920, 2560]} class="block rounded-media" />
          {block.images[0].caption && <figcaption class="caption" set:html={mdInline(block.images[0].caption, locale)} />}
        </figure>
      ) : (
        <ul class="grid gap-6 sm:grid-cols-2 tablet:grid-cols-3">
          {block.images.map((im) => (
            <li>
              <figure class="flex flex-col gap-2.5">
                <Picture path={im.src} alt={im.alt} sizes="(min-width: 66rem) 411px, (min-width: 40rem) 50vw, 100vw" widths={[400, 640, 840]} aspect="3 / 2" class="block rounded-small" />
                {im.caption && <figcaption class="caption" set:html={mdInline(im.caption, locale)} />}
              </figure>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Section>

<style>
  .caption { font-size: 0.9375rem; line-height: 1.5; color: var(--color-ink-muted); }
  .caption :global(strong) { color: var(--color-ink); font-weight: 800; }
</style>
