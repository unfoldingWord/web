---
// Contact details and (when enabled) the contact form.
//
// The form posts to /api/contact, handled by the Worker (worker/contact.ts):
// Turnstile spam check, then email to the address in the CONTACT_TO secret.
// Where the old Contact Form 7 form sent its mail is NOT yet confirmed, so the
// form stays off until it is: set PUBLIC_CONTACT_FORM=1 at build time once
// CONTACT_TO and the Turnstile keys are configured (docs/forms.md). Until
// then the block shows the postal address and phone number only.
import type { Block } from '../../content.config';
import { SITE } from '../../lib/site';
import { ui } from '../../i18n';
import { mdInline } from '../../lib/md';
import Section from '../ui/Section.astro';

type ContactForm = Extract<Block, { type: 'contactForm' }>;
interface Props {
  block: ContactForm;
  locale: string;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const enabled = import.meta.env.PUBLIC_CONTACT_FORM === '1';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
// Production's wording ("Use the contact form below…") only makes sense with
// the form on; without it the block shows `intro`.
const intro = enabled && block.formIntro ? block.formIntro : block.intro;
---

<Section>
  <div class="mx-auto flex max-w-[800px] flex-col gap-5">
    <div class="prose [&>:last-child]:mb-0">
      {block.title && <h2 set:html={mdInline(block.title)} />}
      {intro && <p set:html={mdInline(intro, locale)} />}
      <address class="not-italic">
        <p>{SITE.address.streetAddress.split(/,\s*/).map((part) => <>{part}<br /></>)}{SITE.address.addressLocality}, {SITE.address.addressRegion} {SITE.address.postalCode}</p>
        <p><a href={`tel:${SITE.telephone}`} class="!font-light !text-tech">{SITE.telephoneDisplay}</a></p>
      </address>
    </div>
    {
      enabled && (
        <form class="contact-form uw-cf" method="post" action="/api/contact" novalidate>
          <div class="uw-cf-field">
            <label for="cf-name" class="uw-cf-label">{t.contactFormName}</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required class="uw-input block" />
          </div>
          <div class="uw-cf-field">
            <label for="cf-email" class="uw-cf-label">{t.contactFormEmail}</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required class="uw-input block" />
          </div>
          <div class="uw-cf-field">
            <label for="cf-message" class="uw-cf-label">{t.contactFormMessage}</label>
            <textarea id="cf-message" name="message" rows="10" required class="uw-input block min-h-[258px]" />
          </div>
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          {siteKey && <div class="cf-turnstile mt-[14.4px]" data-sitekey={siteKey} />}
          <div class="mt-1.5"><button type="submit" class="uw-cf-submit">{t.contactFormSubmit}</button></div>
          <p class="form-status mt-[14.4px] text-sm empty:hidden" role="status" aria-live="polite" data-sent={t.contactFormSent} data-error={t.contactFormError} />
        </form>
      )
    }
  </div>
</Section>

<style>
  /* Contact Form 7 on production: h6-style labels (8px above, 16px below),
     theme-reset inputs on lines of their own, a Kindle submit at 16px/400
     with the theme's 1px #c36 border. The form sits 20px below the address
     text (whose last paragraph keeps its 14.4px), after an empty 24px line. */
  .uw-cf { margin-top: calc(24px + 0.9rem); margin-bottom: 0.9rem; }
  .uw-cf-field + .uw-cf-field { margin-top: calc(24px + 0.9rem); }
  .uw-cf-label { display: block; margin-bottom: 16px; font-family: var(--font-heading); font-size: 1rem; line-height: 1.2; font-weight: 500; color: #333; }
  .uw-cf-submit { font-family: var(--font-system); font-size: 1rem; line-height: 1.5; font-weight: 400; color: #fff; background: var(--color-kindle); border: 1px solid #c36; border-radius: 4px; padding: 8px 16px; cursor: pointer; transition: background-color 0.3s; }
  .uw-cf-submit:hover, .uw-cf-submit:focus-visible { background: var(--color-inspire); }
  .uw-cf-submit:focus-visible { outline-color: var(--color-ocean); }
</style>

{enabled && siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
{
  enabled && (
    <script>
      document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const status = form.querySelector<HTMLElement>('.form-status')!;
          const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
          btn.disabled = true;
          try {
            const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
            if (!res.ok) throw new Error(String(res.status));
            status.textContent = status.dataset.sent!;
            form.reset();
            (window as unknown as { dataLayer?: unknown[] }).dataLayer?.push({ event: 'contact_form_submit' });
          } catch {
            status.textContent = status.dataset.error!;
          } finally {
            btn.disabled = false;
          }
        });
      });
    </script>
  )
}
