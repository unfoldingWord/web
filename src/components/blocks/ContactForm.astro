---
// Contact details and (when enabled) the contact form.
//
// The form posts to /api/contact, handled by the Worker (worker/contact.ts):
// Turnstile spam check, then email to the address in the CONTACT_TO secret.
// Where the old Contact Form 7 form sent its mail is NOT yet confirmed, so the
// form stays off until it is: set PUBLIC_CONTACT_FORM=1 at build time once
// CONTACT_TO and the Turnstile keys are configured (docs/forms.md). Until
// then the block shows the postal address and phone number only.
import type { Block } from '../../content.config';
import type { PortfolioKey } from '../../lib/portfolios';
import { SITE } from '../../lib/site';
import { ui } from '../../i18n';
import { mdInline } from '../../lib/md';
import Section from '../ui/Section.astro';

type ContactForm = Extract<Block, { type: 'contactForm' }>;
interface Props {
  block: ContactForm;
  locale: string;
  portfolio?: PortfolioKey;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const enabled = import.meta.env.PUBLIC_CONTACT_FORM === '1';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
// The form's own intro ("Use the contact form below…") only makes sense with
// the form on; without it the block shows `intro`.
const intro = enabled && block.formIntro ? block.formIntro : block.intro;
---

<Section>
  <div class="mx-auto flex max-w-[800px] flex-col gap-8">
    <div class="flex flex-col gap-4">
      {block.title && <h2 set:html={mdInline(block.title)} />}
      {intro && <p class="lead" set:html={mdInline(intro, locale)} />}
      <address class="flex flex-col gap-1 not-italic text-ink">
        <span>{SITE.address.streetAddress.split(/,\s*/).map((part) => <>{part}<br /></>)}{SITE.address.addressLocality}, {SITE.address.addressRegion} {SITE.address.postalCode}</span>
        <a href={`tel:${SITE.telephone}`} class="self-start font-extrabold text-inspire-ink hover:text-ocean">{SITE.telephoneDisplay}</a>
      </address>
    </div>
    {
      enabled && (
        <form class="contact-form flex flex-col gap-5 rounded-media bg-mist p-5 sm:p-8" method="post" action="/api/contact" novalidate>
          <div class="flex flex-col gap-1.5">
            <label for="cf-name" class="cf-label">{t.contactFormName}</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required class="uw-input block" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="cf-email" class="cf-label">{t.contactFormEmail}</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required class="uw-input block" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="cf-message" class="cf-label">{t.contactFormMessage}</label>
            <textarea id="cf-message" name="message" rows="8" required class="uw-input block min-h-[200px]" />
          </div>
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} />}
          <div><button type="submit" class="uw-btn uw-btn-primary uw-btn-md disabled:opacity-60">{t.contactFormSubmit}</button></div>
          <p class="form-status text-[15px] font-semibold text-ocean empty:hidden" role="status" aria-live="polite" data-sent={t.contactFormSent} data-error={t.contactFormError} />
        </form>
      )
    }
  </div>
</Section>

<style>
  .cf-label { font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); }
</style>

{enabled && siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
{
  enabled && (
    <script>
      document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const status = form.querySelector<HTMLElement>('.form-status')!;
          const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
          btn.disabled = true;
          try {
            const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
            if (!res.ok) throw new Error(String(res.status));
            status.textContent = status.dataset.sent!;
            form.reset();
            (window as unknown as { dataLayer?: unknown[] }).dataLayer?.push({ event: 'contact_form_submit' });
          } catch {
            status.textContent = status.dataset.error!;
          } finally {
            btn.disabled = false;
          }
        });
      });
    </script>
  )
}
