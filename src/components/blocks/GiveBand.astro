---
// The closing give section on most pages
// (docs/design-system/designs/GiveBand.dc.html): Ocean grain panel with the
// headline and Give button, a photo beside it, and the accountability marks.
// PageTemplate adds one to every standard page; a page can also place it.
import type { Block } from '../../content.config';
import { md, mdInline, localizeHref } from '../../lib/md';
import { ui } from '../../i18n';
import { SITE } from '../../lib/site';
import Picture from '../ui/Picture.astro';

type GiveBand = Extract<Block, { type: 'giveBand' }>;
interface Props {
  block: GiveBand;
  locale: string;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const action = block.action ?? { label: (t as Record<string, unknown>).giveNow as string ?? 'Give now', href: '/give/', style: 'give' as const };
---

<section class="uw-grain on-dark flex flex-wrap" aria-labelledby="give-band-title">
  <div class="flex min-w-0 flex-[1_1_32.5rem] flex-col justify-center gap-5.5 px-[clamp(1rem,5vw,5.5rem)] py-[clamp(3.5rem,6vw,5.5rem)]">
    <h2 id="give-band-title" class="text-[clamp(2rem,1.3rem+2.4vw,3.375rem)] leading-[1.06]" set:html={mdInline(block.title, locale)} />
    {block.body && <div class="prose max-w-[34rem] text-lead !text-inspire-100" set:html={md(block.body, locale)} />}
    <div><a href={localizeHref(action.href, locale)} class:list={['uw-btn uw-btn-lg', `uw-btn-${action.style ?? 'give'}`]}>{action.label}</a></div>
    <ul class="flex flex-wrap gap-x-6 gap-y-1.5 text-[0.9375rem] text-inspire-100">
      {SITE.trust.map((b) => <li>{b.label}</li>)}
    </ul>
  </div>
  {
    block.image && (
      <div class="relative min-h-80 min-w-0 flex-[1_1_32.5rem] lg:min-h-140">
        <Picture path={block.image} alt={block.imageAlt ?? ''} sizes="(min-width: 64rem) 50vw, 100vw" fill class="absolute inset-0" />
      </div>
    )
  }
</section>
