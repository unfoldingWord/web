---
// Short centered statements in one or two columns. Each item opens with a
// large `lead` phrase in Avenir Black; the Inspire tone uses Inspire ink
// (Inspire itself fails contrast on white).
import type { Block } from '../../content.config';
import { mdInline } from '../../lib/md';
import Section from '../ui/Section.astro';

type Statement = Extract<Block, { type: 'statement' }>;
interface Props {
  block: Statement;
  locale: string;
}
const { block, locale } = Astro.props;
---

<Section>
  <div class:list={['grid gap-x-16 gap-y-10', block.columns.length > 1 && 'md:grid-cols-2']}>
    {
      block.columns.map((col) => (
        <div class="flex flex-col gap-8 text-center">
          {col.items.map((item) => (
            <p class:list={['text-lead', col.tone === 'inspire' ? 'text-inspire-ink' : 'text-ocean']}>
              <span class="mb-1 block font-heading text-h3 font-black" set:html={mdInline(item.lead, locale)} />
              <span set:html={mdInline(item.text, locale)} />
            </p>
          ))}
        </div>
      ))
    }
  </div>
</Section>
