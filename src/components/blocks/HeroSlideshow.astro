---
// Older home opener: shown as the Deep Ocean photo hero with its first
// slide beside the text (no crossfade). Later slides stay valid in content
// but are not shown.
import type { Block } from '../../content.config';
import { mdInline } from '../../lib/md';
import Picture from '../ui/Picture.astro';
import Actions from '../ui/Actions.astro';

type HeroSlideshow = Extract<Block, { type: 'heroSlideshow' }>;
interface Props {
  block: HeroSlideshow;
  locale: string;
}
const { block, locale } = Astro.props;
const first = block.slides[0];
---

<section class="uw-grain-deep on-dark flex flex-wrap overflow-hidden">
  <div class="flex min-w-0 flex-[1_1_520px] flex-col justify-center gap-[22px] px-[var(--spacing-gutter)] py-14 md:px-[clamp(32px,5vw,88px)] md:py-[72px]">
    <h1 class="max-w-[900px] text-[clamp(36px,4.2vw,58px)] leading-[1.06]" set:html={mdInline(block.title, locale)} />
    {block.subtitle && <p class="lead max-w-[560px]" set:html={mdInline(block.subtitle, locale)} />}
    {block.body && <p class="max-w-[560px] text-inspire-100" set:html={mdInline(block.body, locale)} />}
    <Actions actions={block.actions} locale={locale} class="gap-3" />
  </div>
  <div class="relative h-[340px] min-w-0 flex-[1_1_520px] md:h-[600px]">
    <Picture path={first.image} alt={first.imageAlt} eager fill sizes="(min-width: 65rem) 50vw, 100vw" class="absolute inset-0" />
  </div>
</section>
