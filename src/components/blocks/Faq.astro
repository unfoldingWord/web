---
// Questions and answers as native <details> (keyboard and screen-reader
// friendly with no script). The page adds FAQPage JSON-LD from this block.
// Accordion rows between 1px lines; "+" turns to "−" when open. The first
// question is open on load (`openFirst: false` to close it).
import type { Block } from '../../content.config';
import { md, mdInline } from '../../lib/md';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';

type Faq = Extract<Block, { type: 'faq' }>;
interface Props {
  block: Faq;
  locale: string;
}
const { block, locale } = Astro.props;
---

<Section>
  <div class="mx-auto max-w-[880px]">
    <SectionHeader title={block.title} intro={block.intro} locale={locale} class="!mb-7" />
    <div class="border-b border-line">
      {
        block.items.map((it, i) => (
          <details class="group border-t border-line" open={block.openFirst !== false && i === 0}>
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-5 py-[18px] font-heading text-[20px] leading-snug font-extrabold text-ocean [&::-webkit-details-marker]:hidden">
              <span set:html={mdInline(it.q, locale)} />
              <span class="shrink-0 text-[26px] leading-none font-normal text-inspire-ink" aria-hidden="true">
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline">−</span>
              </span>
            </summary>
            <div class="prose max-w-[720px] pb-[22px] text-ink-muted" set:html={md(it.a, locale)} />
          </details>
        ))
      }
    </div>
    {block.body && <div class="prose mt-8" set:html={md(block.body, locale)} />}
  </div>
</Section>
