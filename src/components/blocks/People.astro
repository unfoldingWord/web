---
// People from src/content/people/{locale}/ whose `groups` include this
// block's group, ordered by `order` then name.
//
// Layouts:
//   board — production's leadership cards: two columns of a square photo
//           beside name, role, a short teaser (`summary`) and a "Read More"
//           button that opens the full bio in a dialog.
//   team  — production's our-team grid: four columns of a square photo with
//           a centered name and role, no bio.
//   grid / list — cards with a bio that expands in place.
import { getCollection } from 'astro:content';
import type { Block } from '../../content.config';
import { md, mdInline } from '../../lib/md';
import { splitId } from '../../lib/routes';
import { ui } from '../../i18n';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Picture from '../ui/Picture.astro';

type People = Extract<Block, { type: 'people' }>;
interface Props {
  block: People;
  locale: string;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const all = await getCollection('people');
// Prefer this locale's version of each person, else English.
const bySlug = new Map<string, (typeof all)[number]>();
for (const p of all) {
  const { locale: l, rest } = splitId(p.id);
  if (l === 'en' && !bySlug.has(rest)) bySlug.set(rest, p);
  if (l === locale) bySlug.set(rest, p);
}
const people = [...bySlug.values()]
  .filter((p) => p.data.groups.includes(block.group))
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
const layout = block.layout;
const slug = (p: (typeof people)[number]) => splitId(p.id).rest.replace(/[^a-z0-9-]/gi, '-');
// Production follows a paragraph with its 14.4px bottom margin plus the 20px gap (padding: a margin would collapse into the header's).
const afterIntro = block.intro ? 'pt-[0.9rem]' : '';
---

{
  layout === 'board' ? (
    // Production adds a 50px spacer under the board, so the next heading
    // sits 70px below the last card, not 80px.
    <Section class="uw-board !pb-[30px]">
      <SectionHeader title={block.title} intro={block.intro} locale={locale} />
      <ul class:list={['grid gap-5 md:grid-cols-2', afterIntro]}>
        {people.map((p) => {
          const photo = p.data.boardPhoto ?? p.data.photo;
          const alt = p.data.boardPhoto ? p.data.boardPhotoAlt : p.data.photoAlt;
          const id = `bio-${slug(p)}`;
          return (
            <li class="flex flex-wrap items-center gap-5 md:flex-nowrap">
              {photo && (
                <div class="w-full md:w-[calc(50%-10px)] md:shrink-0">
                  <Picture path={photo} alt={alt ?? p.data.name} sizes="(min-width: 48rem) 235px, 100vw" widths={[320, 480, 720]} aspect="1 / 1" class="uw-board-photo" />
                </div>
              )}
              <div class="flex w-full min-w-0 flex-col gap-2.5 md:w-[calc(50%-10px)]">
                <h3 class="uw-person-name">{p.data.name}</h3>
                {p.data.role && <p class="uw-person-role">{p.data.role}</p>}
                {(p.data.summary || p.data.bio) && (
                  <div class="uw-board-summary prose">
                    {p.data.summary ? <p set:html={mdInline(p.data.summary, locale)} /> : <div class="line-clamp-4" set:html={md(p.data.bio, locale)} />}
                  </div>
                )}
                {p.data.bio && (
                  <div>
                    <button type="button" class="uw-btn uw-btn-primary uw-btn-md" data-bio-open={id} aria-haspopup="dialog">
                      {t.readBio}
                      <span class="sr-only">: {p.data.name}</span>
                    </button>
                  </div>
                )}
              </div>
              {p.data.bio && (
                <dialog id={id} class="uw-bio" aria-labelledby={`${id}-name`}>
                  <button type="button" class="uw-bio-close" data-bio-close aria-label={t.hideBio}>×</button>
                  <div class="uw-bio-window">
                    <div class="flex flex-wrap items-center md:flex-nowrap">
                      {photo && (
                        <div class="w-full md:w-[35%] md:shrink-0">
                          <Picture path={photo} alt={alt ?? p.data.name} sizes="(min-width: 48rem) 30vw, 95vw" widths={[480, 720, 900]} aspect="1 / 1" class="border-2 border-white" />
                        </div>
                      )}
                      <div class="flex min-w-0 flex-1 flex-col gap-2.5 bg-white p-5">
                        <h2 id={`${id}-name`} class="uw-person-name">{p.data.name}</h2>
                        {p.data.role && <p class="uw-person-role">{p.data.role}</p>}
                        <div class="prose" set:html={md(p.data.bio, locale)} />
                      </div>
                    </div>
                  </div>
                </dialog>
              )}
            </li>
          );
        })}
      </ul>
    </Section>
  ) : layout === 'team' ? (
    <Section>
      <SectionHeader title={block.title} intro={block.intro} locale={locale} />
      {/* Production's grid has seven explicit 1fr rows, then auto rows: the
          first seven rows share the tallest of their heights (at every width),
          later rows fit their own cards. Measured at 1440 and 390. */}
      <ul class:list={['uw-team-grid grid gap-5 md:grid-cols-2 tablet:grid-cols-4', afterIntro]}>
        {people.map((p) => (
          <li class="flex flex-col text-center">
            {p.data.photo ? (
              <Picture path={p.data.photo} alt={p.data.photoAlt ?? p.data.name} sizes="(min-width: 66.0625rem) 235px, (min-width: 48rem) 50vw, 100vw" widths={[320, 480, 720]} aspect="1 / 1" />
            ) : (
              // Production shows a grey silhouette for someone without a photo.
              <Picture path="people/portrait-placeholder.jpg" alt="" sizes="(min-width: 66.0625rem) 235px, (min-width: 48rem) 50vw, 100vw" widths={[320, 480]} aspect="1 / 1" />
            )}
            <div class="mt-[30px] flex flex-col gap-2.5">
              <h2 class="uw-person-name">{p.data.name}</h2>
              {p.data.role && <p class="uw-person-role">{p.data.role}</p>}
            </div>
          </li>
        ))}
      </ul>
    </Section>
  ) : (
    <Section>
      <SectionHeader title={block.title} intro={block.intro} locale={locale} />
      <ul class:list={['grid gap-6', layout === 'grid' ? 'sm:grid-cols-2 lg:grid-cols-3' : 'mx-auto max-w-4xl']}>
        {people.map((p) => (
          <li class:list={['uw-card flex', layout === 'grid' ? 'flex-col' : 'flex-col sm:flex-row']}>
            {p.data.photo ? (
              <div class:list={['shrink-0', layout === 'list' && 'sm:w-56']}>
                <Picture path={p.data.photo} alt={p.data.photoAlt ?? p.data.name} sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw" widths={[320, 480, 720]} aspect="1 / 1" />
              </div>
            ) : null}
            <div class="flex flex-1 flex-col gap-2.5 py-5">
              <h3 class="uw-person-name">{p.data.name}</h3>
              {p.data.role && <p class="uw-person-role">{p.data.role}</p>}
              {p.data.bio && <div class="prose" set:html={md(p.data.bio, locale)} />}
            </div>
          </li>
        ))}
      </ul>
    </Section>
  )
}

<style>
  /* Production: name h2 36/36/300 Inspire, role h3 20/20/500 Tech. */
  :global(.uw-person-name) { font-size: 2.25rem; line-height: 1; font-weight: 300; color: var(--color-inspire); margin: 0; text-wrap: wrap; }
  :global(.uw-person-role) { font-family: var(--font-heading); font-size: var(--text-h5); line-height: 1; font-weight: 500; color: var(--color-tech); margin: 0; text-wrap: wrap; }
  .uw-team-grid { grid-template-rows: repeat(7, 1fr); }
  /* Board heading is the one 900-weight h2 production uses. */
  :global(.uw-board h2:not(.uw-person-name)) { font-weight: 900; }
  /* Teaser: 19/28.5/300, the paragraph keeps its 14.4px margin. */
  :global(.uw-board-summary) { font-size: 19px; line-height: 1.5; }
  /* Hover: Elementor "float" (up 8px) and the photo turns grey. */
  :global(.uw-board-photo) { transition: transform 0.3s, filter 0.3s; }
  :global(.uw-board li:hover .uw-board-photo) { transform: translateY(-8px); filter: saturate(0%); }

  /* Bio dialog: PowerPack modal popup. Ocean 75% overlay, a window 80% of
     the viewport (90% under 1057px, 95% under 768px), zoom-in. */
  :global(dialog.uw-bio) { position: fixed; inset: 0; width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; overflow-y: auto; }
  :global(dialog.uw-bio:not([open])) { display: none; }
  :global(dialog.uw-bio[open]) { display: flex; align-items: center; justify-content: center; }
  :global(dialog.uw-bio::backdrop) { background: rgb(1 66 99 / 0.75); }
  :global(.uw-bio-window) { width: 95%; padding: 20px; margin-block: auto; text-align: start; }
  :global(.uw-bio-window .prose p:last-child) { margin-bottom: 0; }
  @media (min-width: 48rem) { :global(.uw-bio-window) { width: 90%; } }
  @media (min-width: 66.0625rem) { :global(.uw-bio-window) { width: 80%; } }
  :global(dialog.uw-bio[open] .uw-bio-window) { animation: uw-bio-zoom 0.2s ease-in-out; }
  @keyframes uw-bio-zoom { from { opacity: 0; transform: scale(0.8); } to { opacity: 1; transform: scale(1); } }
  :global(.uw-bio-close) { position: fixed; top: 50px; inset-inline-end: 50px; z-index: 1; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-family: Arial, Baskerville, monospace; font-size: 28px; line-height: 1; color: #fff; background: none; border: 0; cursor: pointer; opacity: 0.65; transition: opacity 0.5s; }
  :global(.uw-bio-close:hover), :global(.uw-bio-close:focus-visible) { opacity: 1; }
  @media (max-width: 47.99rem) { :global(.uw-bio-close) { top: 12px; inset-inline-end: 12px; } }
  :global(html:has(dialog.uw-bio[open])) { overflow: hidden; }
</style>

<script>
  // Open with the button; close with ×, Escape (native) or a click outside the window.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-bio-open]')) {
    const dialog = document.getElementById(btn.dataset.bioOpen!) as HTMLDialogElement | null;
    if (!dialog) continue;
    btn.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-bio-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      const win = dialog.querySelector('.uw-bio-window');
      if (!win || !win.contains(e.target as Node)) dialog.close();
    });
  }
</script>
