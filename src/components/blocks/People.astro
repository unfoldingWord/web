---
// People from src/content/people/{locale}/ whose `groups` include this
// block's group, ordered by `order` then name.
//
// Layouts:
//   board, grid — portrait cards (4:5 photo, name, role). Someone with a
//                 bio gets a "Read More" button that opens it in a dialog.
//   team, list  — a compact Mist section: white rows with a round photo (or
//                 initials), name and role.
import { getCollection } from 'astro:content';
import type { Block } from '../../content.config';
import type { PortfolioKey } from '../../lib/portfolios';
import { md } from '../../lib/md';
import { splitId } from '../../lib/routes';
import { ui } from '../../i18n';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Picture from '../ui/Picture.astro';
import Icon from '../ui/Icon.astro';

type People = Extract<Block, { type: 'people' }>;
interface Props {
  block: People;
  locale: string;
  portfolio?: PortfolioKey;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const all = await getCollection('people');
// Prefer this locale's version of each person, else English.
const bySlug = new Map<string, (typeof all)[number]>();
for (const p of all) {
  const { locale: l, rest } = splitId(p.id);
  if (l === 'en' && !bySlug.has(rest)) bySlug.set(rest, p);
  if (l === locale) bySlug.set(rest, p);
}
const people = [...bySlug.values()]
  .filter((p) => p.data.groups.includes(block.group))
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
const compact = block.layout === 'team' || block.layout === 'list';
const slug = (p: (typeof people)[number]) => splitId(p.id).rest.replace(/[^a-z0-9-]/gi, '-');
// Each person is named in an h3 under the block's h2, or an h2 when the block has no title.
const Name = block.title ? 'h3' : 'h2';
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .map((w) => w[0])
    .filter((c) => /\p{L}/u.test(c))
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

{
  compact ? (
    <Section background="mist">
      <div class="flex flex-col gap-9">
        <SectionHeader title={block.title} intro={block.intro} locale={locale} />
        <ul class="grid gap-4 sm:grid-cols-2 tablet:grid-cols-3 min-[90rem]:grid-cols-4">
          {people.map((p) => (
            <li class="flex min-w-0 items-center gap-4 rounded-small bg-white p-4">
              {p.data.photo ? (
                <Picture path={p.data.photo} alt={p.data.photoAlt ?? p.data.name} sizes="72px" widths={[72, 144]} aspect="1 / 1" class="!size-[72px] shrink-0 rounded-full !object-[50%_15%]" />
              ) : (
                <div aria-hidden="true" class="flex size-[72px] shrink-0 items-center justify-center rounded-full bg-inspire-100 text-[22px] font-extrabold text-ocean">
                  {initials(p.data.name)}
                </div>
              )}
              <div class="flex min-w-0 flex-col">
                <Name class="person-row-name">{p.data.name}</Name>
                {p.data.role && <p class="text-[15px] leading-snug text-ink-muted">{p.data.role}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </Section>
  ) : (
    <Section>
      <div class="flex flex-col gap-9">
        <SectionHeader title={block.title} intro={block.intro} locale={locale} />
        <ul class="grid grid-cols-1 gap-x-6 gap-y-8 min-[30rem]:grid-cols-2 tablet:grid-cols-4">
          {people.map((p) => {
            const photo = p.data.boardPhoto ?? p.data.photo;
            const alt = p.data.boardPhoto ? p.data.boardPhotoAlt : p.data.photoAlt;
            const id = `bio-${slug(p)}`;
            return (
              <li class="flex min-w-0 flex-col gap-3.5">
                {photo ? (
                  <Picture path={photo} alt={alt ?? p.data.name} sizes="(min-width: 66rem) 302px, (min-width: 30rem) 50vw, 100vw" widths={[320, 480, 640]} aspect="4 / 5" class="block rounded-card bg-mist !object-[50%_15%]" />
                ) : (
                  <div aria-hidden="true" class="flex aspect-[4/5] items-center justify-center rounded-card bg-inspire-100 text-5xl font-extrabold text-ocean">{initials(p.data.name)}</div>
                )}
                <div class="flex flex-col gap-0.5">
                  <Name class="person-name">{p.data.name}</Name>
                  {p.data.role && <p class="text-ink-muted">{p.data.role}</p>}
                </div>
                {p.data.bio && (
                  <button type="button" class="uw-more self-start" data-bio-open={id} aria-haspopup="dialog">
                    {t.readBio}
                    <Icon name="arrow-right" class="size-[18px] rtl:-scale-x-100" />
                    <span class="sr-only">: {p.data.name}</span>
                  </button>
                )}
                {p.data.bio && (
                  <dialog id={id} class="uw-bio" aria-labelledby={`${id}-name`}>
                    <div class="uw-bio-window">
                      <div class="uw-bio-head">
                        <h2 id={`${id}-name`} class="text-h3">{p.data.name}</h2>
                        <button type="button" class="uw-bio-close" data-bio-close aria-label={t.hideBio}>
                          <Icon name="close" class="size-6" />
                        </button>
                      </div>
                      <div class="uw-bio-body flex flex-col gap-6 sm:flex-row sm:items-start">
                        {photo && (
                          <div class="w-40 shrink-0 sm:w-56">
                            <Picture path={photo} alt={alt ?? p.data.name} sizes="224px" widths={[224, 448]} aspect="4 / 5" class="block rounded-small !object-[50%_15%]" />
                          </div>
                        )}
                        <div class="flex min-w-0 flex-1 flex-col gap-3">
                          {p.data.role && <p class="label">{p.data.role}</p>}
                          <div class="prose" set:html={md(p.data.bio, locale)} />
                        </div>
                      </div>
                    </div>
                  </dialog>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </Section>
  )
}

<style>
  .person-name { margin: 0; font-size: 1.375rem; line-height: 1.2; font-weight: 800; color: var(--color-ocean); }
  .person-row-name { margin: 0; font-size: 1.1875rem; line-height: 1.25; font-weight: 800; color: var(--color-ocean); }
  button.uw-more { min-height: 44px; background: none; border: 0; padding: 0; cursor: pointer; font-family: var(--font-heading); font-size: 1rem; }

  /* Bio dialog: a white card over an Ocean backdrop. */
  dialog.uw-bio { width: min(880px, calc(100% - 2rem)); max-height: calc(100dvh - 2rem); margin: auto; padding: 0; border: 0; border-radius: var(--radius-media); background: #fff; box-shadow: var(--shadow-raised); overflow-y: auto; }
  dialog.uw-bio::backdrop { background: rgb(1 44 66 / 0.7); }
  .uw-bio-window { position: relative; text-align: start; }
  /* Name and close stay at the top while a long bio scrolls (phones). */
  .uw-bio-head { position: sticky; top: 0; z-index: 1; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: clamp(16px, 3vw, 28px) clamp(24px, 4vw, 40px) 14px; background: #fff; border-bottom: 1px solid var(--color-line); }
  .uw-bio-head h2 { margin: 0; padding-top: 4px; }
  .uw-bio-body { padding: 24px clamp(24px, 4vw, 40px) clamp(24px, 4vw, 40px); }
  dialog.uw-bio[open] .uw-bio-window { animation: uw-bio-in 0.2s ease-out; }
  @keyframes uw-bio-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .uw-bio-close { flex: none; margin-inline-end: -8px; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; border-radius: 999px; background: var(--color-mist); color: var(--color-ocean); cursor: pointer; }
  .uw-bio-close:hover { background: var(--color-inspire-100); }
  :global(html:has(dialog.uw-bio[open])) { overflow: hidden; }
</style>

<script>
  // Open with the button; close with ×, Escape (native) or a click on the backdrop.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-bio-open]')) {
    const dialog = document.getElementById(btn.dataset.bioOpen!) as HTMLDialogElement | null;
    if (!dialog) continue;
    btn.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-bio-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
