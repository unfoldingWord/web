---
// Index of the Sweet Publishing illustration books (Old and New Testament).
import { getCollection } from 'astro:content';
import type { Block } from '../../content.config';
import { localizePath, ui, fmt } from '../../i18n';
import { basePathFor, splitId } from '../../lib/routes';
import { sweetImageUrl } from '../../lib/sweet';
import Section from '../ui/Section.astro';

type SweetBooks = Extract<Block, { type: 'sweetBooks' }>;
interface Props {
  block: SweetBooks;
  locale: string;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const books = (await getCollection('sweet')).filter((b) => splitId(b.id).locale === 'en').sort((a, b) => a.data.order - b.data.order);
const groups = [
  { key: 'ot', label: t.oldTestament, items: books.filter((b) => b.data.testament === 'ot') },
  { key: 'nt', label: t.newTestament, items: books.filter((b) => b.data.testament === 'nt') },
];
---

<Section>
  {block.title && <h2 class="mb-8">{block.title}</h2>}
  {
    groups.map((g) => (
      <div class="mb-12">
        <h3 class="mb-5">{g.label}</h3>
        <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {g.items.map((b) => {
            const first = b.data.chapters[0]?.images[0];
            const count = b.data.chapters.reduce((n, c) => n + c.images.length, 0);
            return (
              <li class="card group relative">
                {first && <img src={sweetImageUrl(first, 'thumb')} alt="" loading="lazy" decoding="async" width="480" height="320" class="aspect-[3/2] w-full object-cover" />}
                <div class="p-4">
                  <a href={localizePath(basePathFor('sweet', splitId(b.id).rest), locale)} class="font-heading text-lg font-extrabold text-ocean no-underline after:absolute after:inset-0 hover:underline">
                    {b.data.book}
                  </a>
                  <p class="text-sm text-ink-muted">{fmt(t.imagesCount, { count })}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</Section>
