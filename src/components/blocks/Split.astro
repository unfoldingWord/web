---
// Text beside an image or video (the "program" layout of the portfolio and
// article designs): h2, Markdown and an optional impact line in a takeaway
// box on one half, a rounded photo or video on the other. The halves wrap
// to a stack on narrow screens. `actionsBelowMedia` puts the buttons under
// the media. `variant: callout` and `uppercase` are older cosmetic flags.
// A tall (portrait) photo is cropped to at most 560px high, so the text
// beside it does not float in a long empty column.
import type { Block } from '../../content.config';
import { md, mdInline } from '../../lib/md';
import Section from '../ui/Section.astro';
import Picture from '../ui/Picture.astro';
import Actions from '../ui/Actions.astro';
import VideoFrame from '../ui/VideoFrame.astro';

type Split = Extract<Block, { type: 'split' }>;
interface Props {
  block: Split;
  locale: string;
}
const { block, locale } = Astro.props;
const mediaFirst = block.imagePosition === 'start';
const hasMedia = Boolean(block.video || block.image);
const actionsUnderMedia = hasMedia && block.actionsBelowMedia;
const dark = block.background === 'ocean';
const id = (block as Split & { id?: string }).id;
// "Impact: …" → a bold "Impact." lead-in.
const impactMatch = block.impact?.match(/^\s*([^:]{1,24}):\s*([\s\S]*)$/);
const impactHtml = block.impact
  ? impactMatch
    ? `<strong class="font-extrabold ${dark ? 'text-white' : 'text-ocean'}">${mdInline(impactMatch[1], locale)}.</strong> ${mdInline(impactMatch[2], locale)}`
    : mdInline(block.impact, locale)
  : '';
---

<Section id={id} background={block.background}>
  <div class="flex flex-wrap items-center gap-x-[72px] gap-y-10">
    <div class:list={['flex min-w-0 flex-[1_1_420px] flex-col gap-5', mediaFirst && 'min-[60rem]:order-last']}>
      {block.title && <h2 set:html={mdInline(block.title, locale)} />}
      <div class="prose" set:html={md(block.body, locale)} />
      {
        block.impact && (
          <div class:list={['flex items-start gap-4 rounded-small px-6 py-5', dark ? 'bg-white/10' : block.background === 'mist' ? 'bg-white' : 'bg-mist']}>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-0.5 size-[26px] shrink-0 fill-kindle stroke-kindle" stroke-width="1.4">
              <path d="M12 5v14M5 12h14" fill="none" />
              <circle cx="12" cy="4" r="2.6" />
              <circle cx="12" cy="20" r="2.6" />
              <circle cx="4" cy="12" r="2.6" />
              <circle cx="20" cy="12" r="2.6" />
            </svg>
            <p set:html={impactHtml} />
          </div>
        )
      }
      {!actionsUnderMedia && <Actions actions={block.actions} locale={locale} class="mt-2 gap-3" />}
    </div>
    {
      hasMedia && (
        <div class="min-w-0 flex-[1_1_520px]">
          {block.video ? (
            <VideoFrame provider={block.video.provider} id={block.video.id} hash={block.video.hash} title={block.video.title} poster={block.video.poster} />
          ) : (
            <div class="overflow-hidden rounded-media">
              <Picture path={block.image!} alt={block.imageAlt ?? ''} sizes="(min-width: 65rem) 600px, 100vw" class="max-h-[560px] object-cover" />
            </div>
          )}
          {actionsUnderMedia && <Actions actions={block.actions} locale={locale} class="mt-6 justify-center gap-3" />}
        </div>
      )
    }
  </div>
</Section>
