---
// A grid of items. Variants:
//   (default), card, plain, legacy — white cards (photo on top, title, text,
//              "Learn more"); the whole card is the link.
//   centered, plain-centered — the same cards, centered.
//   outlined — flat cards (1px line border), centered, with an optional
//              Donate button beside the link.
//   tiles    — Ocean project tiles: photo, small label (a region), name and
//              a line. `filter: true` adds pill buttons built from the
//              labels that hide the other tiles (every tile stays in the
//              HTML; without JavaScript all show).
//   voices   — a wall of field voices: photo, the words in PT Serif, and
//              "title · label" under them, in three columns.
//   leaders  — quotes from leaders on Deep Ocean: round photo, words, and
//              the name (the title up to its first comma) with the rest.
// `impact` adds a takeaway box, `logo` a small logo beside the title,
// `donateHref` a Give button. `video` shows a video under the grid.
import type { Block } from '../../content.config';
import type { PortfolioKey } from '../../lib/portfolios';
import { md, mdInline, localizeHref } from '../../lib/md';
import { ui } from '../../i18n';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Picture from '../ui/Picture.astro';
import Icon from '../ui/Icon.astro';
import VideoFrame from '../ui/VideoFrame.astro';

type Cards = Extract<Block, { type: 'cards' }>;
interface Props {
  block: Cards;
  locale: string;
  portfolio?: PortfolioKey;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const tx = t as unknown as Record<string, string | undefined>;
const learnMore = tx.learnMore ?? 'Learn more';
const v = block.variant ?? 'card';
const center = ['centered', 'plain-centered', 'outlined'].includes(v) || block.align === 'center';
const headerAlign = center || block.align === 'heading' ? 'center' : 'start';
// Items name themselves in an h2 when the block has no heading of its own.
const Title = block.title ? 'h3' : 'h2';
const cols = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-2 tablet:grid-cols-3',
  4: 'sm:grid-cols-2 tablet:grid-cols-4',
  5: 'sm:grid-cols-2 md:grid-cols-3 tablet:grid-cols-5',
}[block.columns];
const sizes = {
  2: '(min-width: 48rem) 624px, 100vw',
  3: '(min-width: 66rem) 411px, (min-width: 48rem) 50vw, 100vw',
  4: '(min-width: 66rem) 302px, (min-width: 40rem) 50vw, 100vw',
  5: '(min-width: 66rem) 237px, (min-width: 48rem) 33vw, (min-width: 40rem) 50vw, 100vw',
}[block.columns];
const isExternal = (h: string) => /^https?:\/\//.test(h);
const ext = (h: string) => (isExternal(h) ? { rel: 'noopener' } : {});
const plainText = (s: string) => s.replace(/<[^>]+>/g, '').replace(/[*_`]/g, '');
// "Impact: The church is…" → a bold "Impact." and the sentence.
const impactParts = (s: string) => {
  const m = s.match(/^\s*([^:.]{1,24})[:.]\s+([\s\S]+)$/);
  return m ? { label: m[1], text: m[2] } : { label: '', text: s };
};
// leaders: "Bobby Gruenewald, Founder & CEO, YouVersion" → name and the rest.
const splitName = (s: string) => {
  const i = s.indexOf(',');
  return i < 0 ? { name: s, rest: '' } : { name: s.slice(0, i), rest: s.slice(i + 1).trim() };
};
// tiles: filter labels in order of first appearance.
const labels = [...new Set(block.items.map((it) => it.label).filter((l): l is string => Boolean(l)))];
// Section id for in-page links; tiles default to #projects.
const sectionId = (block as { id?: string }).id ?? (v === 'tiles' ? 'projects' : undefined);
const showFilter = v === 'tiles' && block.filter && labels.length > 1;
const allLabel = t.allRegions;
// voices: deal the items into three columns (1-4-7…, 2-5-8…, 3-6-9…) so
// reading order follows the visual order on wide screens.
const voiceCols = [0, 1, 2].map((c) => block.items.filter((_, i) => i % 3 === c)).filter((c) => c.length);
---

{
  v === 'leaders' ? (
    <section id={sectionId} class="uw-grain-deep on-dark section-y">
      <div class="container-page flex flex-col gap-9">
        <SectionHeader title={block.title} intro={block.intro} align={headerAlign} locale={locale} />
        <ul class="flex flex-wrap gap-x-12 gap-y-8">
          {block.items.map((item) => {
            const who = splitName(plainText(item.title));
            return (
              <li class="min-w-0 flex-[1_1_320px]">
                <figure class="flex items-start gap-[18px]">
                  {item.image && (
                    <Picture path={item.image} alt={item.imageAlt ?? ''} sizes="84px" widths={[84, 168]} aspect="1 / 1" class="!size-[84px] shrink-0 rounded-full" />
                  )}
                  <div class="flex min-w-0 flex-col gap-2">
                    {item.body && <blockquote class="leader-quote" set:html={md(item.body, locale)} />}
                    <figcaption class="text-[15px] text-inspire-100">
                      <strong class="font-extrabold text-cultivate">{who.name}</strong>
                      {who.rest && <>, {who.rest}</>}
                      {item.label && <> · {item.label}</>}
                    </figcaption>
                  </div>
                </figure>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  ) : v === 'voices' ? (
    <Section id={sectionId} background={block.background === 'white' ? 'mist' : block.background}>
      <div class="flex flex-col gap-9">
        <SectionHeader title={block.title} intro={block.intro} align={headerAlign} locale={locale} />
        <div class="flex flex-wrap items-start gap-6">
          {voiceCols.map((col) => (
            <ul class="flex min-w-0 flex-[1_1_320px] flex-col gap-6">
              {col.map((item) => (
                <li>
                  <figure class="uw-card voice">
                    {item.image && <Picture path={item.image} alt={item.imageAlt ?? ''} sizes="(min-width: 66rem) 411px, (min-width: 44rem) 50vw, 100vw" widths={[400, 640, 820]} aspect="4 / 3" class="block" />}
                    <div class="flex flex-col gap-3 px-[26px] pt-6 pb-7">
                      {item.body && <div class="voice-words" set:html={md(item.body, locale)} />}
                      <figcaption class="text-[15px] text-ink-muted">
                        <strong class="font-extrabold text-ink" set:html={mdInline(item.title, locale)} />
                        {item.label && <> · {item.label}</>}
                      </figcaption>
                      {item.href && (
                        <a href={localizeHref(item.href, locale)} class="uw-more" {...ext(item.href)}>
                          {item.linkLabel ?? learnMore}
                          <Icon name="arrow-right" class="size-[18px] rtl:-scale-x-100" />
                          <span class="sr-only">: {plainText(item.title)}</span>
                        </a>
                      )}
                    </div>
                  </figure>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </Section>
  ) : v === 'tiles' ? (
    <Section id={sectionId} background={block.background === 'white' ? 'mist' : block.background}>
      <div class="flex flex-col gap-8" data-tile-filter={showFilter ? '' : undefined}>
        <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
          <div class="max-w-[640px]">
            <SectionHeader title={block.title} intro={block.intro} locale={locale} />
          </div>
          {showFilter && (
            <div class="flex flex-wrap gap-2" role="group" aria-label={tx.filterBy ?? 'Filter'} data-filter-pills hidden>
              <button type="button" class="uw-pill" aria-pressed="true" data-filter="">{allLabel}</button>
              {labels.map((l) => (
                <button type="button" class="uw-pill" aria-pressed="false" data-filter={l}>{l}</button>
              ))}
            </div>
          )}
        </div>
        <ul class="grid gap-6 sm:grid-cols-2 tablet:grid-cols-3">
          {block.items.map((item) => {
            const inner = (
              <>
                {item.image && <Picture path={item.image} alt={item.imageAlt ?? ''} sizes="(min-width: 66rem) 411px, (min-width: 40rem) 50vw, 100vw" widths={[400, 640, 840]} class="block !h-[300px] w-full object-cover" />}
                <div class="flex flex-col gap-1.5 px-[26px] pt-[22px] pb-[26px]">
                  {item.label && <span class="label">{item.label}</span>}
                  <Title class="tile-name" set:html={mdInline(item.title, locale)} />
                  {item.body && <p class="tile-line" set:html={mdInline(item.body, locale)} />}
                </div>
              </>
            );
            return (
              <li data-label={item.label ?? ''}>
                {item.href ? (
                  <a href={localizeHref(item.href, locale)} class="tile uw-grain on-dark" {...ext(item.href)}>{inner}</a>
                ) : (
                  <div class="tile uw-grain on-dark">{inner}</div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </Section>
  ) : (
    <Section id={sectionId} background={block.background}>
      <div class="flex flex-col gap-9">
        <SectionHeader title={block.title} intro={block.intro} align={headerAlign} locale={locale} />
        <ul class:list={['grid gap-6', cols]}>
          {block.items.map((item) => {
            const impact = item.impact ? impactParts(item.impact) : undefined;
            return (
              <li class:list={['card relative flex flex-col', v === 'outlined' ? 'uw-card-flat' : 'uw-card', center && 'text-center']}>
                {item.image && (
                  <Picture path={item.image} alt={item.imageAlt ?? ''} sizes={sizes} class="block !h-[230px] w-full object-cover" />
                )}
                <div class:list={['flex flex-1 flex-col gap-3 p-6', center && 'items-center']}>
                  {item.label && <span class="label">{item.label}</span>}
                  <Title class:list={['card-title text-h4', item.logo && 'flex flex-wrap items-center gap-3', center && item.logo && 'justify-center']}>
                    {item.logo && <Picture path={item.logo} alt={item.logoAlt ?? ''} sizes="44px" widths={[44, 88]} class="!size-11 shrink-0 object-contain" />}
                    <span set:html={mdInline(item.title, locale)} />
                  </Title>
                  {item.body && <div class="prose card-body" set:html={md(item.body, locale)} />}
                  {impact && (
                    <div class="flex items-start gap-4 rounded-small bg-mist px-5 py-4 text-start">
                      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" class="mt-0.5 shrink-0 text-kindle" fill="currentColor" stroke="currentColor" stroke-width="1.4"><path d="M12 5v14M5 12h14" fill="none" /><circle cx="12" cy="4" r="2.6" /><circle cx="12" cy="20" r="2.6" /><circle cx="4" cy="12" r="2.6" /><circle cx="20" cy="12" r="2.6" /></svg>
                      <p class="text-ink">
                        {impact.label && <strong class="font-extrabold text-ocean">{impact.label}. </strong>}
                        <span set:html={mdInline(impact.text, locale)} />
                      </p>
                    </div>
                  )}
                  {(item.href || item.donateHref) && (
                    <div class:list={['mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-2', center && 'justify-center']}>
                      {item.href && (
                        <a href={localizeHref(item.href, locale)} class="uw-more card-link" {...ext(item.href)}>
                          {item.linkLabel ?? learnMore}
                          <Icon name="arrow-right" class="size-[18px] rtl:-scale-x-100" />
                          <span class="sr-only">: {plainText(item.title)}</span>
                        </a>
                      )}
                      {item.donateHref && (
                        <a href={localizeHref(item.donateHref, locale)} class="uw-btn uw-btn-give relative z-[1]">
                          {item.donateLabel ?? t.donateNow}
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
        {block.video && (
          <div class="mx-auto w-full max-w-[720px] overflow-hidden rounded-media">
            <VideoFrame provider={block.video.provider} id={block.video.id} hash={block.video.hash} title={block.video.title} poster={block.video.poster} />
          </div>
        )}
      </div>
    </Section>
  )
}

<style>
  /* Cards stay white with dark text on any ground, Ocean included. */
  .card { color: var(--color-ink); }
  .card-title { color: var(--color-ocean); font-weight: 800; margin: 0; }
  .card-body { color: var(--color-ink-muted); }
  .card .label { color: var(--color-inspire-ink); }
  .card-body :global(a:not(.uw-btn)) { position: relative; z-index: 1; color: var(--color-inspire-ink); text-decoration-color: var(--color-inspire); }
  /* The link covers the whole card. */
  .card-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card:has(.card-link:hover) { box-shadow: var(--shadow-raised); }
  .card:has(.card-link:focus-visible) { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .card-link:focus-visible { outline: none; }

  /* tiles */
  .tile { display: flex; flex-direction: column; height: 100%; overflow: hidden; border-radius: var(--radius-card); text-decoration: none; color: #fff; }
  .tile-name { margin: 0; font-size: 1.75rem; line-height: 1.1; font-weight: 800; color: #fff; }
  .tile-line { color: var(--color-inspire-100); }
    a.tile:hover .tile-name { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  [data-tile-filter] li[hidden] { display: none; }

  /* voices: a person's words in PT Serif */
  .voice { margin: 0; }
  .voice-words { font-family: var(--font-serif); font-size: 1.1875rem; line-height: 1.45; color: var(--color-ocean); }
  .voice-words :global(p + p) { margin-top: 0.6em; }
  /* Non-Latin scripts need their Noto face, not PT Serif. */
  :global(html:not([data-script='latin'], [data-script='cyrillic'])) .voice-words { font-family: var(--font-sans); }

  /* leaders */
  .leader-quote { margin: 0; font-size: 1.125rem; line-height: 1.55; color: #fff; }
  .leader-quote :global(p + p) { margin-top: 0.6em; }
</style>

<script>
  // tiles: filter by label. The pills appear only once this runs.
  document.querySelectorAll<HTMLElement>('[data-tile-filter]').forEach((root) => {
    const pills = root.querySelector<HTMLElement>('[data-filter-pills]');
    if (!pills) return;
    pills.hidden = false;
    const buttons = [...pills.querySelectorAll<HTMLButtonElement>('button[data-filter]')];
    const tiles = [...root.querySelectorAll<HTMLLIElement>('li[data-label]')];
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const want = btn.dataset.filter ?? '';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        tiles.forEach((li) => (li.hidden = Boolean(want) && li.dataset.label !== want));
      }),
    );
  });
</script>
