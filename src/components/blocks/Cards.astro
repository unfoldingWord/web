---
// A row of items. Production builds these from plain Elementor columns, so
// the default has no card chrome. Variants:
//   plain    — image, 32px Inspire title, text, Kindle "Impact" line, a
//              Learn More button (tools-technology, catalyzation, ccbt)
//   centered — the same, centered (for-translators, staff)
//   outlined — white box with a 1px Kindle border and 4px corners, centered
//              28px Inspire title, outline "Learn More" and optional filled
//              Donate button (wbwn regions). Production spreads image,
//              title and buttons over the box (space-between) and sets five
//              columns 10px apart.
//   card     — a white 4px card (kept for older content)
//   plain-centered — people cards (give/staff): photo at 293:217, square
//              corners, a 32px/400 Tech name, 19.36px text and a Kindle
//              button right under it, centered; all rows as tall as the
//              tallest, as production's grid does
import type { Block } from '../../content.config';
import { md, mdInline, localizeHref } from '../../lib/md';
import { ui } from '../../i18n';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Picture from '../ui/Picture.astro';

type Cards = Extract<Block, { type: 'cards' }>;
interface Props {
  block: Cards;
  locale: string;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const v = block.variant ?? 'plain';
const people = v === 'plain-centered';
const center = v === 'centered' || v === 'outlined' || people || block.align === 'center';
// People cards name each person in an h2 when the block has no title of its own.
const Title = people && !block.title ? 'h2' : 'h3';
const cols = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-2 tablet:grid-cols-3',
  4: 'sm:grid-cols-2 tablet:grid-cols-4',
  5: 'md:grid-cols-3 tablet:grid-cols-5',
}[block.columns];
const sizes = {
  2: '(min-width: 48rem) 490px, 100vw',
  3: '(min-width: 66rem) 320px, (min-width: 48rem) 50vw, 100vw',
  4: '(min-width: 66rem) 235px, (min-width: 40rem) 50vw, 100vw',
  5: '(min-width: 66rem) 150px, (min-width: 48rem) calc((100vw - 100px) / 3 - 42px), calc(100vw - 122px)',
}[block.columns];
const isExternal = (h: string) => /^https?:\/\//.test(h);
---

<Section background={block.background}>
  <SectionHeader title={block.title} intro={block.intro} align={block.align === 'center' || v === 'centered' ? 'center' : 'start'} locale={locale} />
  <ul class:list={['grid', v === 'outlined' && block.columns === 5 ? 'gap-2.5' : 'gap-5', v === 'outlined' && block.intro && 'pt-[0.9rem]', cols, people && 'uw-people p-2.5']} style={people ? `--uw-rows: ${Math.ceil(block.items.length / block.columns)}` : undefined}>
    {
      block.items.map((item) => (
        <li
          class:list={[
            'flex flex-col gap-5',
            center && 'items-center text-center',
            v === 'outlined' && 'justify-between rounded-card border border-kindle bg-white p-5',
            v === 'card' && 'uw-card p-5',
            v !== 'outlined' && v !== 'card' && 'p-2.5',
          ]}
        >
          {item.image && (
            <Picture
              path={item.image}
              alt={item.imageAlt ?? ''}
              sizes={sizes}
              aspect={v === 'outlined' ? '278 / 182' : v === 'centered' ? '1 / 1' : people ? '293 / 217' : undefined}
              class:list={['w-full', (v === 'outlined' || v === 'plain') && 'rounded-media-split']}
            />
          )}
          <Title class:list={['uw-card-title', v === 'outlined' ? 'text-h3' : 'text-h2', item.logo && 'flex items-center gap-5', block.background === 'ocean' && '!text-kindle', people && 'uw-person-name']}>
            <span set:html={mdInline(item.title)} />
            {item.logo && <Picture path={item.logo} alt={item.logoAlt ?? ''} sizes="50px" widths={[50, 100]} class="!w-[50px] shrink-0" />}
          </Title>
          {item.body && <div class:list={['prose w-full', people ? 'uw-person-text' : '[&>:last-child]:mb-0']} set:html={md(item.body, locale)} />}
          {item.impact && <p class="uw-impact w-full" set:html={mdInline(item.impact, locale)} />}
          {(item.href || item.donateHref) && (
            <div class:list={['flex flex-wrap gap-2.5', !people && v !== 'outlined' && 'mt-auto', center && 'justify-center', v === 'outlined' && block.columns <= 3 && 'uw-tall-btns']}>
              {item.href && (
                <a
                  href={localizeHref(item.href, locale)}
                  class:list={['uw-btn', v === 'outlined' ? 'uw-btn-secondary' : 'uw-btn-primary']}
                  {...(isExternal(item.href) ? { rel: 'noopener' } : {})}
                >
                  {item.linkLabel ?? t.readMore}
                  <span class="sr-only">: {item.title.replace(/[*_`]/g, '')}</span>
                </a>
              )}
              {item.donateHref && (
                <a href={localizeHref(item.donateHref, locale)} class="uw-btn uw-btn-give">
                  {item.donateLabel ?? t.donateNow}
                </a>
              )}
            </div>
          )}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  /* People cards (give/staff): production's grid declares as many 1fr rows
     as the full-width layout needs, so those rows are all as tall as the
     tallest card (on phones only the first rows are; the rest fit their
     card). 32/32 400 Tech names, 19.36/29.04 text that keeps its 14.4px
     paragraph margin. */
  .uw-people { grid-template-rows: repeat(var(--uw-rows), 1fr); }
  .uw-person-name { font-size: 32px; line-height: 32px; font-weight: 400; color: var(--color-tech); }
  .uw-person-text { font-size: 19.36px; line-height: 29.04px; color: var(--color-tech); }
  .uw-person-text > :global(:last-child) { margin-bottom: 14.4px; }
  /* wbwn region cards: production's buttons are 56px tall (20px 15px 19px). */
  .uw-tall-btns .uw-btn { padding: 20px 15px 19px; }
  .uw-impact { color: var(--color-kindle); font-size: var(--text-body); line-height: 1.6; font-weight: 400; margin-top: -6px; }
  /* (production's heading widget sits 14px under the text, not 20px) */
</style>
