---
// Numbered steps (article design): Mist cards with an Ocean number circle,
// a title and short text, wrapping in a row.
import type { Block } from '../../content.config';
import { md, mdInline } from '../../lib/md';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';

type Steps = Extract<Block, { type: 'steps' }>;
interface Props {
  block: Steps;
  locale: string;
}
const { block, locale } = Astro.props;
---

<Section>
  <SectionHeader title={block.title} intro={block.intro} locale={locale} />
  <ol class="flex flex-wrap gap-4">
    {
      block.items.map((s, i) => (
        <li class="flex min-w-0 flex-[1_1_220px] flex-col gap-2 rounded-card bg-mist p-6">
          <span class="flex size-11 items-center justify-center rounded-full bg-ocean font-extrabold text-white" aria-hidden="true">{i + 1}</span>
          <h3 class="mt-1 text-[22px] leading-tight" set:html={mdInline(s.title, locale)} />
          <div class="prose text-ink-muted" set:html={md(s.body, locale)} />
        </li>
      ))
    }
  </ol>
</Section>
