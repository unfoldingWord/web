---
// Numbered steps. Production has no step widget (its pages use a plain
// ordered list in the text), so this keeps to production's primitives: plain
// columns, no cards, a 28px Inspire title after a Kindle number.
import type { Block } from '../../content.config';
import { md, mdInline } from '../../lib/md';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';

type Steps = Extract<Block, { type: 'steps' }>;
interface Props {
  block: Steps;
  locale: string;
}
const { block, locale } = Astro.props;
---

<Section>
  <SectionHeader title={block.title} intro={block.intro} locale={locale} />
  <ol class="grid gap-5 md:grid-cols-2 tablet:grid-cols-3">
    {
      block.items.map((s, i) => (
        <li class="flex flex-col gap-5 p-2.5">
          <h3 class="flex items-baseline gap-2.5">
            <span class="text-kindle" aria-hidden="true">{i + 1}.</span>
            <span set:html={mdInline(s.title)} />
          </h3>
          <div class="prose [&>:last-child]:mb-0" set:html={md(s.body, locale)} />
        </li>
      ))
    }
  </ol>
</Section>
