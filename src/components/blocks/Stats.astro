---
// A number band: each figure large, with a plain label under it, in a
// wrapping row. On a portfolio page the band takes the portfolio color;
// otherwise it is Ocean with Inspire numbers (or Mist with Ocean numbers
// when `background` is white or mist). `variant: bars` and each item's
// `color` are older layouts and render the same way; a long text value is
// set smaller so it still fits.
import type { Block } from '../../content.config';
import type { PortfolioKey } from '../../lib/portfolios';
import { mdInline } from '../../lib/md';
import SectionHeader from '../ui/SectionHeader.astro';

type Stats = Extract<Block, { type: 'stats' }>;
interface Props {
  block: Stats;
  locale: string;
  portfolio?: PortfolioKey;
}
const { block, locale, portfolio } = Astro.props;
const ground = portfolio ? `pf-${portfolio} pf-bg` : block.background === 'ocean' ? 'uw-grain on-dark' : 'bg-mist';
const numberColor = portfolio ? '' : block.background === 'ocean' ? 'text-inspire' : 'text-ocean';
const plainText = (s: string) => s.replace(/[*_`]/g, '');
---

<section class:list={[ground, 'py-14']}>
  <div class="container-page">
    <SectionHeader title={block.title} locale={locale} class="!mb-8" />
    <dl class="flex flex-wrap gap-x-12 gap-y-7">
      {
        block.items.map((s) => (
          <div class="flex min-w-0 flex-[1_1_260px] flex-col-reverse justify-end gap-1">
            <dt>{s.label}</dt>
            <dd class:list={[plainText(s.value).length > 14 ? 'font-heading text-h3 font-black' : 'uw-figure', numberColor]} set:html={mdInline(s.value, locale)} />
          </div>
        ))
      }
    </dl>
  </div>
</section>
