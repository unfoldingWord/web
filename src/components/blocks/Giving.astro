---
// The Virtuous giving form, embedded exactly as Virtuous's own snippet does
// it (<script src=".../embed.js" data-rd=… data-organizationId=…>), so the
// form, its payment processing and its receipts are unchanged from the
// WordPress site. Only `formId` differs between giving pages.
//
// Layout: two columns on Mist. Start: the title, text and an optional photo.
// End: the form in a white raised card, with the secure-giving line, the
// tax note and the fallback link under it. On phones the two stack.
//
// `variant: landing` (give/* pages): the title is the page's h1. The
// landing header and footer come from Base.astro (template: giving).
// `partnerLogo` and `tagline` sit above the title (GivingTuesday).
// `contact` adds a white panel with the contact text under both columns,
// inside the same Mist section (no extra full-padding section).
//
// An *em* in the title is its second line: Inspire ink on Mist, not italic.
//
// Analytics: GTM sees the page view and the form's own events, and
// VirtuousListener (shared with the project hero's Donate form) pushes a bare
// `virtuous_message` event when a frame in the form posts a message.
import type { Block } from '../../content.config';
import type { PortfolioKey } from '../../lib/portfolios';
import { SITE } from '../../lib/site';
import { md, mdInline } from '../../lib/md';
import { ui, fmt } from '../../i18n';
import Picture from '../ui/Picture.astro';
import Icon from '../ui/Icon.astro';
import VirtuousListener from '../ui/VirtuousListener.astro';

type Giving = Extract<Block, { type: 'giving' }>;
interface Props {
  block: Giving;
  locale: string;
  portfolio?: PortfolioKey;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const landing = block.variant === 'landing';
const Heading = landing ? 'h1' : 'h2';
const fallbackLink = `<a href="${SITE.givingFallbackUrl}">give.unfoldingword.org</a>`;
---

<section id="give-form" class="giving bg-mist section-y">
  <div class="container-page flex flex-wrap items-start gap-x-16 gap-y-12">
    <div class="flex min-w-0 flex-[999_1_520px] flex-col gap-6">
      {
        (block.partnerLogo || block.tagline) && (
          <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
            {block.partnerLogo && (
              <div class="rounded-small border border-line bg-white px-4 py-2.5">
                <Picture path={block.partnerLogo} alt={block.partnerLogoAlt ?? ''} sizes="180px" widths={[180, 360]} class="!h-10 !w-auto" />
              </div>
            )}
            {block.tagline && <p class="text-[15px] font-semibold text-ink-muted" set:html={mdInline(block.tagline, locale)} />}
          </div>
        )
      }
      {block.title && <Heading class:list={['giving-title', landing ? 'text-h1' : 'text-h2']} set:html={mdInline(block.title)} />}
      {block.body && <div class="giving-body prose" set:html={md(block.body, locale)} />}
      {
        block.image && (
          <div class="overflow-hidden rounded-media">
            <Picture path={block.image} alt={block.imageAlt ?? ''} sizes="(min-width: 84rem) 800px, (min-width: 67rem) calc(100vw - 34rem), 100vw" widths={[520, 800, 1040, 1600]} class="block" />
          </div>
        )
      }
    </div>

    <div class="flex w-full min-w-0 flex-[1_1_420px] flex-col gap-5 rounded-media bg-white p-5 shadow-raised sm:p-9">
      <div class="virtuous-form" data-virtuous-embed data-form-id={block.formId}>
        <p class="virtuous-loading">{t.givingFormLoading}</p>
        <script is:inline src={SITE.virtuousEmbedSrc} data-rd={block.formId} data-organizationId={SITE.virtuousOrgId} data-type="form" defer></script>
        <noscript><p set:html={fmt(t.givingFormFallback, { link: fallbackLink })} /></noscript>
      </div>
      <ul class="giving-trust">
        <li class="flex items-center gap-2.5"><Icon name="lock" class="size-[18px]" />{t.secureGiving}</li>
        <li>{t.taxDeductible}</li>
        <li set:html={fmt(t.givingFormFallback, { link: fallbackLink })} />
      </ul>
    </div>

    {
      block.contact && (
        <div class="flex w-full flex-[1_1_100%] flex-col gap-2 rounded-media bg-white p-6 sm:p-8" role="region" aria-labelledby="giving-contact-title">
          <h2 id="giving-contact-title" class="text-h4">{block.contact.title}</h2>
          <div class="giving-contact-body prose" set:html={md(block.contact.body, locale)} />
        </div>
      )
    }
  </div>
</section>

<style>
  .giving-title { margin: 0; }
  /* The *em* part is the headline's second line (e.g. "Give the Gospel /
     Change lives forever"): its own line, Inspire ink, never italic. Kindle
     only on Ocean grounds. */
  .giving-title :global(em) { display: block; font-style: normal; color: var(--color-inspire-ink); }
  :global(.on-dark) .giving-title :global(em) { color: var(--color-kindle); }
  .giving-title :global(small) { display: block; margin-top: 0.3em; font-size: 0.55em; line-height: 1.2; }
  .giving-body { color: var(--color-ink-muted); font-size: var(--text-lead); line-height: var(--text-lead--line-height); }
  .giving-contact-body { color: var(--color-ink-muted); }

  /* The min-height holds the form's place while it loads. */
  .virtuous-form {
    min-height: 547px;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
  }
  .virtuous-form :global(button) { white-space: nowrap; }
  /* On a domain Virtuous has not registered (previews, local builds) the
     embed draws a 900px-tall "can't be displayed" card instead of the form.
     Let it take the form's place instead, so previews keep the page's real
     proportions. */
  .virtuous-form :global(.invalid-domain-card-bg) {
    min-height: 0 !important;
    height: 100%;
  }
  .virtuous-loading {
    padding-block: 40px;
    text-align: center;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ink-muted);
  }

  .giving-trust {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-ink-muted);
  }
  .giving-trust :global(a) { font-weight: 800; }
</style>

<VirtuousListener />

<script is:inline>
  (function () {
    if (window.__uwGivingLayout) return;
    window.__uwGivingLayout = true;
    // Hide the loading line once Virtuous has inserted its form.
    var obs = new MutationObserver(function () {
      document.querySelectorAll('.virtuous-form').forEach(function (el) {
        if (el.querySelector('[data-rd-state], iframe, form, .raise-donors')) el.querySelector('.virtuous-loading')?.remove();
      });
    });
    obs.observe(document.body, { childList: true, subtree: true });
  })();
</script>
