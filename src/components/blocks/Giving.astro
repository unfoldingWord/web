---
// The Virtuous giving form, embedded exactly as Virtuous's own snippet does
// it (<script src=".../embed.js" data-rd=… data-organizationId=…>), so the
// form, its payment processing and its receipts are unchanged from the
// WordPress site. Only `formId` differs between giving pages.
//
// Layout (production's Elementor giving row): two 490px columns with 10px
// padding and a 20px gap inside the 1000px box. Start column: a 40px Tech
// title whose *emphasis* is Kindle, the text, a photo with 4px corners.
// End column: the Virtuous form, which draws its own white card and shadow,
// so there is no wrapper card here. Under the photo (under the form on
// phones) sits our quiet trust list and fallback link.
//
// `variant: landing` (give/* pages): the title is the page's h1, the copy is
// centered on phones and the photo hidden there (as production), and an
// Ocean "Contact Us With Questions" band follows. The landing header and
// footer come from Base.astro (template: giving).
//
// Analytics: GTM sees the page view and the form's own events, and
// VirtuousListener (shared with the project hero's Donate form) pushes a bare
// `virtuous_message` event when a frame in the form posts a message.
import type { Block } from '../../content.config';
import { SITE } from '../../lib/site';
import { md, mdInline } from '../../lib/md';
import { ui, fmt } from '../../i18n';
import Picture from '../ui/Picture.astro';
import Icon from '../ui/Icon.astro';
import VirtuousListener from '../ui/VirtuousListener.astro';

type Giving = Extract<Block, { type: 'giving' }>;
interface Props {
  block: Giving;
  locale: string;
}
const { block, locale } = Astro.props;
const t = ui(locale);
const landing = block.variant === 'landing';
const compact = block.textStyle === 'compact';
const Heading = landing ? 'h1' : 'h2';
const fallbackLink = `<a href="${SITE.givingFallbackUrl}">give.unfoldingword.org</a>`;
---

<section id="give-form" class:list={['giving', landing && 'giving-landing']}>
  <div class="giving-row">
    <div class="giving-copy">
      {block.eyebrow && !landing && <p class="eyebrow">{block.eyebrow}</p>}
      {block.title && <Heading class="giving-title" set:html={mdInline(block.title)} />}
      {block.body && <div class:list={['giving-body', compact ? 'giving-body-compact' : 'prose']} set:html={md(block.body, locale)} />}
      {
        block.image && (
          <div class="giving-image">
            <Picture path={block.image} alt={block.imageAlt ?? ''} sizes="(min-width: 48rem) 470px, 100vw" widths={[470, 940, 1410]} />
          </div>
        )
      }
    </div>

    <div class="giving-form">
      <div class="virtuous-form" data-virtuous-embed data-form-id={block.formId}>
        <p class="virtuous-loading">{t.givingFormLoading}</p>
        <script is:inline src={SITE.virtuousEmbedSrc} data-rd={block.formId} data-organizationId={SITE.virtuousOrgId} data-type="form" defer></script>
        <noscript><p set:html={fmt(t.givingFormFallback, { link: fallbackLink })} /></noscript>
      </div>
    </div>

    <ul class="giving-trust">
      <li><Icon name="lock" class="giving-trust-icon" />{t.secureGiving}</li>
      <li><Icon name="check" class="giving-trust-icon" />{t.taxDeductible}</li>
      <li set:html={fmt(t.givingFormFallback, { link: fallbackLink })} />
    </ul>
  </div>
</section>

{
  landing && block.contact && (
    <section class="giving-contact bg-ocean on-dark" aria-labelledby="giving-contact-title">
      <h2 id="giving-contact-title">{block.contact.title}</h2>
      <div class="giving-contact-body" set:html={md(block.contact.body, locale)} />
    </section>
  )
}

<style>
  /* Production values (spec/components.md §14, give-1440.json). */
  .giving {
    background: var(--color-paper);
    padding: 40px var(--spacing-gutter);
  }
  .giving-row {
    max-width: 1000px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'copy' 'form' 'trust';
    row-gap: 10px;
  }
  .giving-copy,
  .giving-form,
  .giving-trust {
    min-width: 0;
    padding: 10px;
  }
  /* A flex stack with 20px gaps, like Elementor's: a paragraph's 14.4px
     bottom margin adds to the gap instead of collapsing into it. */
  .giving-copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  /* Production's form column has no padding on phones (the form spans the
     full 310px there), 10px from 768px up. */
  .giving-form { grid-area: form; padding: 0; margin-block-start: 10px; }
  .giving-trust { grid-area: trust; }

  .giving-title {
    font-size: var(--text-h1);
    line-height: 1;
    font-weight: 700;
    color: var(--color-tech);
    margin: 0;
    text-wrap: wrap;
  }
  .giving-title :global(em) {
    font-style: normal;
    color: var(--color-kindle);
  }
  /* Benin's second line: 26pt. */
  .giving-title :global(small) {
    font-size: 26pt;
  }
  /* Production's text-editor lists are weight 400 and end flush. */
  .giving-body :global(li) { font-weight: 400; }
  .giving-body :global(:is(ul, ol)) { margin-bottom: 0; }
  /* The Elementor paragraph widget: theme system font, 16/24. */
  .giving-body-compact {
    font-family: var(--font-system);
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 400;
    color: var(--color-tech);
  }
  .giving-body-compact :global(p) { margin: 0 0 1em; }
  .giving-body-compact > :global(:last-child) { margin-bottom: 0; }
  .giving-image :global(img) {
    display: block;
    border-radius: var(--radius-media-split);
  }

  /* No wrapper card: Virtuous draws its own. The min-height holds the
     form's place while it loads. */
  .virtuous-form {
    min-height: 547px;
    /* The form inherits from its page: give it production's theme defaults
       (weight 400, buttons that never wrap) rather than our 300 body. */
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
  }
  .virtuous-form :global(button) {
    white-space: nowrap;
  }
  /* On a domain Virtuous has not registered (previews, local builds) the
     embed draws a 900px-tall "can't be displayed" card instead of the form.
     Let it take the form's place instead, so previews keep the page's real
     proportions. */
  .virtuous-form :global(.invalid-domain-card-bg) {
    min-height: 0 !important;
    height: 100%;
  }
  .virtuous-loading {
    padding-block: 40px;
    text-align: center;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ink-muted);
  }

  /* Our extra (decision 2): a quiet trust list and fallback link. */
  .giving-trust {
    margin: 0;
    list-style: none;
    font-size: 14px;
    line-height: 20px;
    font-weight: 300;
    color: var(--color-ink-muted);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .giving-trust :global(.giving-trust-icon) {
    display: inline-block;
    width: 14px;
    height: 14px;
    margin-inline-end: 6px;
    vertical-align: -2px;
    color: var(--color-inspire);
  }
  .giving-trust :global(a) { font-weight: 700; }

  /* On phones: no photo (production hides it, on the home page as on the
     landing pages), a centered title, and on landing pages centered text. */
  @media (max-width: 767px) {
    .giving-landing {
      padding-block-end: 30px;
    }
    .giving-title,
    .giving-landing .giving-copy {
      text-align: center;
    }
    .giving-image {
      display: none;
    }
    .giving-trust {
      text-align: center;
    }
  }

  @media (min-width: 768px) {
    .giving-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto 1fr;
      grid-template-areas: 'copy form' 'trust form';
      column-gap: 20px;
      row-gap: 0;
    }
    .giving-form {
      padding: 10px;
      margin-block-start: 0;
    }
    /* Content height, not stretched: the trust-list script measures them. */
    .giving-copy,
    .giving-form {
      align-self: start;
    }
    .giving-row[data-trust-under-form] {
      grid-template-areas: 'copy form' 'copy trust';
    }
    .giving-trust {
      align-self: start;
      padding-block: 0;
    }
    .virtuous-form {
      min-height: 597px;
    }
  }

  /* Ocean "Contact Us With Questions" band: 800px, 40px padding, 20px gap. */
  .giving-contact {
    padding: 40px;
    text-align: center;
  }
  .giving-contact h2 {
    max-width: 800px;
    margin: 0 auto 20px;
    font-size: var(--text-h2);
    line-height: 1;
    font-weight: 700;
    color: #fff;
    text-wrap: wrap;
  }
  .giving-contact-body {
    max-width: 800px;
    margin-inline: auto;
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    font-weight: 300;
    color: #fff;
  }
  .giving-contact-body :global(p) { margin: 0 0 14.4px; }
  /* Production's band text has no links; ours (the e-mail address) keep
     the text's look and underline on hover. */
  .giving-contact-body :global(a) { color: inherit; font-weight: inherit; }
  .giving-contact-body :global(a:hover) { color: inherit; text-decoration: underline; }
  .giving-contact-body :global(strong) { font-weight: 300; }
</style>

<VirtuousListener />

<script is:inline>
  (function () {
    if (window.__uwGivingLayout) return;
    window.__uwGivingLayout = true;
    // Hide the loading line once Virtuous has inserted its form.
    var obs = new MutationObserver(function () {
      document.querySelectorAll('.virtuous-form').forEach(function (el) {
        if (el.querySelector('[data-rd-state], iframe, form, .raise-donors')) el.querySelector('.virtuous-loading')?.remove();
      });
    });
    obs.observe(document.body, { childList: true, subtree: true });
    // Two columns: put our trust list under whichever column is shorter
    // (the copy or the form, whose height Virtuous decides), so it does not
    // make the row taller than production's.
    if (!('ResizeObserver' in window)) return;
    var wide = window.matchMedia('(min-width: 768px)');
    document.querySelectorAll('.giving-row').forEach(function (row) {
      var copy = row.querySelector('.giving-copy');
      var form = row.querySelector('.giving-form');
      var trust = row.querySelector('.giving-trust');
      if (!copy || !form || !trust) return;
      var place = function () {
        if (!wide.matches) return row.removeAttribute('data-trust-under-form');
        var c = copy.offsetHeight, f = form.offsetHeight, t = trust.offsetHeight;
        row.toggleAttribute('data-trust-under-form', Math.max(c, f + t) < Math.max(c + t, f));
      };
      new ResizeObserver(place).observe(copy);
      new ResizeObserver(place).observe(form);
      wide.addEventListener('change', place);
    });
  })();
</script>
