---
// Page-opening block (docs/design-system/designs). Variants:
//   home      — Ocean grain panel: the brand mark behind a person cut out
//               from their photo (`cutout`), the Inspire headline beside it.
//   portfolio — the page's portfolio color as the panel, photo beside.
//   photo, project, ocean, feature — Deep Ocean grain panel, text beside a
//               full-bleed photo (`angles` adds the angled color layers).
//               `project`: the title is the big place name (the h1) and the
//               first lead paragraph a PT Serif line under it (an older
//               `eyebrow`, if set, is still taken as the place name).
//               `feature` is not the page's first block: its title is an h2
//               and its `lead` is Markdown.
//   split, light — Mist panel, text beside a rounded photo, with an
//               optional quote card over the photo.
//   banner, heading — Mist title band (the default for pages without a
//               hero), photo beside when there is one; a very wide photo
//               (an old strip banner, wider than 2.2:1) runs as a short
//               full-width strip under the title instead of being cropped.
// `uppercase`, `divider` and `contentPosition` (except the photo side of
// `project`) are cosmetic leftovers and are ignored; `lines` and `subtitle`
// show as lead text.
import type { Block } from '../../content.config';
import type { PortfolioKey } from '../../lib/portfolios';
import { portfolio as portfolioOf } from '../../lib/portfolios';
import { md, mdInline } from '../../lib/md';
import { ui } from '../../i18n';
import Picture from '../ui/Picture.astro';
import Actions from '../ui/Actions.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import VirtuousListener from '../ui/VirtuousListener.astro';
import { SITE } from '../../lib/site';
import { img } from '../../lib/images';

type Hero = Extract<Block, { type: 'hero' }>;
interface Props {
  block: Hero;
  locale: string;
  crumbs?: { name: string; href?: string }[];
  portfolio?: PortfolioKey;
}
const { block, locale, crumbs, portfolio } = Astro.props;
const { variant, title, lead, image, imageAlt, actions } = block;
const t = ui(locale);

const kind =
  variant === 'home' ? 'home'
  : variant === 'portfolio' ? 'portfolio'
  : variant === 'split' || variant === 'light' ? 'split'
  : variant === 'banner' || variant === 'heading' ? 'banner'
  : 'deep';

const pfClass = portfolio ? `pf-${portfolio}` : undefined;
const pfName = portfolio ? (t.nav as Record<string, string>)[portfolioOf(portfolio).navKey] : undefined;

// Lead paragraphs: `lead`, then any extra title lines and the subtitle, so
// no copy from older content disappears.
const leads = [...(lead && variant !== 'feature' ? lead.split(/\n\s*\n/) : []), ...(block.lines ?? []), ...(block.subtitle ? [block.subtitle] : [])];

// Project pages: the place name is the h1, a PT Serif line under it.
// Today the title is the place and the first lead the line; an older
// `eyebrow` is still read as the place, with the title as the line.
const isProject = variant === 'project';
const place = isProject ? (block.eyebrow ?? title) : undefined;
const serifLine = isProject ? (block.eyebrow ? title : leads[0]) : undefined;
const restLeads = isProject && !block.eyebrow ? leads.slice(1) : leads;

// Banner: an old wide strip banner (about 7:1) would be cropped to a near
// square in the side card; it runs as a full-width strip instead.
const meta = kind === 'banner' && image ? img(image) : undefined;
const wideBanner = !!meta && meta.width / meta.height > 2.2;
const HeadTag = variant === 'feature' ? 'h2' : 'h1';
const photoFirst = variant === 'project' && block.contentPosition === 'end';
const objectPos = block.imagePosition === 'top' ? 'object-top' : block.imagePosition === 'bottom' ? 'object-bottom' : undefined;
const textHalf = 'flex min-w-0 flex-[1_1_520px] flex-col justify-center px-[var(--spacing-gutter)] py-14 md:px-[clamp(32px,5vw,88px)] md:py-[72px]';
---

{
  kind === 'home' ? (
    <section class="uw-grain on-dark flex flex-wrap overflow-hidden">
      <div class="relative h-[420px] min-w-0 flex-[1_1_520px] overflow-hidden md:h-[680px]">
        <div class="hero-light uw-grain-light absolute inset-0" aria-hidden="true" />
        {/* The mark stands behind the person, never over a face. */}
        <img src="/brand/mark-512.png" alt="" aria-hidden="true" width="512" height="512" class="absolute start-[-30px] bottom-[-70px] h-[440px] w-auto max-w-none md:start-[-40px] md:bottom-[-110px] md:h-[700px]" />
        {block.cutout && (
          <Picture path={block.cutout} alt={block.cutoutAlt ?? ''} eager bare sizes="(min-width: 48rem) 400px, 260px" widths={[260, 400, 520, 800]} class="absolute start-[90px] bottom-0 h-[300px] w-auto max-w-none md:start-[150px] md:h-[470px]" />
        )}
      </div>
      <div class:list={[textHalf, 'gap-[26px] md:ps-[clamp(32px,3vw,48px)]']}>
        <h1 class="headline-inspire text-[clamp(38px,4.3vw,62px)] leading-[1.08]" set:html={mdInline(title, locale)} />
        {leads.map((p) => <p class="lead max-w-[560px]" set:html={mdInline(p, locale)} />)}
        <Actions actions={actions} locale={locale} class="gap-3" />
      </div>
    </section>
  ) : kind === 'portfolio' ? (
    <section class:list={['flex flex-wrap', pfClass ? [pfClass, 'pf-bg'] : 'uw-grain-deep on-dark']}>
      <div class:list={[textHalf, 'gap-6']}>
        {crumbs && <Breadcrumbs items={crumbs} locale={locale} onDark={!pfClass} inherit={!!pfClass} />}
        <h1 class="text-[clamp(42px,5.4vw,78px)] leading-[1.02]" set:html={mdInline(title, locale)} />
        {leads.map((p) => <p class:list={['max-w-[540px] text-[21px] leading-normal', !pfClass && 'lead']} set:html={mdInline(p, locale)} />)}
        <Actions actions={actions} locale={locale} class="gap-3" />
      </div>
      {image && (
        <div class="relative h-[360px] min-w-0 flex-[1_1_520px] md:h-[600px]">
          <Picture path={image} alt={imageAlt ?? ''} eager fill sizes="(min-width: 65rem) 50vw, 100vw" class:list={['absolute inset-0', objectPos]} />
        </div>
      )}
    </section>
  ) : kind === 'split' ? (
    <section class="bg-mist">
      <div class="container-page flex flex-wrap items-center gap-x-16 gap-y-10 pt-12 pb-14 md:pt-[72px] md:pb-[88px]">
        <div class="flex min-w-0 flex-[1_1_460px] flex-col gap-[22px]">
          {crumbs && <Breadcrumbs items={crumbs} locale={locale} />}
          {pfName && <div><span class:list={['pf-chip', pfClass]}>{pfName}</span></div>}
          <h1 class="text-[clamp(36px,4.4vw,62px)] leading-[1.04]" set:html={mdInline(title, locale)} />
          {leads.map((p) => <p class="lead max-w-[540px]" set:html={mdInline(p, locale)} />)}
          {block.chips && block.chips.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {block.chips.map((c) => <li class="chip chip-outline">{c}</li>)}
            </ul>
          )}
          <Actions actions={actions} locale={locale} class="gap-3" />
        </div>
        {image && (
          <div class="relative min-w-0 flex-[1_1_520px]">
            <div class="relative h-[320px] overflow-hidden rounded-media md:h-[520px]">
              <Picture path={image} alt={imageAlt ?? ''} eager fill sizes="(min-width: 65rem) 50vw, 100vw" class:list={['absolute inset-0', objectPos]} />
            </div>
            {block.quote && (
              <figure class="absolute inset-x-5 bottom-5 rounded-small bg-white px-5 py-4">
                <blockquote class="font-serif text-[19px] leading-[1.35] text-ocean" set:html={mdInline(block.quote.text, locale)} />
                {(block.quote.name || block.quote.place) && (
                  <figcaption class="mt-2 text-[15px] text-ink-muted">
                    {block.quote.name && <strong class="font-extrabold text-ink">{block.quote.name}</strong>}
                    {block.quote.name && block.quote.place && ' · '}
                    {block.quote.place}
                  </figcaption>
                )}
              </figure>
            )}
          </div>
        )}
      </div>
    </section>
  ) : kind === 'banner' ? (
    <section class="bg-mist">
      <div class="container-page flex flex-wrap items-center gap-x-16 gap-y-10 pt-10 pb-12 md:pt-16 md:pb-[72px]">
        <div class="flex min-w-0 flex-[999_1_520px] flex-col gap-[18px]">
          {crumbs && <Breadcrumbs items={crumbs} locale={locale} />}
          <h1 class="max-w-[900px] text-[clamp(36px,4.4vw,62px)] leading-[1.04]" set:html={mdInline(title, locale)} />
          {leads.map((p) => <p class="lead max-w-[760px] md:text-[21px]" set:html={mdInline(p, locale)} />)}
          <Actions actions={actions} locale={locale} class="gap-3" />
        </div>
        {image && (wideBanner ? (
          <div class="relative h-[140px] w-full min-w-0 basis-full overflow-hidden rounded-media md:h-[220px]">
            <Picture path={image} alt={imageAlt ?? ''} eager fill sizes="(min-width: 80rem) 1280px, 100vw" class:list={['absolute inset-0', objectPos]} />
          </div>
        ) : (
          <div class="relative h-[260px] min-w-0 flex-[1_1_400px] overflow-hidden rounded-media md:h-[340px]">
            <Picture path={image} alt={imageAlt ?? ''} eager fill sizes="(min-width: 65rem) 40vw, 100vw" class:list={['absolute inset-0', objectPos]} />
          </div>
        ))}
      </div>
    </section>
  ) : (
    <section class:list={['uw-grain-deep on-dark flex flex-wrap overflow-hidden', variant === 'feature' && 'mt-[var(--spacing-section)]']}>
      <div class:list={[image ? textHalf : 'container-page flex flex-col py-14 md:py-[88px]', 'gap-[22px]']}>
        {crumbs && <Breadcrumbs items={crumbs} locale={locale} onDark />}
        {pfName && <div><span class:list={['pf-chip', pfClass]}>{pfName}</span></div>}
        {place ? (
          <>
            <h1 class="text-[clamp(56px,8vw,120px)] leading-[0.95] tracking-[-0.02em]" set:html={mdInline(place, locale)} />
            {serifLine && <p class="max-w-[560px] font-serif text-[clamp(22px,2.2vw,30px)] leading-[1.3] text-white" set:html={mdInline(serifLine, locale)} />}
          </>
        ) : (
          <HeadTag class="max-w-[900px] text-[clamp(36px,4.2vw,58px)] leading-[1.06]" set:html={mdInline(title, locale)} />
        )}
        {variant === 'feature' && lead && <div class="prose max-w-[600px]" set:html={md(lead, locale)} />}
        {restLeads.map((p) => <p class="lead max-w-[560px]" set:html={mdInline(p, locale)} />)}
        {block.donateFormId ? (
          <div id="give-form" class="uw-project-donate">
            <Actions actions={actions} locale={locale} class="uw-donate-fallback gap-3" />
            <div class="uw-virtuous-donate" data-virtuous-embed data-form-id={block.donateFormId}>
              <script is:inline src={SITE.virtuousEmbedSrc} data-rd={block.donateFormId} data-organizationId={SITE.virtuousOrgId} data-type="form" defer></script>
            </div>
            <VirtuousListener />
          </div>
        ) : (
          <Actions actions={actions} locale={locale} class="gap-3" />
        )}
      </div>
      {image && (
        <div class:list={['relative h-[340px] min-w-0 flex-[1_1_520px] overflow-hidden', variant === 'ocean' ? 'md:h-[520px]' : 'md:h-[600px]', photoFirst && 'min-[65rem]:order-first']}>
          <Picture path={image} alt={imageAlt ?? ''} eager={variant !== 'feature'} fill sizes="(min-width: 65rem) 50vw, 100vw" class:list={['absolute inset-0', objectPos]} />
          {block.angles && <div class="uw-angles" style="--angle-color: var(--pf, var(--color-cultivate))" aria-hidden="true" />}
        </div>
      )}
    </section>
  )
}

<style>
  /* Home: the light angled layer behind the mark. */
  .hero-light { clip-path: polygon(0 0, 24% 0, 100% 100%, 0 100%); }
  :global([dir='rtl']) .hero-light { transform: scaleX(-1); }

  /* Project `donateFormId`: Virtuous draws its own "Donate Now" button (it
     opens the form in a modal). Until that button is there, and wherever the
     form cannot load (unregistered preview domains, no script), our own
     button stays and Virtuous's output stays hidden. */
  .uw-virtuous-donate { display: none; }
  .uw-project-donate.is-ready .uw-virtuous-donate { display: block; }
  .uw-project-donate.is-ready :global(.uw-donate-fallback) { display: none; }
</style>

<script is:inline>
  (function () {
    var slots = document.querySelectorAll('.uw-virtuous-donate');
    if (!slots.length) return;
    var check = function () {
      slots.forEach(function (el) {
        if (el.querySelector('.rd-btn')) el.parentElement.classList.add('is-ready');
      });
    };
    new MutationObserver(check).observe(document.body, { childList: true, subtree: true });
    check();
  })();
</script>
