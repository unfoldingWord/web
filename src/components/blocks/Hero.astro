---
// Page-opening block. Variants:
//   banner  — production's page-title band: full-bleed photo under a flat
//             50% Ocean overlay, centered white 32px title (uppercase unless
//             `uppercase: false`), optional extra lines, Kindle divider and
//             subtitle. 200px tall. The opener for standard pages.
//   project — photo band with a 50% Ocean overlay and a text column on one
//             half: country name, Kindle heading, text, buttons (wbwn pages)
//   ocean   — deep-blue band (giving pages)
//   photo   — full-bleed photo with an Ocean overlay (giving pages, home)
//   split   — text beside a photo
//   light   — quiet tinted band
//   heading — no band: a centered 40px/500 title and a line of text
import type { Block } from '../../content.config';
import { mdInline } from '../../lib/md';
import Picture from '../ui/Picture.astro';
import Actions from '../ui/Actions.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';

type Hero = Extract<Block, { type: 'hero' }>;
interface Props {
  block: Hero;
  locale: string;
  crumbs?: { name: string; href?: string }[];
}
const { block, locale, crumbs } = Astro.props;
const { variant, eyebrow, title, lead, image, imageAlt, actions } = block;
const dark = variant === 'ocean' || (variant === 'photo' && !!image);
const lines = [title, ...(block.lines ?? [])];
---

{
  variant === 'banner' ? (
    <section class:list={['uw-banner on-dark relative isolate flex min-h-[200px] items-center justify-center overflow-hidden px-10 py-10 text-center', !image && 'uw-banner-plain']}>
      {image && (
        <div class="absolute inset-0 -z-20">
          <Picture path={image} alt={imageAlt ?? ''} eager sizes="100vw" fill class="h-full w-full object-cover" />
        </div>
      )}
      <div class="absolute inset-0 -z-10 bg-ocean/50" aria-hidden="true" />
      {crumbs && (
        <div class="uw-banner-crumbs absolute inset-x-0 top-2.5">
          <div class="container-page text-start"><Breadcrumbs items={crumbs} locale={locale} onDark /></div>
        </div>
      )}
      <div class="mx-auto flex w-full max-w-[1000px] flex-col items-center gap-2.5">
        <h1 class:list={['uw-banner-title flex flex-col items-center', block.divider && 'gap-2.5', block.uppercase !== false && 'uppercase']}>
          {lines.map((line, i) => (
            <>
              {i > 0 && block.divider && <span class="block py-[2px]" aria-hidden="true"><span class="block h-[3px] w-[50px] bg-kindle" /></span>}
              {i > 0 && <span class="sr-only">. </span>}
              <span class="block" set:html={mdInline(line)} />
            </>
          ))}
        </h1>
        {block.subtitle && <p class="text-h3 font-normal text-white" set:html={mdInline(block.subtitle, locale)} />}
      </div>
    </section>
  ) : variant === 'heading' ? (
    <section class="px-10 pt-[175px] pb-2.5 text-center">
      <div class="mx-auto flex max-w-[1360px] flex-col items-center gap-5">
        {crumbs && <Breadcrumbs items={crumbs} locale={locale} />}
        <h1 class="text-[40px] leading-[48px] font-medium text-tech" set:html={mdInline(title)} />
        {lead && <p class="text-base font-normal text-tech" set:html={mdInline(lead, locale)} />}
      </div>
    </section>
  ) : variant === 'project' ? (
    <section class="uw-banner on-dark relative isolate overflow-hidden px-10 py-10">
      {image && (
        <div class="absolute inset-0 -z-20">
          <Picture path={image} alt={imageAlt ?? ''} eager sizes="100vw" fill class="h-full w-full object-cover" />
        </div>
      )}
      <div class="absolute inset-0 -z-10 bg-ocean/50" aria-hidden="true" />
      {crumbs && (
        <div class="uw-banner-crumbs absolute inset-x-0 top-2.5">
          <div class="container-page text-start"><Breadcrumbs items={crumbs} locale={locale} onDark /></div>
        </div>
      )}
      <div class="mx-auto flex min-h-[220px] w-full max-w-[1000px] flex-wrap items-center gap-5">
        <div class:list={['flex w-full flex-col gap-5 p-2.5 md:w-[calc(50%-10px)]', block.contentPosition === 'end' && 'md:ms-auto']}>
          {eyebrow && <p class="text-h2 font-bold uppercase text-white">{eyebrow}</p>}
          <h1 class="text-h2 !text-kindle [text-wrap:wrap]" set:html={mdInline(title)} />
          {lead && <p class="text-body text-white" set:html={mdInline(lead, locale)} />}
          <Actions actions={actions} locale={locale} class="uw-donate" />
        </div>
      </div>
    </section>
  ) : variant === 'split' ? (
    <section class="bg-mist">
      <div class="container-page grid items-center gap-8 py-10 md:grid-cols-2 lg:gap-14 lg:py-16">
        <div>
          {crumbs && <div class="mb-5"><Breadcrumbs items={crumbs} locale={locale} /></div>}
          {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
          <h1 class="text-display" set:html={mdInline(title)} />
          {lead && <p class="mt-5 text-lead text-ink-muted" set:html={mdInline(lead, locale)} />}
          <Actions actions={actions} locale={locale} class="mt-8" />
        </div>
        {image && (
          <div class="overflow-hidden rounded-card shadow-raised">
            <Picture path={image} alt={imageAlt ?? ''} eager sizes="(min-width: 48rem) 50vw, 100vw" aspect="4 / 3" />
          </div>
        )}
      </div>
    </section>
  ) : (
    <section class:list={['relative isolate overflow-hidden', dark ? 'on-dark bg-ocean angle-bottom' : 'bg-mist']}>
      {variant === 'photo' && image && (
        <>
          <div class="absolute inset-0 -z-20">
            <Picture path={image} alt={imageAlt ?? ''} eager sizes="100vw" fill class="h-full w-full object-cover" />
          </div>
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ocean-900/90 via-ocean/75 to-ocean/55" />
        </>
      )}
      {variant === 'ocean' && (
        <div class="pointer-events-none absolute -end-24 -top-24 -z-10 size-[28rem] rounded-full bg-inspire/20 blur-3xl" aria-hidden="true" />
      )}
      <div class:list={['container-page', variant === 'light' ? 'py-10 lg:py-14' : variant === 'photo' ? 'pt-28 pb-12 lg:pt-44 lg:pb-16' : 'pt-12 pb-6 lg:pt-20 lg:pb-10']}>
        {crumbs && <div class="mb-6"><Breadcrumbs items={crumbs} locale={locale} onDark={dark} /></div>}
        <div class="max-w-3xl">
          {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
          <h1 class:list={[variant === 'light' ? 'text-h1' : 'text-display']} set:html={mdInline(title)} />
          {lead && <p class:list={['mt-5 text-lead', dark ? 'text-white/90' : 'text-ink-muted']} set:html={mdInline(lead, locale)} />}
          <Actions actions={actions} locale={locale} class="mt-8" />
        </div>
      </div>
    </section>
  )
}

<style>
  /* A Donate button in the project band is production's Virtuous button. */
  :global(.uw-donate .uw-btn-give) { height: 56px; padding: 12px 16px; font-family: Arial, 'Helvetica Neue', Helvetica, var(--font-sans); font-size: 14px; line-height: 16.8px; font-weight: 600; }
  /* Production: h2 32/32/700 white, centered. Ours stays an h1. */
  .uw-banner-title { font-size: var(--text-h2); line-height: 1; font-weight: 700; color: #fff; margin: 0; text-wrap: wrap; }
  /* No photo: production's band shows the overlay over white. */
  .uw-banner-plain { background-color: #fff; }
  /* Breadcrumbs sit in the band's top padding so the title stays centered;
     on phones there is no room, so they hide (the JSON-LD trail remains). */
  @media (max-width: 767px) { .uw-banner-crumbs { display: none; } }
</style>
