---
import type { Block } from '../../content.config';
import { mdInline } from '../../lib/md';
import Section from '../ui/Section.astro';
import Picture from '../ui/Picture.astro';

type Quote = Extract<Block, { type: 'quote' }>;
interface Props {
  block: Quote;
  locale: string;
}
const { block } = Astro.props;
---

<Section background="mist">
  <figure class="mx-auto grid max-w-4xl items-center gap-8 md:grid-cols-[auto_1fr]">
    {
      block.image && (
        <div class="mx-auto size-32 overflow-hidden rounded-full shadow-card md:size-40">
          <Picture path={block.image} alt={block.imageAlt ?? ''} sizes="160px" widths={[160, 320]} aspect="1 / 1" />
        </div>
      )
    }
    <div>
      <svg viewBox="0 0 40 30" class="mb-4 h-8 w-10 text-inspire" aria-hidden="true"><path fill="currentColor" d="M0 30V17Q0 6 11 0l3 4q-6 4-6 11h7v15zm22 0V17q0-11 11-17l3 4q-6 4-6 11h7v15z" /></svg>
      <blockquote class="font-serif text-[clamp(1.25rem,1.05rem+0.9vw,1.75rem)] leading-snug text-ocean">
        <p set:html={mdInline(block.quote)} />
      </blockquote>
      {
        block.attribution && (
          <figcaption class="mt-5 text-ink-muted">
            <span class="font-heading font-extrabold text-ink">{block.attribution}</span>
            {block.role && <span>, {block.role}</span>}
          </figcaption>
        )
      }
    </div>
  </figure>
</Section>
