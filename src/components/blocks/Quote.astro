---
// A leader's words (home "leader" design): a round portrait beside the
// quote in PT Serif, then "Name · role", on white (as Portfolio.dc.html;
// white keeps it from running into the Mist card grids it often follows).
import type { Block } from '../../content.config';
import { mdInline } from '../../lib/md';
import Picture from '../ui/Picture.astro';

type Quote = Extract<Block, { type: 'quote' }>;
interface Props {
  block: Quote;
  locale: string;
}
const { block, locale } = Astro.props;
---

<section class="section-y bg-white">
  <div class="container-page">
    <div class="mx-auto flex max-w-[1000px] flex-wrap items-center gap-x-14 gap-y-8">
      {
        block.image && (
          <div class="size-[200px] shrink-0 overflow-hidden rounded-full">
            <Picture path={block.image} alt={block.imageAlt ?? ''} sizes="200px" widths={[200, 400]} aspect="1 / 1" />
          </div>
        )
      }
      <figure class="flex min-w-0 flex-[1_1_440px] flex-col gap-[18px]">
        <blockquote class="uw-quote" set:html={mdInline(block.quote, locale)} />
        {
          block.attribution && (
            <figcaption class="text-ink-muted">
              <strong class="font-extrabold text-ink">{block.attribution}</strong>
              {block.role && <> · {block.role}</>}
            </figcaption>
          )
        }
      </figure>
    </div>
  </div>
</section>
