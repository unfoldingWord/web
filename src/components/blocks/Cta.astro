---
// A call to action.
//   ocean, split — the give band: Ocean grain panel, h2, text and buttons,
//                  photo beside when there is an `image`
//   kindle — a Kindle rounded panel with Ocean buttons
//   mist   — a Mist rounded panel: heading and line beside the buttons
//   legacy — an older page opener, shown as a compact, centered Mist text
//            band (h2, line, buttons). Its photo is not shown: these follow
//            the page's own title band, which already carries the same photo.
// `id` is the section's anchor for in-page links (/innovation/#give).
import type { Block } from '../../content.config';
import { md, mdInline } from '../../lib/md';
import Actions from '../ui/Actions.astro';
import Picture from '../ui/Picture.astro';

type Cta = Extract<Block, { type: 'cta' }>;
interface Props {
  block: Cta;
  locale: string;
}
const { block, locale } = Astro.props;
const id = (block as Cta & { id?: string }).id;
---

{
  block.variant === 'legacy' ? (
    <section id={id} class="bg-mist">
      <div class="container-page flex flex-col items-center gap-[18px] py-12 text-center md:py-14">
        <h2 class="max-w-[900px]" set:html={mdInline(block.title, locale)} />
        {block.body && <p class="lead max-w-[760px]" set:html={mdInline(block.body, locale)} />}
        <Actions actions={block.actions} locale={locale} class="justify-center gap-3" />
      </div>
    </section>
  ) : block.variant === 'kindle' || block.variant === 'mist' ? (
    <section id={id} class="section-y bg-white">
      <div class="container-page">
        <div class:list={['flex flex-wrap items-center justify-between gap-x-12 gap-y-5 rounded-media', block.variant === 'kindle' ? 'pf-equipping pf-bg px-[clamp(26px,3vw,44px)] py-8' : 'bg-mist p-8']}>
          <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-1.5">
            <h2 class:list={[block.variant === 'kindle' ? 'text-[clamp(28px,2.6vw,34px)] leading-[1.1]' : 'text-h4']} set:html={mdInline(block.title, locale)} />
            {block.body && <div class:list={['[&_p+p]:mt-2', block.variant === 'kindle' ? 'text-[19px]' : 'text-ink-muted']} set:html={md(block.body, locale)} />}
          </div>
          <Actions actions={block.actions} locale={locale} class="gap-3" />
        </div>
      </div>
    </section>
  ) : (
    <section id={id} class="uw-grain on-dark flex flex-wrap">
      <div class:list={['flex min-w-0 flex-col justify-center gap-[22px] py-16 md:py-[88px]', block.image ? 'flex-[1_1_520px] px-[var(--spacing-gutter)] md:px-[clamp(32px,5vw,88px)]' : 'container-page']}>
        <h2 class="max-w-[900px] text-[clamp(32px,3.8vw,54px)] leading-[1.06]" set:html={mdInline(block.title, locale)} />
        {block.body && <div class="max-w-[600px] text-lead text-inspire-100 [&_p+p]:mt-3 [&_a]:text-cultivate" set:html={md(block.body, locale)} />}
        <Actions actions={block.actions} locale={locale} class="gap-3" />
      </div>
      {block.image && (
        <div class="relative min-h-[340px] min-w-0 flex-[1_1_520px] md:min-h-[560px]">
          <Picture path={block.image} alt={block.imageAlt ?? ''} fill sizes="(min-width: 65rem) 50vw, 100vw" class="absolute inset-0" />
        </div>
      )}
    </section>
  )
}
