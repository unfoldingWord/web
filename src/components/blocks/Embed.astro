---
// A third-party embed in an iframe (flip-book, map, form). Use sparingly:
// every embed is a request to another site on page load. Square corners and
// no frame, like production's embeds.
import type { Block } from '../../content.config';
import Section from '../ui/Section.astro';

type Embed = Extract<Block, { type: 'embed' }>;
interface Props {
  block: Embed;
  locale: string;
}
const { block } = Astro.props;
---

<Section>
  <iframe src={block.src} title={block.title} loading="lazy" class="block w-full border-0" style={`aspect-ratio:${block.aspect}`} allowfullscreen></iframe>
</Section>
