---
// Virtuous CRM sign-up form (newsletter, prayer calendar). Not a giving form
// — giving uses the Giving block (data-rd).
//
// Rendered in an iframe served from the media bucket's origin
// (embeds/virtuous-signup.html): Virtuous's virtuous.embed.min.js injects an
// unlayered normalize.css into the top page — even from a same-origin frame —
// which overrides this site's styles (button backgrounds, h1 sizes, figure
// margins). From another origin it can only style itself. The frame reports
// its height so it never scrolls.
//
// Layout: the title and text in one half, the form in a Mist panel in the
// other (side by side from the tablet breakpoint, where the panel is wide
// enough for the form's two-up name row; the embed clips a narrower form).
// `band` puts a photo beside the text and form instead.
import type { Block } from '../../content.config';
import type { PortfolioKey } from '../../lib/portfolios';
import { md, mdInline } from '../../lib/md';
import Picture from '../ui/Picture.astro';
import { SITE } from '../../lib/site';

const frameOrigin = new URL(SITE.mediaBase).origin;

type Signup = Extract<Block, { type: 'signup' }>;
interface Props {
  block: Signup;
  locale: string;
  portfolio?: PortfolioKey;
}
const { block, locale } = Astro.props;
const src = `${SITE.mediaBase}/embeds/virtuous-signup.html?form=${encodeURIComponent(block.formId)}&org=${encodeURIComponent(block.orgId)}`;
const dark = block.background === 'ocean';
---

<section id={block.id} class:list={['section-y', dark ? 'uw-grain on-dark' : 'bg-white']}>
  {
    block.variant === 'band' ? (
      <div class="container-page grid items-center gap-x-16 gap-y-10 tablet:grid-cols-2">
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-3">
            {block.title && <h2 set:html={mdInline(block.title, locale)} />}
            {block.body && <div class="lead" set:html={md(block.body, locale)} />}
          </div>
          <div class="rounded-media bg-mist p-5 sm:p-8">
            <iframe
              class="signup-frame block min-h-[199px] w-full border-0"
              src={src}
              title={block.title ?? 'Sign up'}
              loading="lazy"
              data-form={block.formId}
              data-origin={frameOrigin}></iframe>
          </div>
        </div>
        {block.image && (
          <div class="hidden overflow-hidden rounded-media tablet:block">
            <Picture path={block.image} alt={block.imageAlt ?? ''} sizes="(min-width: 84rem) 608px, 50vw" widths={[608, 1000, 1216]} aspect="4 / 5" class="block" />
          </div>
        )}
      </div>
    ) : (
      <div class="mx-auto grid w-full max-w-[calc(1100px+2*var(--spacing-gutter))] items-center gap-x-16 gap-y-8 px-[var(--spacing-gutter)] tablet:grid-cols-2">
        <div class="flex flex-col gap-3">
          {block.title && <h2 set:html={mdInline(block.title, locale)} />}
          {block.body && <div class="lead" set:html={md(block.body, locale)} />}
        </div>
        <div class:list={['min-w-0 rounded-media p-5 sm:p-8', dark ? 'bg-white' : 'bg-mist']}>
          <iframe
            class="signup-frame block min-h-[199px] w-full border-0"
            src={src}
            title={block.title ?? 'Sign up'}
            loading="lazy"
            data-form={block.formId}
            data-origin={frameOrigin}></iframe>
        </div>
      </div>
    )
  }
</section>

<style>
  .lead :global(p + p) { margin-top: 0.6em; }
</style>

<script>
  window.addEventListener('message', (e) => {
    if (e.data?.type !== 'uw-embed-height') return;
    document.querySelectorAll<HTMLIFrameElement>('iframe.signup-frame').forEach((f) => {
      if (f.contentWindow === e.source && e.origin === f.dataset.origin) f.style.height = `${Math.min(4000, Math.ceil(Number(e.data.height)))}px`;
    });
  });
</script>
