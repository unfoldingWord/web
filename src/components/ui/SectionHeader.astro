---
import { mdInline } from '../../lib/md';

// A section's heading and optional intro line, spaced like production's
// stacked Elementor widgets (20px gap). Production has no eyebrow/kicker:
// `eyebrow` is accepted for existing content and not shown.
interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  align?: 'start' | 'center';
  id?: string;
  level?: 2 | 3;
  locale?: string;
}
const { title, intro, align = 'start', id, level = 2, locale } = Astro.props;
const Tag = `h${level}` as 'h2' | 'h3';
---

{
  (title || intro) && (
    <div class:list={['mb-5 flex flex-col gap-5', align === 'center' && 'text-center']}>
      {title && <Tag id={id} set:html={mdInline(title, locale)} />}
      {intro && <p class="text-body text-ink [.on-dark_&]:text-white" set:html={mdInline(intro, locale)} />}
    </div>
  )
}
