---
import { mdInline } from '../../lib/md';

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  align?: 'start' | 'center';
  id?: string;
  level?: 2 | 3;
  locale?: string;
}
const { eyebrow, title, intro, align = 'start', id, level = 2, locale } = Astro.props;
const Tag = `h${level}` as 'h2' | 'h3';
---

{
  (eyebrow || title || intro) && (
    <div class:list={['mb-8 max-w-3xl lg:mb-12', align === 'center' && 'mx-auto text-center']}>
      {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
      {title && <Tag id={id} set:html={mdInline(title, locale)} />}
      {intro && <p class="mt-4 text-lead text-ink-muted [.on-dark_&]:text-white/85" set:html={mdInline(intro, locale)} />}
    </div>
  )
}
