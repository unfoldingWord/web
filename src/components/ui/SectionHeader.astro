---
import { mdInline } from '../../lib/md';

// A section's heading and optional lead line: h2 then `lead`, 12px apart,
// at most ~760px wide, 36–44px above the content. No eyebrows: `eyebrow` is
// accepted for existing content and not shown.
interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  align?: 'start' | 'center';
  id?: string;
  level?: 2 | 3;
  locale?: string;
  class?: string;
}
const { title, intro, align = 'start', id, level = 2, locale, class: cls } = Astro.props;
const Tag = `h${level}` as 'h2' | 'h3';
---

{
  (title || intro) && (
    <div class:list={['mb-9 flex max-w-[760px] flex-col gap-3 md:mb-11', align === 'center' && 'mx-auto items-center text-center', cls]}>
      {title && <Tag id={id} set:html={mdInline(title, locale)} />}
      {intro && <p class="lead" set:html={mdInline(intro, locale)} />}
    </div>
  )
}
