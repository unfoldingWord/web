---
// A story teaser (Stories.dc.html grid item): a rounded photo, a meta line
// (region, and the portfolio with its color dot when the story has one), the
// title and a one-line excerpt. No card box. The title link stretches over
// the whole teaser, so it is one link and one tab stop.
// `variant` is accepted for older callers; every teaser now looks the same.
import type { CollectionEntry } from 'astro:content';
import { ui, localizePath } from '../../i18n';
import { basePathFor, splitId } from '../../lib/routes';
import { portfolio } from '../../lib/portfolios';
import Picture from './Picture.astro';

interface Props {
  story: CollectionEntry<'stories'>;
  locale: string;
  headingLevel?: 'h2' | 'h3';
  variant?: 'card' | 'row';
}
const { story, locale, headingLevel = 'h3' } = Astro.props;
const t = ui(locale);
const d = story.data;
const href = localizePath(basePathFor('stories', splitId(story.id).rest), locale);
const H = headingLevel;
const region = (t.regions as Record<string, string>)[d.region] ?? d.region;
const PF_NAMES: Record<string, string> = { transformation: 'Transformation', innovation: 'Innovation', catalyzation: 'Catalyzation', equippingPartners: 'Equipping Partners' };
const pf = d.portfolio ? portfolio(d.portfolio) : undefined;
const pfName = pf ? ((t.nav as Record<string, string>)[pf.navKey] ?? PF_NAMES[pf.navKey]) : undefined;
const excerpt = d.excerpt ?? d.description;
---

<article class="group relative flex h-full flex-col gap-3">
  <div class="relative h-[220px] overflow-hidden rounded-card bg-mist sm:h-[280px]">
    <Picture path={d.image} alt={d.imageAlt} sizes="(min-width: 66rem) 410px, (min-width: 40rem) 50vw, 100vw" widths={[400, 640, 820]} fill class="transition-transform duration-300 group-hover:scale-[1.03]" />
  </div>
  <p class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm font-extrabold text-inspire-ink">
    <span>{region}</span>
    {pf && (
      <span class:list={['inline-flex items-center gap-1.5 text-ocean', `pf-${pf.key}`]}>
        <span class="pf-dot" aria-hidden="true" />
        {pfName}
      </span>
    )}
  </p>
  <H class="text-h4 font-extrabold text-ocean">
    <a href={href} class="text-ocean after:absolute after:inset-0 after:content-[''] group-hover:text-inspire-ink">{d.title}</a>
  </H>
  {excerpt && <p class="line-clamp-2 text-ink-muted">{excerpt}</p>}
</article>
