---
// The end of a story or prayer request: an optional share row (X, Facebook)
// as outline pills, and a "Related" list of links with date and category.
import { ui, fmt } from '../../i18n';

export interface RelatedPost {
  title: string;
  href: string;
  date: string;
  datetime: string;
  category?: string;
}
interface Props {
  locale: string;
  /** Absolute URL and title of the page, for the share links. Omit to hide the share row. */
  share?: { url: string; title: string };
  related: RelatedPost[];
}
const { locale, share, related } = Astro.props;
const t = ui(locale);
const networks = share
  ? [
      { name: 'X', key: 'x', href: `https://x.com/intent/post?url=${encodeURIComponent(share.url)}&text=${encodeURIComponent(share.title)}` },
      { name: 'Facebook', key: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(share.url)}` },
    ]
  : [];
---

{
  share && (
    <div class="pf-block">
      <h2 class="pf-label">{t.shareThis}</h2>
      <ul class="pf-share">
        {networks.map((n) => (
          <li>
            <a href={n.href} target="_blank" rel="noopener noreferrer" class="pf-button" aria-label={fmt(t.shareOn, { network: n.name })}>
              {n.key === 'x' ? (
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.982 10.622 20.54 3h-1.554l-5.693 6.618L8.745 3H3.5l6.876 10.007L3.5 21h1.554l6.012-6.989L15.868 21h5.245l-7.131-10.378Zm-2.128 2.474-.697-.997-5.543-7.93H8l4.474 6.4.697.996 5.815 8.318h-2.387l-4.745-6.787Z" /></svg>
              ) : (
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2C6.5 2 2 6.5 2 12c0 5 3.7 9.1 8.4 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7C18.3 21.1 22 17 22 12c0-5.5-4.5-10-10-10Z" /></svg>
              )}
              <span>{n.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
{
  related.length > 0 && (
    <div class:list={['pf-block pf-related', !share && 'pf-related-alone']}>
      <h2 class="pf-label">{t.related}</h2>
      <ul class="pf-grid">
        {related.map((r) => (
          <li class="pf-post">
            <a href={r.href} class="pf-title">{r.title}</a>
            <time class="pf-meta" datetime={r.datetime}>{r.date}</time>
            {r.category && <span class="pf-meta">{fmt(t.inCategory, { name: r.category })}</span>}
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .pf-block { padding-top: 24px; border-top: 1px solid var(--color-line); }
  .pf-block + .pf-block { margin-top: 32px; }
  .pf-related { margin-bottom: 8px; }
  .pf-related-alone { margin-top: 40px; }
  .pf-label { margin: 0 0 16px; font-size: var(--text-h5); line-height: var(--text-h5--line-height); }
  .pf-share { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .pf-button {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 18px;
    border: 1px solid var(--color-line); border-radius: 999px; background: #fff;
    font-size: 0.9375rem; font-weight: 700; color: var(--color-ocean); text-decoration: none;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .pf-button:hover { border-color: var(--color-ocean); color: var(--color-ocean); background: var(--color-mist); }
  .pf-button svg { width: 18px; height: 18px; flex: none; }
  .pf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 20px 32px; list-style: none; margin: 0; padding: 0; }
  .pf-post { display: flex; flex-direction: column; gap: 4px; font-size: 0.9375rem; line-height: 1.45; color: var(--color-ink-muted); }
  .pf-title { font-size: 1.0625rem; font-weight: 800; line-height: 1.3; color: var(--color-ocean); text-decoration: none; }
  .pf-title:hover { color: var(--color-inspire-ink); text-decoration: underline; text-underline-offset: 3px; }
</style>
