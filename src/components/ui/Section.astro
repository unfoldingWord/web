---
// A full-width section: a design-system ground and the standard section
// padding, content in the page column (1280px) or the reading column (768px).
// Grounds: white for reading and forms, Mist for grids of cards, Ocean (with
// the grainy gradient) for number bands and closing asks.
interface Props {
  background?: 'white' | 'mist' | 'tint' | 'tint-light' | 'ocean' | 'cultivate' | 'kindle';
  width?: 'page' | 'prose';
  id?: string;
  class?: string;
  /** Accepted for existing content; every section uses the same padding. */
  tight?: boolean;
  labelledby?: string;
}
const { background = 'white', width = 'page', id, class: cls, labelledby } = Astro.props;
const bg = {
  white: 'bg-white',
  mist: 'bg-mist',
  tint: 'bg-mist',
  'tint-light': 'bg-mist',
  ocean: 'uw-grain on-dark',
  cultivate: 'bg-cultivate',
  kindle: 'bg-kindle-tint',
}[background];
---

<section id={id} aria-labelledby={labelledby} class:list={[bg, 'section-y', cls]}>
  <div class={width === 'prose' ? 'container-prose' : 'container-page'}>
    <slot />
  </div>
</section>
