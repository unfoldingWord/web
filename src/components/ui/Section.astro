---
// A full-width band with production's rhythm: 40px padding top and bottom,
// content in the 1000px column with 40px gutters. `background` picks one of
// the surfaces production uses: white, an Inspire tint (`mist` = 12%,
// `tint-light` = 7%), solid Ocean or Cultivate, or a Kindle tint.
interface Props {
  background?: 'white' | 'mist' | 'tint' | 'tint-light' | 'ocean' | 'cultivate' | 'kindle';
  width?: 'page' | 'prose';
  id?: string;
  class?: string;
  /** Kept for existing content: production uses one section padding everywhere. */
  tight?: boolean;
  labelledby?: string;
}
const { background = 'white', width = 'page', id, class: cls, labelledby } = Astro.props;
const bg = {
  white: 'bg-white',
  mist: 'bg-tint',
  tint: 'bg-tint',
  'tint-light': 'bg-tint-light',
  ocean: 'bg-ocean on-dark',
  cultivate: 'bg-cultivate',
  kindle: 'bg-kindle-tint',
}[background];
---

<section id={id} aria-labelledby={labelledby} class:list={[bg, 'py-[var(--spacing-section)]', cls]}>
  <div class={width === 'prose' ? 'container-prose' : 'container-page'}>
    <slot />
  </div>
</section>
