---
// Privacy-friendly video: a poster and play button, and the YouTube/Vimeo
// player only loads when the visitor presses play (no third-party requests,
// cookies or ~1 MB of player script on page load — this matters on phones
// and slow connections). Without JavaScript the link opens the video.
import { ui } from '../../i18n';
import Icon from './Icon.astro';

interface Props {
  provider: 'youtube' | 'vimeo';
  id: string;
  /** Privacy hash of an unlisted Vimeo video. */
  hash?: string;
  title: string;
}
const { provider, id, hash, title } = Astro.props;
const watch = provider === 'youtube' ? `https://www.youtube.com/watch?v=${id}` : `https://vimeo.com/${id}${hash ? `/${hash}` : ''}`;
const embed = provider === 'youtube' ? `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0` : `https://player.vimeo.com/video/${id}?${hash ? `h=${hash}&` : ''}autoplay=1&dnt=1`;
// YouTube serves stills from its image host; Vimeo has no stable public one,
// so Vimeo videos show the plain Ocean poster.
const poster = provider === 'youtube' ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : undefined;
---

<div class="video-frame relative aspect-video overflow-hidden rounded-card bg-ocean-900 shadow-card" data-embed={embed} data-title={title}>
  <a href={watch} class="group absolute inset-0 flex items-center justify-center" rel="noopener">
    {poster && <img src={poster} alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover opacity-80 transition group-hover:opacity-95" />}
    <span class="relative inline-flex size-18 items-center justify-center rounded-full bg-kindle text-tech shadow-raised transition group-hover:scale-105">
      <Icon name="play" class="size-10" />
    </span>
    <span class="sr-only">Play video: {title}</span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.video-frame').forEach((el) => {
    el.querySelector('a')?.addEventListener('click', (e) => {
      e.preventDefault();
      const f = document.createElement('iframe');
      f.src = el.dataset.embed!;
      f.title = el.dataset.title ?? 'Video';
      f.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
      f.allowFullscreen = true;
      f.className = 'absolute inset-0 h-full w-full';
      el.replaceChildren(f);
      f.focus();
    });
  });
</script>
