---
import { ui } from '../../i18n';

// A quiet trail: 15px muted text, Inspire links, "/" separators.
//
// `inherit`: on a colored panel (a portfolio hero, .pf-bg) the trail takes
// the panel's own text color (var(--pf-fg)), links underlined so they still
// read as links without a second color.
//
// `phone`: the row for phones, placed right under a banner whose own
// breadcrumbs (in its top padding) hide below 768px. It shows the parent
// links only, on one quiet line; the current page, already the banner's
// title, stays for screen readers. From 768px up it is not shown, so the
// banner keeps its trail and only one trail is ever in the page.
interface Props {
  items: { name: string; href?: string }[];
  locale: string;
  onDark?: boolean;
  inherit?: boolean;
  phone?: boolean;
}
const { items, locale, onDark = false, inherit = false, phone = false } = Astro.props;
const t = ui(locale);
const show = !phone || items.length > 1;
// Only the phone row gets a wrapper; the banner trail keeps its markup.
const Wrap = phone ? 'div' : Fragment;
const wrapProps = phone ? { class: 'container-page pt-2.5 md:hidden' } : {};
---

{
  show && (
    <Wrap {...wrapProps}>
      <nav aria-label={t.breadcrumb} class:list={['font-sans text-[0.9375rem] leading-snug font-normal', inherit ? 'text-[var(--pf-fg,currentColor)]' : onDark ? 'text-inspire-100' : 'text-ink-muted']}>
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
          {items.map((it, i) => {
            const current = !(it.href && i < items.length - 1);
            return (
              <li class:list={['flex items-center gap-2', phone && current && 'sr-only']}>
                {i > 0 && <span aria-hidden="true" class="opacity-60">/</span>}
                {current ? (
                  <span aria-current="page">{it.name}</span>
                ) : (
                  <a href={it.href} class:list={['font-semibold underline-offset-3', inherit ? 'text-[var(--pf-fg,currentColor)] underline decoration-1 hover:decoration-2' : ['hover:underline', onDark ? 'text-inspire-100 hover:text-white' : 'text-inspire-ink hover:text-ocean']]}>
                    {it.name}
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </nav>
    </Wrap>
  )
}
