const { name, class: cls = 'size-5', label } = Astro.props;
const body = (ICONS as Record<string, string>)[name];
if (!body) throw new Error(`Icon "${name}" is not defined in Icon.astro`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={[cls, 'shrink-0']}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={body}
/>
