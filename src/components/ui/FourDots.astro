---
// The four-dot marker that introduces a takeaway line (brand book).
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<svg aria-hidden="true" viewBox="0 0 24 24" class={cls} fill="var(--color-kindle)" stroke="var(--color-kindle)" stroke-width="1.4"><path d="M12 5v14M5 12h14" fill="none"></path><circle cx="12" cy="4" r="2.6"></circle><circle cx="12" cy="20" r="2.6"></circle><circle cx="4" cy="12" r="2.6"></circle><circle cx="20" cy="12" r="2.6"></circle></svg>
