---
// A prayer request, laid out like a story (Story.dc.html, Pray.dc.html): an
// 880px header (breadcrumbs, date and region, the title), the photo when
// there is one, the request in PT Serif on the 720px column, the "I prayed
// for this" toggle (remembered in this browser only, shared with the
// /pray/ list), a link back to all requests, and the requests named in
// `related` as cards on Mist.
import { render, getCollection, type CollectionEntry } from 'astro:content';
import { SITE } from '../../lib/site';
import { webPageNode, breadcrumbNode, articleNode } from '../../lib/jsonld';
import { ui, formatDate, localizePath } from '../../i18n';
import { basePathFor, splitId, type Route } from '../../lib/routes';
import { mdInline } from '../../lib/md';
import LocalizedBody from '../ui/LocalizedBody.astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Picture from '../ui/Picture.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  route: Route;
  crumbs: { name: string; href?: string }[];
}
const { route, crumbs } = Astro.props;
const entry = route.entry as CollectionEntry<'prayer'>;
const d = entry.data;
const t = ui(route.locale);
const s = t as Record<string, unknown>;
const { Content } = await render(entry);
const url = new URL(route.path, SITE.url).href;
const regions = t.regions as Record<string, string>;
const regionName = (r?: string) => (r ? (regions[r] ?? r) : undefined);
const own = splitId(entry.id).rest;

// Related: the requests named in `related` (in this locale when translated).
// A translation without its own list uses English's.
const bySlug = new Map<string, CollectionEntry<'prayer'>>();
let englishRelated: string[] | undefined;
for (const p of await getCollection('prayer')) {
  const { locale: l, rest } = splitId(p.id);
  if (l === 'en' && rest === own) englishRelated = p.data.related;
  if (l === 'en' && !bySlug.has(rest)) bySlug.set(rest, p);
  if (l === route.locale) bySlug.set(rest, p);
}
const related = (d.related ?? englishRelated ?? [])
  .filter((slug) => slug !== own && bySlug.has(slug))
  .map((slug) => {
    const p = bySlug.get(slug)!;
    return {
      title: p.data.title,
      description: p.data.description,
      href: localizePath(basePathFor('prayer', slug), route.locale),
      date: formatDate(p.data.date, route.locale),
      datetime: p.data.date.toISOString(),
      region: regionName(p.data.region),
    };
  });
const iPrayed = (s.iPrayed as string) ?? 'I prayed for this';
const prayed = (s.prayed as string) ?? 'Prayed';

const jsonLd = [
  webPageNode({ url, title: d.title, description: d.description, lang: route.locale, breadcrumbId: `${url}#breadcrumb` }),
  breadcrumbNode(url, crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? route.path, SITE.url).href }))),
  articleNode({ url, title: d.title, description: d.description, date: d.date, modified: d.updated, author: SITE.name, lang: route.locale, section: 'Prayer' }),
];
---

<Base locale={route.locale} basePath={route.basePath} title={d.title} description={d.description} ogType="article" jsonLd={jsonLd} translations={route.translations} fallback={route.fallback} noindex={route.noindex} pageType="prayer">
  <article>
    <header class="mx-auto flex max-w-[calc(880px+2*var(--spacing-gutter))] flex-col gap-[18px] px-[var(--spacing-gutter)] pt-12 pb-10 md:pt-16">
      <Breadcrumbs items={crumbs} locale={route.locale} />
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2.5">
        <span class="chip text-sm"><time datetime={d.date.toISOString()}>{formatDate(d.date, route.locale)}</time></span>
        {d.region && <span class="text-[0.9375rem] text-ink-muted">{regionName(d.region)}</span>}
      </div>
      <h1 class="text-[clamp(2.25rem,1.2rem+3.2vw,3.75rem)] leading-[1.06]" set:html={mdInline(d.title)} />
    </header>

    {
      d.image && (
        <div class="container-page mb-12">
          <div class="relative h-[260px] overflow-hidden rounded-media bg-mist sm:h-[420px] lg:h-[520px]">
            <Picture path={d.image} alt={d.imageAlt ?? ''} eager sizes="(min-width: 82rem) 1280px, 100vw" fill />
          </div>
        </div>
      )
    }

    <div class="container-story pb-16 md:pb-20">
      <div class="prose prose-serif"><LocalizedBody locale={route.locale}><Content /></LocalizedBody></div>
      <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
        <button type="button" class="uw-pill" data-pray-toggle={own} aria-pressed="false" hidden>
          <span data-off>{iPrayed}</span>
          <span data-on hidden class="inline-flex items-center gap-1.5"><Icon name="check" class="size-4" />{prayed}</span>
        </button>
        <a href={localizePath('/pray/', route.locale)} class="uw-more">
          <Icon name="arrow-right" class="size-4 -scale-x-100 rtl:scale-x-100" />
          {t.allPrayerRequests}
        </a>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="bg-mist py-[var(--spacing-section)]" aria-labelledby="related-requests">
        <div class="container-page flex flex-col gap-9">
          <h2 id="related-requests">{t.related}</h2>
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <li class="flex">
                <article class="uw-card flex flex-1 flex-col gap-3 p-7">
                  <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    {r.region && <span class="chip">{r.region}</span>}
                    <time datetime={r.datetime} class="text-sm text-ink-muted">{r.date}</time>
                  </p>
                  <h3 class="text-h4 font-black">
                    <a href={r.href} class="text-ocean hover:text-inspire-ink" set:html={mdInline(r.title)} />
                  </h3>
                  <p class="text-ink-muted">{r.description}</p>
                </article>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<script>
  // Same store as the /pray/ list (PrayerList.astro): local to this browser.
  const KEY = 'uw-prayed';
  const load = (): Set<string> => {
    try {
      return new Set(JSON.parse(localStorage.getItem(KEY) ?? '[]'));
    } catch {
      return new Set();
    }
  };
  document.querySelectorAll<HTMLButtonElement>('article [data-pray-toggle]').forEach((b) => {
    const id = b.dataset.prayToggle!;
    let on = load().has(id);
    const paint = () => {
      b.setAttribute('aria-pressed', String(on));
      b.querySelector<HTMLElement>('[data-off]')!.hidden = on;
      b.querySelector<HTMLElement>('[data-on]')!.hidden = !on;
    };
    b.hidden = false;
    b.addEventListener('click', () => {
      on = !on;
      const ids = load();
      if (on) ids.add(id);
      else ids.delete(id);
      try {
        localStorage.setItem(KEY, JSON.stringify([...ids]));
      } catch {
        /* not saved; the toggle still works for this visit */
      }
      paint();
    });
    paint();
  });
</script>
