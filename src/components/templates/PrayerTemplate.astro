---
// A prayer request, laid out like production: the page-title banner (title
// in white capitals over a 50% Ocean overlay), the request in the 1000px
// column, its month centered underneath, then (when `related` names them)
// up to three related requests.
import { render, getCollection, type CollectionEntry } from 'astro:content';
import { SITE } from '../../lib/site';
import { webPageNode, breadcrumbNode, articleNode } from '../../lib/jsonld';
import { ui, formatDate, formatMonth, localizePath } from '../../i18n';
import { basePathFor, splitId, type Route } from '../../lib/routes';
import LocalizedBody from '../ui/LocalizedBody.astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Picture from '../ui/Picture.astro';
import PostFooter from '../ui/PostFooter.astro';

interface Props {
  route: Route;
  crumbs: { name: string; href?: string }[];
}
const { route, crumbs } = Astro.props;
const entry = route.entry as CollectionEntry<'prayer'>;
const d = entry.data;
const t = ui(route.locale);
const { Content } = await render(entry);
const url = new URL(route.path, SITE.url).href;
const regions = t.regions as Record<string, string>;

// Related: the requests named in `related` (one per slug, in this locale
// when translated), like production's Jetpack list, which most production
// requests do not show. A translation without its own list uses English's.
const bySlug = new Map<string, CollectionEntry<'prayer'>>();
const own = splitId(entry.id).rest;
let englishRelated: string[] | undefined;
for (const p of await getCollection('prayer')) {
  const { locale: l, rest } = splitId(p.id);
  if (l === 'en' && rest === own) englishRelated = p.data.related;
  if (l === 'en' && !bySlug.has(rest)) bySlug.set(rest, p);
  if (l === route.locale) bySlug.set(rest, p);
}
const relatedSlugs = d.related ?? englishRelated ?? [];
const related = relatedSlugs
  .filter((slug) => slug !== own && bySlug.has(slug))
  .map((slug) => [slug, bySlug.get(slug)!] as const)
  .map(([slug, p]) => ({
    title: p.data.title,
    href: localizePath(basePathFor('prayer', slug), route.locale),
    date: formatDate(p.data.date, route.locale),
    datetime: p.data.date.toISOString(),
    category: p.data.region ? (regions[p.data.region] ?? p.data.region) : undefined,
  }));

const jsonLd = [
  webPageNode({ url, title: d.title, description: d.description, lang: route.locale, breadcrumbId: `${url}#breadcrumb` }),
  breadcrumbNode(url, crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? route.path, SITE.url).href }))),
  articleNode({ url, title: d.title, description: d.description, date: d.date, modified: d.updated, author: SITE.name, lang: route.locale, section: 'Prayer' }),
];
---

<Base locale={route.locale} basePath={route.basePath} title={d.title} description={d.description} ogType="article" jsonLd={jsonLd} translations={route.translations} fallback={route.fallback} noindex={route.noindex} pageType="prayer">
  <article>
    <header class:list={['uw-banner on-dark post-banner', !d.image && 'post-banner-plain']}>
      {
        d.image && (
          <div class="absolute inset-0 -z-20">
            <Picture path={d.image} alt={d.imageAlt ?? ''} eager sizes="100vw" fill class="post-banner-img" />
          </div>
        )
      }
      <div class="absolute inset-0 -z-10 bg-ocean/50" aria-hidden="true"></div>
      <div class="post-crumbs">
        <div class="container-page text-start"><Breadcrumbs items={crumbs} locale={route.locale} onDark /></div>
      </div>
      <h1 class="post-title">{d.title}</h1>
    </header>
    <Breadcrumbs items={crumbs} locale={route.locale} phone />
    <div class="container-page py-[var(--spacing-section)]">
      <div class="prose post-body"><LocalizedBody locale={route.locale}><Content /></LocalizedBody></div>
      <p class="prayer-month"><time datetime={d.date.toISOString()}>{formatMonth(d.date, route.locale)}</time></p>
      <PostFooter locale={route.locale} related={related} />
    </div>
  </article>
</Base>

<style>
  /* Production's page-title banner (see StoryTemplate). Prayer requests have
     no photo: the overlay sits over white. */
  .post-banner {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 200px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 40px;
    text-align: center;
  }
  .post-banner-plain { background-color: #fff; }
  .post-banner :global(.post-banner-img) { object-position: top; }
  .post-title {
    max-width: 1000px;
    margin: 0;
    font-size: var(--text-h2);
    line-height: 1;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
  }
  /* On phones the banner trail hides; a compact row follows the banner. */
  .post-crumbs { position: absolute; inset-inline: 0; top: 10px; }
  @media (max-width: 767px) { .post-crumbs { display: none; } }
  .post-body { max-width: none; }
  /* Production wraps text plainly (no balance or pretty). */
  .post-title, .post-body :global(:is(p, h2, h3, li)) { text-wrap: wrap; }
  /* The month: production's block-editor "medium" paragraph, centered. */
  .prayer-month { margin: 0 0 14.4px; text-align: center; font-size: 20px; line-height: 30px; font-weight: 300; color: #000; }
</style>
