---
// A story from the field, laid out like production's single-post template:
// the page-title banner (the story photo under a 50% Ocean overlay, the
// title in white capitals), the text in the 1000px column, then "Share this"
// and three related stories. Our breadcrumbs sit quietly in the banner.
import { render, getCollection, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { SITE } from '../../lib/site';
import { img } from '../../lib/images';
import { webPageNode, breadcrumbNode, articleNode } from '../../lib/jsonld';
import { ui, formatDate, localizePath } from '../../i18n';
import { basePathFor, splitId, type Route } from '../../lib/routes';
import LocalizedBody from '../ui/LocalizedBody.astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Picture from '../ui/Picture.astro';
import PostFooter from '../ui/PostFooter.astro';

interface Props {
  route: Route;
  crumbs: { name: string; href?: string }[];
}
const { route, crumbs } = Astro.props;
const entry = route.entry as CollectionEntry<'stories'>;
const d = entry.data;
const t = ui(route.locale);
const { Content } = await render(entry);
const url = new URL(route.path, SITE.url).href;
const og = new URL((await getImage({ src: img(d.image), width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, SITE.url).href;
const regions = t.regions as Record<string, string>;
const region = regions[d.region] ?? d.region;

// Related: production's Jetpack picks three posts; ours takes the newest
// stories from the same region first, then the newest of the rest.
const all = (await getCollection('stories')).filter((s) => splitId(s.id).locale === 'en' && s.id !== entry.id);
const related = all
  .sort((a, b) => Number(b.data.region === d.region) - Number(a.data.region === d.region) || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((s) => ({
    title: s.data.title,
    href: localizePath(basePathFor('stories', splitId(s.id).rest), route.locale),
    date: formatDate(s.data.date, route.locale),
    datetime: s.data.date.toISOString(),
    category: regions[s.data.region] ?? s.data.region,
  }));

const jsonLd = [
  webPageNode({ url, title: d.title, description: d.description, lang: route.locale, image: og, breadcrumbId: `${url}#breadcrumb` }),
  breadcrumbNode(url, crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? route.path, SITE.url).href }))),
  articleNode({ url, title: d.title, description: d.description, image: og, date: d.date, modified: d.updated, author: d.author, lang: route.locale, section: region }),
];
---

<Base locale={route.locale} basePath={route.basePath} title={d.title} description={d.description} ogImage={og} ogType="article" jsonLd={jsonLd} translations={route.translations} fallback={route.fallback} noindex={route.noindex} pageType="story">
  <article>
    <header class="uw-banner on-dark post-banner">
      <div class="absolute inset-0 -z-20">
        <Picture path={d.image} alt={d.imageAlt} eager sizes="100vw" fill class="post-banner-img" />
      </div>
      <div class="absolute inset-0 -z-10 bg-ocean/50" aria-hidden="true"></div>
      <div class="post-crumbs">
        <div class="container-page text-start"><Breadcrumbs items={crumbs} locale={route.locale} onDark /></div>
      </div>
      <h1 class="post-title">{d.title}</h1>
    </header>
    <div class="container-page py-[var(--spacing-section)]">
      <div class:list={['prose post-body', d.largeText && 'post-body-large']}>
        <LocalizedBody locale={route.locale}><Content /></LocalizedBody>
      </div>
      <PostFooter locale={route.locale} share={{ url, title: d.title }} related={related} />
    </div>
  </article>
</Base>

<style>
  /* Production's page-title banner: 200px, photo under a flat 50% Ocean
     overlay, centered white 32px/700 capitals. */
  .post-banner {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 200px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 40px;
    text-align: center;
  }
  /* Production paints the photo from its top edge. */
  .post-banner :global(.post-banner-img) { object-position: top; }
  .post-title {
    max-width: 1000px;
    margin: 0;
    font-size: var(--text-h2);
    line-height: 1;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
  }
  /* Our breadcrumbs, kept small in the banner's top padding so the title
     stays centered; on phones there is no room (the JSON-LD trail remains). */
  .post-crumbs { position: absolute; inset-inline: 0; top: 10px; }
  @media (max-width: 767px) { .post-crumbs { display: none; } }

  /* Body: the site sans on the full 1000px column (production's
     theme-post-content widget). */
  .post-body { max-width: none; }
  /* Production wraps text plainly (no balance or pretty). */
  .post-title, .post-body :global(:is(p, h2, h3, li)) { text-wrap: wrap; }
  .post-body :global(iframe), .post-body :global(.video-frame) { border-radius: 0; }
  .post-body :global(.video-frame), .post-body :global(figure) { margin-block: 0 20px; }
  /* Posts built in Elementor on production (largeText): 19.36/29.04 text in
     a 980px column, 10px in from the edges, plain Tech h2s, 20px between
     widgets. */
  .post-body-large { padding: 10px; font-size: var(--text-story); line-height: var(--text-story--line-height); }
  .post-body-large :global(p) { margin-bottom: 14.4px; }
  .post-body-large :global(h2) { font-size: 32px; line-height: 1.2; font-weight: 500; color: var(--color-tech); margin-block: 20px; }
  .post-body-large :global(p + h2) { margin-top: 5.6px; }
</style>
