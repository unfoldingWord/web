---
import { render, getCollection, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { SITE } from '../../lib/site';
import { img } from '../../lib/images';
import { webPageNode, breadcrumbNode, articleNode } from '../../lib/jsonld';
import { ui, formatDate, fmt, localizePath } from '../../i18n';
import { splitId, type Route } from '../../lib/routes';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Picture from '../ui/Picture.astro';
import StoryCard from '../ui/StoryCard.astro';
import Cta from '../blocks/Cta.astro';

interface Props {
  route: Route;
  crumbs: { name: string; href?: string }[];
}
const { route, crumbs } = Astro.props;
const entry = route.entry as CollectionEntry<'stories'>;
const d = entry.data;
const t = ui(route.locale);
const { Content } = await render(entry);
const url = new URL(route.path, SITE.url).href;
const og = new URL((await getImage({ src: img(d.image), width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, SITE.url).href;
const region = (t.regions as Record<string, string>)[d.region] ?? d.region;

const all = (await getCollection('stories')).filter((s) => splitId(s.id).locale === 'en' && s.id !== entry.id);
const related = all
  .sort((a, b) => Number(b.data.region === d.region) - Number(a.data.region === d.region) || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const jsonLd = [
  webPageNode({ url, title: d.title, description: d.description, lang: route.locale, image: og, breadcrumbId: `${url}#breadcrumb` }),
  breadcrumbNode(url, crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? route.path, SITE.url).href }))),
  articleNode({ url, title: d.title, description: d.description, image: og, date: d.date, modified: d.updated, author: d.author, lang: route.locale, section: region }),
];
---

<Base locale={route.locale} basePath={route.basePath} title={d.title} description={d.description} ogImage={og} ogType="article" jsonLd={jsonLd} translations={route.translations} fallback={route.fallback} noindex={route.noindex} pageType="story">
  <article>
    <header class="bg-mist">
      <div class="container-page grid gap-8 py-10 lg:grid-cols-12 lg:items-center lg:gap-14 lg:py-16">
        <div class="lg:col-span-6">
          <div class="mb-5"><Breadcrumbs items={crumbs} locale={route.locale} /></div>
          <p class="eyebrow mb-3">{region}{d.country ? ` · ${d.country}` : ''}</p>
          <h1 class="text-h1">{d.title}</h1>
          {d.excerpt && <p class="mt-5 text-lead text-ink-muted">{d.excerpt}</p>}
          <p class="mt-5 text-sm text-ink-muted">
            <time datetime={d.date.toISOString()}>{fmt(t.publishedOn, { date: formatDate(d.date, route.locale) })}</time>
          </p>
        </div>
        <div class="overflow-hidden rounded-card shadow-raised lg:col-span-6">
          <Picture path={d.image} alt={d.imageAlt} eager sizes="(min-width: 64rem) 50vw, 100vw" aspect="3 / 2" />
        </div>
      </div>
    </header>
    <div class="container-prose py-[var(--spacing-section)]">
      <div class="prose prose-serif"><Content /></div>
    </div>
  </article>

  <Cta
    block={{ type: 'cta', variant: 'ocean', title: t.storyCtaTitle, body: t.storyCtaBody, actions: [{ label: t.donate, href: '/give/', style: 'give' }, { label: t.allStories, href: '/stories/', style: 'secondary' }] }}
    locale={route.locale}
  />

  {
    related.length > 0 && (
      <section class="bg-mist py-[var(--spacing-section)]">
        <div class="container-page">
          <h2 class="mb-8">{t.allStories}</h2>
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((s) => (
              <li class="flex"><StoryCard story={s} locale={route.locale} /></li>
            ))}
          </ul>
          <p class="mt-8"><a href={localizePath('/stories/', route.locale)} class="font-heading font-extrabold">{t.allStories}</a></p>
        </div>
      </section>
    )
  }
</Base>
