---
// A story from the field (Story.dc.html): an 880px header (breadcrumbs,
// region chip, date and reading time, the title and the excerpt), the photo
// across the page column, the story in PT Serif on the 720px column with a
// drop cap, a row of labels and "Pray" / "Give" buttons, the security
// phrase, three more stories on Mist, and a closing give band.
import { render, getCollection, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { SITE } from '../../lib/site';
import { img } from '../../lib/images';
import { portfolio } from '../../lib/portfolios';
import { webPageNode, breadcrumbNode, articleNode } from '../../lib/jsonld';
import { ui, fmt, formatDate, localizePath } from '../../i18n';
import { splitId, type Route } from '../../lib/routes';
import LocalizedBody from '../ui/LocalizedBody.astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Picture from '../ui/Picture.astro';
import StoryCard from '../ui/StoryCard.astro';

interface Props {
  route: Route;
  crumbs: { name: string; href?: string }[];
}
const { route, crumbs } = Astro.props;
const entry = route.entry as CollectionEntry<'stories'>;
const d = entry.data;
const t = ui(route.locale);
const s = t as Record<string, unknown>;
const { Content } = await render(entry);
const url = new URL(route.path, SITE.url).href;
const og = new URL((await getImage({ src: img(d.image), width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, SITE.url).href;
const regions = t.regions as Record<string, string>;
const region = regions[d.region] ?? d.region;

// Reading time at 230 words a minute, from the Markdown without tags.
const words = (entry.body ?? '').replace(/<[^>]+>/g, ' ').replace(/[#>*_`[\]()!-]/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
const readTime = fmt((s.minuteRead as string) ?? '{n} minute read', { n: minutes });

const PF_NAMES: Record<string, string> = { transformation: 'Transformation', innovation: 'Innovation', catalyzation: 'Catalyzation', equippingPartners: 'Equipping Partners' };
const pf = d.portfolio ? portfolio(d.portfolio) : undefined;
const pfName = pf ? ((t.nav as Record<string, string>)[pf.navKey] ?? PF_NAMES[pf.navKey]) : undefined;
const security = (t.footer as Record<string, string> | undefined)?.security ?? 'Names, locations, and images may have been altered or obscured for security purposes.';

// Related: the three stories the editor listed in `related`; otherwise the
// newest stories from the same region first, then the newest of the rest.
// Each in this page's language when translated.
const stories = await getCollection('stories');
const all = stories.filter((x) => splitId(x.id).locale === 'en' && x.id !== entry.id && splitId(x.id).rest !== splitId(entry.id).rest);
const picked = d.related
  ? d.related.map((slug) => {
      const x = all.find((y) => splitId(y.id).rest === slug);
      if (!x) throw new Error(`Story "${entry.id}": related story "${slug}" does not exist (use the file name without .md)`);
      return x;
    })
  : all
      .sort((a, b) => Number(b.data.region === d.region) - Number(a.data.region === d.region) || b.data.date.getTime() - a.data.date.getTime())
      .slice(0, 3);
const related = picked.map((x) => stories.find((y) => y.id === `${route.locale}/${splitId(x.id).rest}`) ?? x);

const jsonLd = [
  webPageNode({ url, title: d.title, description: d.description, lang: route.locale, image: og, breadcrumbId: `${url}#breadcrumb` }),
  breadcrumbNode(url, crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? route.path, SITE.url).href }))),
  articleNode({ url, title: d.title, description: d.description, image: og, date: d.date, modified: d.updated, author: d.author, lang: route.locale, section: region }),
];
---

<Base locale={route.locale} basePath={route.basePath} title={d.title} description={d.description} ogImage={og} ogType="article" jsonLd={jsonLd} translations={route.translations} fallback={route.fallback} noindex={route.noindex} pageType="story">
  <article>
    <header class="mx-auto flex max-w-[calc(880px+2*var(--spacing-gutter))] flex-col gap-[18px] px-[var(--spacing-gutter)] pt-12 pb-10 md:pt-16">
      <Breadcrumbs items={crumbs} locale={route.locale} />
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2.5">
        <span class="chip text-sm">{region}</span>
        <span class="text-[0.9375rem] text-ink-muted"><time datetime={d.date.toISOString()}>{formatDate(d.date, route.locale)}</time> · {readTime}</span>
      </div>
      <h1 class="text-[clamp(2.25rem,1.2rem+3.2vw,3.75rem)] leading-[1.06]">{d.title}</h1>
      {(d.excerpt ?? d.description) && <p class="text-[1.3125rem] leading-normal text-ink-muted">{d.excerpt ?? d.description}</p>}
    </header>

    <div class="container-page">
      <div class="relative h-[300px] overflow-hidden rounded-media bg-mist sm:h-[460px] lg:h-[620px]">
        <Picture path={d.image} alt={d.imageAlt} eager sizes="(min-width: 82rem) 1280px, 100vw" fill class="object-[50%_25%]" />
      </div>
    </div>

    <div class="container-story pt-12 pb-6 md:pt-14">
      <div class="story-body prose prose-serif"><LocalizedBody locale={route.locale}><Content /></LocalizedBody></div>
    </div>

    <div class="container-story">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 border-t border-line pt-6">
        <div class="flex flex-wrap gap-2">
          <span class="chip chip-outline">{region}</span>
          {pf && <span class:list={['pf-chip', `pf-${pf.key}`]}>{pfName}</span>}
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={localizePath('/pray/', route.locale)} class="uw-btn uw-btn-secondary">{(s.prayForThisWork as string) ?? 'Pray for this work'}</a>
          <a href={localizePath('/give/', route.locale)} class="uw-btn uw-btn-give">{t.donate}</a>
        </div>
      </div>
      <p class="pt-6 pb-16 text-sm text-ink-muted italic md:pb-20">{security}</p>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="bg-mist py-[var(--spacing-section)]" aria-labelledby="keep-reading">
        <div class="container-page flex flex-col gap-9">
          <h2 id="keep-reading">{(s.keepReading as string) ?? 'Keep reading'}</h2>
          <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((x) => (
              <li>
                <StoryCard story={x} locale={route.locale} headingLevel="h3" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="uw-grain on-dark py-[var(--spacing-section)]">
    <div class="container-page flex flex-col items-start gap-5">
      <h2 class="max-w-[760px]">{t.storyCtaTitle}</h2>
      <p class="lead max-w-[640px]">{t.storyCtaBody}</p>
      <a href={localizePath('/give/', route.locale)} class="uw-btn uw-btn-give uw-btn-lg mt-2">{t.donate}</a>
    </div>
  </section>
</Base>

<style>
  /* Drop cap on the opening paragraph, for Latin and Cyrillic text only
     (other scripts have no capital letters to drop). */
  :global(html:is([data-script='latin'], [data-script='cyrillic'])) .story-body > :global(p:first-of-type)::first-letter,
  :global(main[lang='en']) .story-body > :global(p:first-of-type)::first-letter {
    float: inline-start;
    padding-top: 6px;
    padding-inline-end: 12px;
    font-family: var(--font-heading);
    font-size: 4.75rem;
    line-height: 0.85;
    font-weight: 800;
    color: var(--color-ocean);
  }
  .story-body :global(figure), .story-body :global(.video-frame) { margin-block: 2em; }
  .story-body :global(img), .story-body :global(iframe) { border-radius: var(--radius-small); }
</style>
