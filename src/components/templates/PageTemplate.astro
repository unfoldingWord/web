---
import { render, type CollectionEntry } from 'astro:content';
import { SITE } from '../../lib/site';
import { webPageNode, breadcrumbNode, faqNode, videoNode } from '../../lib/jsonld';
import { plain } from '../../lib/md';
import type { Route } from '../../lib/routes';
import LocalizedBody from '../ui/LocalizedBody.astro';
import Base from '../../layouts/Base.astro';
import BlockRenderer from '../blocks/BlockRenderer.astro';
import Hero from '../blocks/Hero.astro';
import Icon from '../ui/Icon.astro';
import GiveBand from '../blocks/GiveBand.astro';
import { ui, fmt, localizePath } from '../../i18n';
import { NAV } from '../../lib/site';
import { portfolio as portfolioOf } from '../../lib/portfolios';
import { getImage } from 'astro:assets';
import { img } from '../../lib/images';

interface Props {
  route: Route;
  crumbs: { name: string; href?: string }[];
  experiment?: { id: string; variant: string };
}
const { route, crumbs, experiment } = Astro.props;
const entry = route.entry as CollectionEntry<'pages'>;
const d = entry.data;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
// Giving landing pages open with their own h1 (the landing giving block), so
// they get no title band either.
const firstIsHero =
  d.sections[0]?.type === 'hero' ||
  d.sections[0]?.type === 'heroSlideshow' ||
  d.sections.some((s) => s.type === 'giving' && s.variant === 'landing');
const url = new URL(route.path, SITE.url).href;
const isHome = route.basePath === '/';

const heroImage = d.ogImage ?? (d.sections.find((s) => s.type === 'hero' && 'image' in s && s.image) as { image?: string } | undefined)?.image;
const og = heroImage ? new URL((await getImage({ src: img(heroImage), width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, SITE.url).href : undefined;

const faqs = d.sections.flatMap((s) => (s.type === 'faq' ? s.items : []));
const videos = d.sections.flatMap((s) => {
  if (s.type === 'video') return [videoNode({ ...s, url, description: s.caption, transcript: s.transcript ? plain(s.transcript) : undefined })];
  if (s.type === 'split' && s.video) return [videoNode({ ...s.video, url })];
  return [];
});
const jsonLd = [
  webPageNode({ url, title: d.title, description: d.description, lang: route.locale, type: d.schemaType === 'DonatePage' ? 'WebPage' : d.schemaType, image: og, dateModified: d.updated, breadcrumbId: isHome ? undefined : `${url}#breadcrumb` }),
  ...(isHome ? [] : [breadcrumbNode(url, crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? route.path, SITE.url).href })))]),
  ...(faqs.length ? [faqNode(url, faqs.map((f) => ({ q: plain(f.q), a: plain(f.a) })))] : []),
  ...videos,
];
const pageType = d.template === 'giving' ? 'giving' : isHome ? 'home' : 'page';
const t = ui(route.locale) as Record<string, unknown> & { nav: Record<string, string> };
const pf = d.portfolio;

// The closing give band (design system): on every page except giving pages,
// pages that already carry a giving form or band, and pages that opt out.
const ownsGiving = d.sections.some((s) => s.type === 'giving' || s.type === 'giveBand' || (s.type === 'cta' && (s.variant === 'ocean' || s.variant === 'split')));
const showGiveBand = d.giveBand && d.template !== 'giving' && !ownsGiving && !d.noindex;
const pfName = pf ? t.nav[portfolioOf(pf).navKey] : undefined;
const giveBand = {
  type: 'giveBand' as const,
  title: (t.giveBandTitle as string) ?? 'Give the gospel. *Change lives forever.*',
  body: t.giveBandBody as string | undefined,
  action: pf && pf !== 'equipping'
    ? { label: fmt((t.giveToPortfolio as string) ?? 'Give to {name}', { name: pfName ?? pf }), href: portfolioOf(pf).giveHref, style: 'give' as const }
    : { label: (t.giveNow as string) ?? 'Give now', href: '/give/', style: 'give' as const },
  image: 'home/give-boy-classroom.jpg',
  imageAlt: 'A young boy in a checked school uniform looks back over his shoulder while seated among other children',
};

// "In this section" beside the text of pages that belong to a menu group
// with a section index (CCBT).
const group = NAV.find((n) => (n.key === 'ccbtMenu' || n.key === 'ccbt') && n.children?.some((c) => c.href === route.basePath));
const sectionNav = group?.children?.filter((c) => c.href && !c.external);
const inThisSection = (t.inThisSection as string) ?? 'In this section';
// Beside the text when the page has a Markdown body after its sections;
// otherwise (content only in sections, e.g. /ccbt/faq/) a row of pills under
// the hero.
const sideNav = Boolean(sectionNav?.length && hasBody && d.bodyPosition === 'after');
const pillNav = Boolean(sectionNav?.length && !sideNav);
---

<Base
  locale={route.locale}
  basePath={route.basePath}
  title={d.title}
  description={d.description}
  ogImage={og}
  jsonLd={jsonLd}
  translations={route.translations}
  fallback={route.fallback}
  noindex={route.noindex}
  pageType={pageType}
  experiment={experiment}
>
  {
    !firstIsHero && (
      <Hero
        block={{ type: 'hero', variant: 'banner', title: d.heading ?? d.title, image: d.bannerImage, imageAlt: d.bannerImageAlt, actions: [] }}
        locale={route.locale}
        portfolio={pf}
        crumbs={!isHome && d.breadcrumbs ? crumbs : undefined}
      />
    )
  }
  {firstIsHero && <BlockRenderer blocks={d.sections.slice(0, 1)} locale={route.locale} portfolio={pf} crumbs={!isHome && d.breadcrumbs ? crumbs : undefined} />}
  {
    pillNav && (
      <div class="container-page pt-8">
        {/* A disclosure on phones (closed), an open row of pills from 64rem. */}
        <details open class="section-nav rounded-small border border-line lg:rounded-none lg:border-0">
          <summary class="label flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 px-3.5 !text-ink-muted lg:hidden">
            {inThisSection}
            <Icon name="chevron-down" class="section-nav-chevron size-5 transition" />
          </summary>
          <nav aria-label={inThisSection} class="flex flex-wrap items-center gap-2 px-3 pb-3 lg:p-0">
            <p class="label !text-ink-muted me-2 hidden lg:block">{inThisSection}</p>
            {sectionNav!.map((c) => (
              <a href={localizePath(c.href!, route.locale)} aria-current={c.href === route.basePath ? 'page' : undefined} class:list={['rounded-full border px-4 py-2 text-[0.9375rem] text-ocean no-underline hover:bg-mist', c.href === route.basePath ? 'border-inspire bg-inspire-50 font-extrabold' : 'border-line font-semibold']}>
                {t.nav[c.key] ?? c.key}
              </a>
            ))}
          </nav>
        </details>
        <script is:inline>
          (function (d) {
            var wide = window.matchMedia('(min-width: 64rem)');
            var set = function () { d.open = wide.matches; };
            set();
            wide.addEventListener('change', set);
          })(document.currentScript.previousElementSibling);
        </script>
      </div>
    )
  }
  {
    hasBody && d.bodyPosition === 'before' && (
      <div class="container-prose py-[var(--spacing-section)]">
        <div class="prose"><LocalizedBody locale={route.locale}><Content /></LocalizedBody></div>
      </div>
    )
  }
  <BlockRenderer blocks={firstIsHero ? d.sections.slice(1) : d.sections} locale={route.locale} portfolio={pf} />
  {
    hasBody && d.bodyPosition === 'after' && (
      sideNav ? (
        <div class="container-page flex flex-wrap items-start gap-x-18 gap-y-10 py-[var(--spacing-section)]">
          {/* A disclosure on phones (closed), the open side list from 64rem. */}
          <details open class="section-nav w-full min-w-0 flex-[1_1_15rem] rounded-small border border-line lg:sticky lg:top-[calc(var(--header-h,5rem)+1.5rem)] lg:rounded-none lg:border-0">
            <summary class="label flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 px-3.5 !text-ink-muted lg:min-h-0 lg:cursor-default lg:px-0 lg:pb-2.5">
              {inThisSection}
              <Icon name="chevron-down" class="section-nav-chevron size-5 transition lg:hidden" />
            </summary>
            <nav aria-label={inThisSection} class="flex flex-col gap-0.5 px-2 pb-2 lg:p-0">
              {sectionNav!.map((c) => (
                <a href={localizePath(c.href!, route.locale)} aria-current={c.href === route.basePath ? 'page' : undefined} class:list={['rounded-[10px] px-3.5 py-2.5 text-ocean no-underline hover:bg-mist', c.href === route.basePath ? 'bg-inspire-50 font-extrabold' : 'font-semibold']}>
                  {t.nav[c.key] ?? c.key}
                </a>
              ))}
            </nav>
          </details>
          <script is:inline>
            (function (d) {
              var wide = window.matchMedia('(min-width: 64rem)');
              var set = function () { d.open = wide.matches; };
              set();
              wide.addEventListener('change', set);
              d.querySelector('summary').addEventListener('click', function (e) { if (wide.matches) e.preventDefault(); });
            })(document.currentScript.previousElementSibling);
          </script>
          <div class="prose min-w-0 flex-[999_1_37.5rem] max-w-[50rem] text-[1.1875rem] leading-[1.7]"><LocalizedBody locale={route.locale}><Content /></LocalizedBody></div>
        </div>
      ) : (
        <div class="container-prose py-[var(--spacing-section)]">
          <div class="prose"><LocalizedBody locale={route.locale}><Content /></LocalizedBody></div>
        </div>
      )
    )
  }
  {showGiveBand && <GiveBand block={giveBand} locale={route.locale} />}
</Base>

<style>
  .section-nav summary::-webkit-details-marker { display: none; }
  .section-nav[open] :global(.section-nav-chevron) { transform: rotate(180deg); }
</style>
