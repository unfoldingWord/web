---
// One Sweet Publishing book: a Mist header (breadcrumbs, the book's name and
// its description), chapter jump pills, every illustration as a grid of
// rounded thumbnails (each opens the original JPEG in a new tab; each
// chapter's first thumbnail is its anchor), then the next three books and
// the Creative Commons credit line.
//
// The grid loads 480 px thumbnails lazily, never the ~1.5 MB originals.
// Images come from R2 (src/lib/sweet.ts), not from this repository.
import { render, getCollection, type CollectionEntry } from 'astro:content';
import { SITE } from '../../lib/site';
import { webPageNode, breadcrumbNode } from '../../lib/jsonld';
import { byCode, ui, fmt, localizePath } from '../../i18n';
import { sweetImageUrl, sweetParts } from '../../lib/sweet';
import { basePathFor, splitId, type Route } from '../../lib/routes';
import LocalizedBody from '../ui/LocalizedBody.astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';

interface Props {
  route: Route;
  crumbs: { name: string; href?: string }[];
}
const { route, crumbs } = Astro.props;
const entry = route.entry as CollectionEntry<'sweet'>;
const d = entry.data;
const t = ui(route.locale);
const { Content } = await render(entry);
const url = new URL(route.path, SITE.url).href;
const books = (await getCollection('sweet')).filter((b) => splitId(b.id).locale === 'en').sort((a, b) => a.data.order - b.data.order);
const idx = books.findIndex((b) => splitId(b.id).rest === splitId(entry.id).rest);
// "Related": the next three books.
const related = [1, 2, 3].map((n) => books[(idx + n) % books.length]).filter((b) => b && b !== books[idx]);
const bookHref = (b: (typeof books)[number]) => localizePath(basePathFor('sweet', splitId(b.id).rest), route.locale);
const countOf = (b: (typeof books)[number]) => b.data.chapters.reduce((n, c) => n + c.images.length, 0);
const first = d.chapters[0]?.images[0];
const cover = d.cover ?? first;
const slug = (c: string) => `ch-${c.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const chapterTitle = (c: string) => (/[a-z]/i.test(c) ? c : `${d.book} ${c}`);
const lang = byCode(route.locale).tag;
const jsonLd = [
  webPageNode({ url, title: d.title, description: d.description, lang: route.locale, type: 'CollectionPage', image: cover ? sweetImageUrl(cover, 'web') : undefined, breadcrumbId: `${url}#breadcrumb` }),
  breadcrumbNode(url, crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? route.path, SITE.url).href }))),
];
---

<Base locale={route.locale} basePath={route.basePath} title={d.title} description={d.description} ogImage={cover ? sweetImageUrl(cover, 'web') : undefined} jsonLd={jsonLd} translations={route.translations} fallback={route.fallback} noindex={route.noindex} pageType="sweet-publishing">
  <section class="bg-mist">
    <div class="container-page flex flex-col gap-[18px] pt-12 pb-14 md:pt-16 md:pb-[72px]">
      <Breadcrumbs items={crumbs} locale={route.locale} />
      <h1 class="max-w-[900px]">{d.book}</h1>
      {entry.body?.trim() && <div class="prose max-w-[760px] text-lead text-ink-muted"><LocalizedBody locale={route.locale}><Content /></LocalizedBody></div>}
    </div>
  </section>

  <div class="container-page flex flex-col gap-8 py-12 md:py-16">
    {
      d.chapters.length > 1 && (
        <nav class="flex flex-wrap items-center gap-2" aria-label={t.jumpToChapter}>
          <span class="me-2 text-[0.9375rem] font-extrabold text-ink-muted" aria-hidden="true">{t.jumpToChapter}</span>
          <ul class="flex flex-wrap gap-2">
            {d.chapters.map((c) => (
              <li>
                <a href={`#${slug(c.chapter)}`} class="uw-pill inline-flex min-w-11 items-center justify-center px-3.5 hover:bg-ocean hover:text-white">{c.chapter}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <ul class="grid grid-cols-3 gap-2.5 sm:grid-cols-4 md:grid-cols-6 md:gap-3 lg:grid-cols-8">
      {
        d.chapters.flatMap((c) =>
          c.images.map((name, i) => {
            const label = `${chapterTitle(c.chapter)}, ${sweetParts(name).frame}`;
            return (
              <li id={i === 0 && d.chapters.length > 1 ? slug(c.chapter) : undefined} class="scroll-mt-24">
                <a href={sweetImageUrl(name, 'jpg')} target="_blank" rel="noopener" class="block overflow-hidden rounded-small bg-white transition-opacity hover:opacity-85">
                  <img src={sweetImageUrl(name, 'thumb')} lang={lang} alt={fmt(t.sweetIllustration, { label })} width="480" height="353" loading="lazy" decoding="async" class="block aspect-[4/3] h-auto w-full object-cover" />
                </a>
              </li>
            );
          }),
        )
      }
    </ul>
  </div>

  <section class="bg-mist py-[var(--spacing-section)]" aria-labelledby="sweet-related">
    <div class="container-page flex flex-col gap-9">
      <h2 id="sweet-related">{t.related}</h2>
      <ul class="grid gap-6 sm:grid-cols-3">
        {
          related.map((b) => (
            <li class="uw-card flex flex-col gap-1 p-6">
              <a href={bookHref(b)} class="text-h4 font-black text-ocean hover:text-inspire-ink">{b.data.book}</a>
              <span class="text-ink-muted">{fmt(t.imagesCount, { count: countOf(b) })}</span>
              <span class="text-sm text-ink-muted">{b.data.testament === 'ot' ? t.oldTestament : t.newTestament}</span>
            </li>
          ))
        }
      </ul>
      <p class="text-sm text-ink-muted" set:html={t.sweetLicense} />
    </div>
  </section>
</Base>
