---
// One Sweet Publishing book, laid out like production: the page-title banner
// (the book's cover illustration under a 50% Ocean overlay, uppercase
// title), then every illustration as one centered flow of 115×85 thumbnails
// (a 3px white frame around each, 5px apart), each opening the original
// JPEG in a new tab, then a "related" row of the next three books.
//
// Kept from our site (production has none): breadcrumbs in the banner, the
// chapter jump links above the thumbnails (each chapter's first thumbnail is
// its anchor) and the Creative Commons credit line.
//
// The grid loads 480 px thumbnails lazily, never the ~1.5 MB originals.
// Images come from R2 (src/lib/sweet.ts), not from this repository.
import { render, getCollection, type CollectionEntry } from 'astro:content';
import { SITE } from '../../lib/site';
import { webPageNode, breadcrumbNode } from '../../lib/jsonld';
import { byCode, ui, fmt, localizePath } from '../../i18n';
import { sweetImageUrl, sweetParts } from '../../lib/sweet';
import { basePathFor, splitId, type Route } from '../../lib/routes';
import LocalizedBody from '../ui/LocalizedBody.astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';

interface Props {
  route: Route;
  crumbs: { name: string; href?: string }[];
}
const { route, crumbs } = Astro.props;
const entry = route.entry as CollectionEntry<'sweet'>;
const d = entry.data;
const t = ui(route.locale);
const { Content } = await render(entry);
const url = new URL(route.path, SITE.url).href;
const books = (await getCollection('sweet')).filter((b) => splitId(b.id).locale === 'en').sort((a, b) => a.data.order - b.data.order);
const idx = books.findIndex((b) => splitId(b.id).rest === splitId(entry.id).rest);
// Production's Jetpack "Related" shows the next three books.
const related = [1, 2, 3].map((n) => books[(idx + n) % books.length]).filter((b) => b && b !== books[idx]);
const bookHref = (b: (typeof books)[number]) => localizePath(basePathFor('sweet', splitId(b.id).rest), route.locale);
const countOf = (b: (typeof books)[number]) => b.data.chapters.reduce((n, c) => n + c.images.length, 0);
const first = d.chapters[0]?.images[0];
const cover = d.cover ?? first;
const slug = (c: string) => `ch-${c.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const chapterTitle = (c: string) => (/[a-z]/i.test(c) ? c : `${d.book} ${c}`);
const lang = byCode(route.locale).tag;
const jsonLd = [
  webPageNode({ url, title: d.title, description: d.description, lang: route.locale, type: 'CollectionPage', image: cover ? sweetImageUrl(cover, 'web') : undefined, breadcrumbId: `${url}#breadcrumb` }),
  breadcrumbNode(url, crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? route.path, SITE.url).href }))),
];
---

<Base locale={route.locale} basePath={route.basePath} title={d.title} description={d.description} ogImage={cover ? sweetImageUrl(cover, 'web') : undefined} jsonLd={jsonLd} translations={route.translations} fallback={route.fallback} noindex={route.noindex} pageType="sweet-publishing">
  <section class="uw-banner sweet-banner on-dark relative isolate flex min-h-[200px] items-center justify-center overflow-hidden px-10 py-10 text-center" style={cover ? `background-image:url(${sweetImageUrl(cover, 'web')})` : undefined}>
    <div class="absolute inset-0 -z-10 bg-ocean/50" aria-hidden="true" />
    <div class="sweet-crumbs absolute inset-x-0 top-2.5">
      <div class="container-page text-start"><Breadcrumbs items={crumbs} locale={route.locale} onDark /></div>
    </div>
    <h1 class="sweet-title uppercase">{d.book}</h1>
  </section>

  <div class="container-page py-10">
    {entry.body?.trim() && <div class="prose mb-5"><LocalizedBody locale={route.locale}><Content /></LocalizedBody></div>}
    {
      d.chapters.length > 1 && (
        <nav class="sweet-chapters mb-5 text-center" aria-label={t.jumpToChapter}>
          <span class="me-2">{t.jumpToChapter}:</span>
          <ul class="inline">
            {d.chapters.map((c) => (
              <li class="inline">
                <a href={`#${slug(c.chapter)}`} class="inline-block min-w-6 px-1">{c.chapter}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <ul class="flex flex-wrap justify-center gap-x-[5px] gap-y-[7px]">
      {
        d.chapters.flatMap((c) =>
          c.images.map((name, i) => {
            const label = `${chapterTitle(c.chapter)}, ${sweetParts(name).frame}`;
            return (
              <li id={i === 0 && d.chapters.length > 1 ? slug(c.chapter) : undefined} class="scroll-mt-24">
                <a href={sweetImageUrl(name, 'jpg')} target="_blank" rel="noopener" class="sweet-thumb block">
                  <img src={sweetImageUrl(name, 'thumb')} lang={lang} alt={fmt(t.sweetIllustration, { label })} width="109" height="79" loading="lazy" decoding="async" class="block h-[79px] w-[109px] object-cover" />
                </a>
              </li>
            );
          }),
        )
      }
    </ul>

    <div class="sweet-related">
      <h2 class="sweet-related-title"><a href={localizePath('/sweet-publishing/', route.locale)} lang={lang}>{t.sweetIndexTitle}</a></h2>
      <ul class="grid gap-x-0 gap-y-3.5 md:grid-cols-3">
        {
          related.map((b) => (
            <li class="sweet-related-item">
              <a href={bookHref(b)}>{b.data.book}</a>
              <span class="block">{fmt(t.imagesCount, { count: countOf(b) })}</span>
              <span class="block">{b.data.testament === 'ot' ? t.oldTestament : t.newTestament}</span>
            </li>
          ))
        }
      </ul>
      <p class="sweet-license" set:html={t.sweetLicense} />
    </div>
  </div>
</Base>

<style>
  /* Production shows the cover at its natural size (about 820px wide), tiled
     from the top-left corner, under the 50% Ocean overlay. */
  .sweet-banner { background-repeat: repeat; background-position: 0 0; background-size: 820px auto; }
  /* Banner title: production's h2 32/32/700 white, centered. Ours stays an h1. */
  .sweet-title { font-size: var(--text-h2); line-height: 1; font-weight: 700; color: #fff; margin: 0; text-wrap: wrap; }
  /* Breadcrumbs sit in the banner's top padding; no room on phones. */
  @media (max-width: 767px) { .sweet-crumbs { display: none; } }

  /* Chapter links: quiet, production's 900-weight Kindle links. */
  .sweet-chapters { font-size: 0.9375rem; line-height: 1.7; color: var(--color-tech); }
  .sweet-chapters a { font-weight: 900; }

  /* Thumbnail: production's 115×85 files carry a 3px white frame. */
  .sweet-thumb { padding: 3px; background: #fff; }

  /* Jetpack "Related": 12px bold headline under a short rule, then three
     14/20 columns (title link, then two quiet lines). */
  .sweet-related { margin-top: 61px; margin-bottom: 18px; }
  .sweet-related-title { display: inline-block; margin: 0 0 12px; padding-top: 12px; border-top: 1px solid var(--color-rule); font-size: 12px; line-height: 14.4px; font-weight: 700; font-style: italic; color: var(--color-tech); }
  .sweet-related-title a { color: inherit; font-weight: 700; }
  .sweet-related-title a:hover { color: var(--color-link-hover); }
  .sweet-related-item { font-size: 14px; line-height: 20px; font-weight: 300; color: var(--color-ink-muted); padding-inline-end: 20px; }
  .sweet-related-item a { font-weight: 400; }
  .sweet-license { margin-top: 20px; font-size: 14px; line-height: 20px; font-weight: 300; color: var(--color-ink-muted); }
  .sweet-license :global(a) { font-weight: 400; }
</style>
