---
// Site header: logo, main navigation, language switcher, Give button.
//
// Phone first. Below the `lg` breakpoint the navigation is a full-height
// panel opened by the Menu button, with each section as an expandable group.
// At `lg` and up the same list is a horizontal bar with dropdowns. One
// markup, one small script (no framework).
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-horizontal.png';
import { NAV, type NavItem } from '../../lib/site';
import { ui, localizePath } from '../../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: string;
  basePath: string;
  switcherPath?: string;
  /** Locales with a real translation of this page; others link to fallbacks. */
  translations?: string[];
}
const { locale, basePath, switcherPath = basePath, translations } = Astro.props;
const t = ui(locale);
const label = (key: string) => (t.nav as Record<string, string>)[key] ?? key;
const href = (item: NavItem) => (item.external ? item.href! : localizePath(item.href!, locale));
const isCurrent = (item: NavItem): boolean =>
  (!!item.href && !item.external && item.href === basePath) || (item.children ?? []).some(isCurrent);
---

{/* Solid background, no backdrop-filter: a filter on the header would make
    it the containing block for the fixed-position phone menu panel and clip
    the panel to the header's height. */}
<header class="site-header sticky top-0 z-40 border-b border-line bg-white">
  <div class="container-page flex h-16 items-center gap-3 lg:h-20">
    <a href={localizePath('/', locale)} class="me-auto flex shrink-0 items-center" aria-label={`${t.siteName} — ${t.home}`}>
      <Image src={logo} alt="unfoldingWord" width={200} height={35} loading="eager" fetchpriority="high" class="h-7 w-auto lg:h-8" />
    </a>

    <nav id="site-nav" class="site-nav" aria-label={t.mainNav} data-open="false">
      <ul class="nav-list">
        {
          NAV.map((item, i) => (
            <li class="nav-item" data-current={isCurrent(item) ? 'true' : undefined}>
              {item.children ? (
                <>
                  <button type="button" class="nav-top" aria-expanded="false" aria-controls={`nav-sub-${i}`}>
                    {label(item.key)}
                    <Icon name="chevron-down" class="size-4 transition-transform" />
                  </button>
                  <ul id={`nav-sub-${i}`} class="nav-sub" hidden>
                    {item.children.map((child) => (
                      <li>
                        <a href={href(child)} aria-current={child.href === basePath ? 'page' : undefined} {...(child.external ? { rel: 'noopener' } : {})}>
                          {label(child.key)}
                          {child.external && <Icon name="external" class="size-3.5 opacity-60" />}
                        </a>
                        {child.children && (
                          <ul class="nav-sub-nested">
                            {child.children.map((g) => (
                              <li>
                                <a href={href(g)} aria-current={g.href === basePath ? 'page' : undefined}>
                                  {label(g.key)}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a class="nav-top" href={href(item)} aria-current={item.href === basePath ? 'page' : undefined}>
                  {label(item.key)}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mt-6 border-t border-line pt-6 lg:hidden">
        <LanguageSwitcher locale={locale} basePath={switcherPath} translations={translations} variant="list" />
      </div>
    </nav>

    <a href="/search/" class="inline-flex size-11 items-center justify-center rounded-full text-ocean hover:bg-inspire-50" aria-label={t.search}>
      <Icon name="search" class="size-5.5" />
    </a>
    <div class="hidden lg:block">
      <LanguageSwitcher locale={locale} basePath={switcherPath} translations={translations} />
    </div>
    <a href={localizePath('/give/', locale)} class="uw-btn uw-btn-give !min-h-10 !px-4 !py-2 text-sm lg:!min-h-11 lg:!px-5">{t.donate}</a>
    <button type="button" class="menu-toggle -me-2 inline-flex size-11 items-center justify-center rounded-full text-ocean lg:hidden" aria-controls="site-nav" aria-expanded="false">
      <span class="sr-only" data-label-open>{t.menu}</span>
      <span class="sr-only hidden" data-label-close>{t.closeMenu}</span>
      <Icon name="menu" class="icon-open size-7" />
      <Icon name="close" class="icon-close hidden size-7" />
    </button>
  </div>
</header>

<style>
  @reference '../../styles/global.css';

  /* ---- Phone / tablet: slide-down panel ---- */
  .site-nav {
    position: fixed;
    inset: 4rem 0 0 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-white, #fff);
    padding: 1rem var(--spacing-gutter) 3rem;
    display: none;
  }
  .site-nav[data-open='true'] { display: block; }
  .nav-list { display: flex; flex-direction: column; }
  .nav-item { border-bottom: 1px solid var(--color-line); }
  .nav-top {
    display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 0.5rem;
    min-height: 3.25rem; padding-block: 0.75rem;
    font-family: var(--font-heading); font-weight: 800; font-size: 1.125rem;
    color: var(--color-ocean); text-decoration: none; text-align: start;
  }
  .nav-top[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }
  .nav-sub { padding-bottom: 0.75rem; }
  .nav-sub a, .nav-sub-nested a {
    display: flex; align-items: center; gap: 0.35rem;
    min-height: 2.75rem; padding: 0.5rem 0.75rem; border-radius: 0.5rem;
    color: var(--color-ink); text-decoration: none; font-weight: 600;
  }
  .nav-sub a:hover, .nav-sub-nested a:hover { background: var(--color-mist); color: var(--color-ocean); }
  .nav-sub a[aria-current='page'], .nav-sub-nested a[aria-current='page'] { color: var(--color-ocean); background: var(--color-inspire-50); }
  .nav-sub-nested { padding-inline-start: 1rem; border-inline-start: 2px solid var(--color-inspire-100); margin-inline-start: 0.75rem; }
  .nav-sub-nested a { font-weight: 500; min-height: 2.5rem; }
  :global(html.nav-open) { overflow: hidden; }

  /* ---- Desktop: horizontal bar with dropdowns ---- */
  @media (min-width: 64rem) {
    .site-nav { position: static; display: block; padding: 0; overflow: visible; background: none; }
    .nav-list { flex-direction: row; align-items: center; gap: 0.125rem; }
    .nav-item { position: relative; border: 0; }
    .nav-top {
      width: auto; min-height: 2.75rem; padding: 0.5rem 0.65rem; border-radius: 999px;
      font-size: 0.9375rem; white-space: nowrap;
    }
    .nav-top:hover, .nav-item[data-current='true'] > .nav-top { background: var(--color-inspire-50); }
    .nav-sub {
      position: absolute; top: calc(100% + 0.5rem); inset-inline-start: 0; min-width: 17rem; max-height: 75vh; overflow-y: auto;
      padding: 0.5rem; background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius-card);
      box-shadow: var(--shadow-raised);
    }
    .nav-item:last-child .nav-sub, .nav-item:nth-last-child(2) .nav-sub { inset-inline-start: auto; inset-inline-end: 0; }
    .nav-sub a { font-size: 0.9375rem; }
  }
  @media (min-width: 64rem) and (max-width: 80rem) {
    .nav-top { padding-inline: 0.45rem; font-size: 0.875rem; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const nav = header?.querySelector<HTMLElement>('#site-nav');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const desktop = window.matchMedia('(min-width: 64rem)');

  function setMenu(open: boolean) {
    if (!nav || !toggle) return;
    nav.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
    toggle.querySelector('[data-label-open]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-label-close]')?.classList.toggle('hidden', !open);
    document.documentElement.classList.toggle('nav-open', open && !desktop.matches);
  }
  toggle?.addEventListener('click', () => setMenu(nav?.dataset.open !== 'true'));

  const tops = [...(nav?.querySelectorAll<HTMLButtonElement>('button.nav-top') ?? [])];
  function closeAll(except?: HTMLButtonElement) {
    for (const b of tops) {
      if (b === except) continue;
      b.setAttribute('aria-expanded', 'false');
      const sub = document.getElementById(b.getAttribute('aria-controls')!);
      if (sub) sub.hidden = true;
    }
  }
  for (const b of tops) {
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') === 'true';
      if (desktop.matches) closeAll(b);
      b.setAttribute('aria-expanded', String(!open));
      const sub = document.getElementById(b.getAttribute('aria-controls')!);
      if (sub) sub.hidden = open;
    });
  }
  document.addEventListener('click', (e) => {
    if (desktop.matches && nav && !nav.contains(e.target as Node)) closeAll();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openTop = tops.find((b) => b.getAttribute('aria-expanded') === 'true');
    if (desktop.matches && openTop) {
      closeAll();
      openTop.focus();
    } else if (nav?.dataset.open === 'true') {
      setMenu(false);
      toggle?.focus();
    }
  });
  desktop.addEventListener('change', () => {
    setMenu(false);
    closeAll();
  });
</script>
