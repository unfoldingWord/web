---
// Site header: a white sticky bar with a line under it. Logo at the start;
// then the main navigation (dropdowns for the sections), search, language
// and the Give button.
//
// When the navigation does not fit on one row (phones, tablets, long
// translated menus) it becomes a full-height panel opened by the menu
// toggle, with the sections as accordions. One markup, one small script.
import { Image } from 'astro:assets';
import logo from '../../assets/brand/uw-logo-color.svg';
import { NAV, type NavItem, fallbackAttrs, ownsUiString } from '../../lib/site';
import { ui, localizePath, fmt } from '../../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: string;
  basePath: string;
  switcherPath?: string;
  /** Locales with a real translation of this page; others link to fallbacks. */
  translations?: string[];
}
const { locale, basePath, switcherPath = basePath, translations } = Astro.props;
const t = ui(locale);
const label = (key: string) => (t.nav as Record<string, string>)[key] ?? key;
// A label that falls back to English is marked so it reads left to right.
const la = (key: string) => fallbackAttrs(locale, `nav.${key}`);
// The flyout toggle sits beside the link with the same words; name it apart.
// Until a locale translates the phrase, the whole name stays in English
// rather than mixing two languages in one label.
const showPages = (key: string) =>
  ownsUiString(locale, 'nav.showPages')
    ? fmt((t.nav as Record<string, string>).showPages, { name: label(key) })
    : fmt(ui('en').nav.showPages ?? 'Show {name} pages', { name: (ui('en').nav as Record<string, string>)[key] ?? key });
const href = (item: NavItem) => (item.external ? item.href! : localizePath(item.href!, locale));
const current = (item: NavItem) => (!!item.href && !item.external && item.href === basePath ? 'page' : undefined);
const ext = (item: NavItem) => (item.external ? { target: '_blank', rel: 'noopener' } : {});
// A section is "current" when the page is one of its links.
const inSection = (item: NavItem): boolean => !!item.children?.some((c) => current(c) || inSection(c));
const CHEVRON = 'm6 9 6 6 6-6';
---

<header class="site-header">
  <div class="hdr-row">
    <a href={localizePath('/', locale)} class="hdr-logo" aria-label={`${t.siteName} — ${t.home}`}>
      <Image src={logo} alt="unfoldingWord" height={36} width={Math.round((36 * logo.width) / logo.height)} loading="eager" fetchpriority="high" />
    </a>

    <div class="hdr-end">
      <nav id="site-nav" class="site-nav" aria-label={t.mainNav} data-open="false">
        <ul class="nav-list">
          {
            NAV.map((item, i) => (
              <li class="nav-item">
                {item.children ? (
                  <>
                    <button type="button" class="nav-top" aria-expanded="false" aria-controls={`nav-sub-${i}`} data-section-current={inSection(item) ? '' : undefined}>
                      <span {...la(item.key)}>{label(item.key)}</span>
                      <span class="sub-arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d={CHEVRON} /></svg>
                      </span>
                    </button>
                    <ul id={`nav-sub-${i}`} class="nav-sub" hidden>
                      {item.children.map((child, j) =>
                        child.children ? (
                          <li class="has-flyout">
                            <a class="nav-sub-link" href={href(child)} aria-current={current(child)}>
                              <span {...la(child.key)}>{label(child.key)}</span>
                            </a>
                            <button type="button" class="flyout-toggle" aria-expanded="false" aria-controls={`nav-sub-${i}-${j}`} aria-label={showPages(child.key)}>
                              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={CHEVRON} /></svg>
                            </button>
                            <ul id={`nav-sub-${i}-${j}`} class="nav-sub nav-flyout" hidden>
                              {child.children.map((g) => (
                                <li>
                                  <a class="nav-sub-link" href={href(g)} aria-current={current(g)}>
                                    <span {...la(g.key)}>{label(g.key)}</span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </li>
                        ) : (
                          <li>
                            <a class="nav-sub-link" href={href(child)} aria-current={current(child)} {...ext(child)}>
                              <span {...la(child.key)}>{label(child.key)}</span>
                            </a>
                          </li>
                        ),
                      )}
                    </ul>
                  </>
                ) : (
                  <a class="nav-top" href={href(item)} aria-current={current(item)}>
                    <span {...la(item.key)}>{label(item.key)}</span>
                  </a>
                )}
              </li>
            ))
          }
          <li class="nav-item nav-search">
            <a class="nav-top" href="/search/" aria-current={basePath === '/search/' ? 'page' : undefined}>
              <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
              <span class="nav-search-label">{t.search}</span>
            </a>
          </li>
          <LanguageSwitcher locale={locale} basePath={switcherPath} translations={translations} />
        </ul>
      </nav>

      <a href={localizePath('/give/', locale)} class="uw-btn uw-btn-give hdr-give">{t.donate}</a>

      <button type="button" class="menu-toggle" aria-controls="site-nav" aria-expanded="false">
        <span class="sr-only" data-label-open>{t.menu}</span>
        <span class="sr-only hidden" data-label-close>{t.closeMenu}</span>
        <svg class="icon-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg class="icon-close hidden" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </div>
</header>

{/* Decide bar vs. menu toggle before the first paint: the bar is used from
    1024px up when the whole row fits beside the logo (translated menus may
    not). data-collapsed switches the header to the toggle layout. Runs again
    on resize and font load. */}
<script is:inline>
  (function () {
    var h = document.querySelector('.site-header');
    if (!h) return;
    var wide = window.matchMedia('(min-width: 1024px)');
    var last = null;
    function fit() {
      var collapsed = false;
      if (wide.matches) {
        h.removeAttribute('data-collapsed');
        var row = h.querySelector('.hdr-row');
        var logo = h.querySelector('.hdr-logo');
        var end = h.querySelector('.hdr-end');
        var cs = getComputedStyle(row);
        var avail = row.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
        var need = logo.getBoundingClientRect().width + 24 + end.scrollWidth;
        collapsed = need > avail + 0.5;
      }
      if (collapsed) h.setAttribute('data-collapsed', '');
      else h.removeAttribute('data-collapsed');
      var mode = wide.matches && !collapsed ? 'bar' : 'panel';
      if (mode !== last) {
        last = mode;
        h.dataset.mode = mode;
        h.dispatchEvent(new CustomEvent('header:mode'));
      }
    }
    fit();
    window.addEventListener('resize', fit);
    if (document.fonts) {
      document.fonts.ready.then(fit);
      document.fonts.addEventListener && document.fonts.addEventListener('loadingdone', fit);
    }
  })();
</script>

<style is:global>
  /* Scoped by hand to .site-header so LanguageSwitcher's item shares it. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #fff;
    border-bottom: 1px solid var(--color-line);
  }
  .site-header .hdr-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    max-width: calc(var(--container-page) + 2 * var(--spacing-gutter));
    min-height: 68px;
    margin-inline: auto;
    padding: 10px var(--spacing-gutter);
  }
  .site-header .hdr-logo { display: flex; align-items: center; flex: 0 0 auto; border-radius: 6px; }
  .site-header .hdr-logo img { display: block; height: 36px; width: auto; max-width: 100%; object-fit: contain; object-position: left center; }
  [dir='rtl'] .site-header .hdr-logo img { object-position: right center; }
  @media (max-width: 400px) { .site-header .hdr-logo img { height: 30px; } }

  .site-header .hdr-end { display: flex; align-items: center; justify-content: flex-end; gap: 12px; flex: none; }
  @media (min-width: 768px) { .site-header .hdr-end { gap: 20px; } }
  .site-header .hdr-give { min-height: 44px; padding: 0.6rem 1.4rem; white-space: nowrap; }

  .site-header .menu-toggle {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 44px; height: 44px; border-radius: 999px;
    color: var(--color-ocean); background: transparent;
  }
  .site-header .menu-toggle svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .site-header .menu-toggle:hover { background: var(--color-mist); }

  .site-header .sub-arrow { display: inline-flex; margin-inline-start: 4px; transition: transform 0.2s; }
  .site-header .sub-arrow svg, .site-header .flyout-toggle svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.25; stroke-linecap: round; stroke-linejoin: round; }
  .site-header [aria-expanded='true'] > .sub-arrow, .site-header .flyout-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
  .site-header .search-icon { width: 20px; height: 20px; margin-inline-end: 8px; fill: none; stroke: currentColor; stroke-width: 2.25; stroke-linecap: round; }
  .site-header .lang-short { display: none; }
  .site-header .lang-globe { width: 20px; height: 20px; margin-inline-end: 8px; fill: none; stroke: currentColor; stroke-width: 2; }

  /* ---- Panel: full height under the bar, sections as accordions ---- */
  .site-header .site-nav {
    position: absolute; top: 100%; inset-inline: 0; z-index: 50;
    height: calc(100vh - var(--header-h, 69px)); overflow-y: auto; overscroll-behavior: contain;
    padding: 8px var(--spacing-gutter) 40px;
    background: #fff;
    visibility: hidden; opacity: 0;
    transition: opacity 0.2s, visibility 0s linear 0.2s;
  }
  @supports (height: 100dvh) { .site-header .site-nav { height: calc(100dvh - var(--header-h, 69px)); } }
  .site-header .site-nav[data-open='true'] { visibility: visible; opacity: 1; transition: opacity 0.2s, visibility 0s; }
  .site-header .nav-list, .site-header .nav-sub { list-style: none; margin: 0; padding: 0; }
  .site-header .nav-list { max-width: 640px; margin-inline: auto; }
  .site-header .nav-list > .nav-item { border-bottom: 1px solid var(--color-line); }
  .site-header .nav-top {
    display: flex; width: 100%; min-height: 56px; align-items: center; justify-content: space-between;
    padding: 12px 4px; margin: 0;
    font-family: var(--font-heading); font-size: 1.125rem; font-weight: 700; line-height: 1.3;
    color: var(--color-ocean); background: transparent; text-decoration: none; text-align: start;
  }
  .site-header .nav-search .nav-top, .site-header .nav-lang .nav-top { justify-content: flex-start; }
  .site-header .nav-lang .sub-arrow { margin-inline-start: auto; }
  .site-header .nav-item > .nav-sub { padding: 0 0 12px; }
  .site-header .nav-sub-link {
    display: flex; align-items: center; min-height: 44px; padding: 8px 16px;
    font-size: 1rem; font-weight: 600; line-height: 1.35;
    color: var(--color-ocean); text-decoration: none; border-radius: var(--radius-input);
  }
  .site-header .nav-top:hover, .site-header .nav-sub-link:hover { color: var(--color-inspire-ink); }
  .site-header .nav-sub-link:hover, .site-header .nav-sub-link[aria-current] { background: var(--color-mist); }
  .site-header .nav-sub-link[aria-current] { color: var(--color-ocean); font-weight: 800; }
  .site-header .nav-top[aria-current] { color: var(--color-inspire-ink); }
  .site-header .has-flyout { display: flex; flex-wrap: wrap; align-items: center; }
  .site-header .has-flyout > .nav-sub-link { flex: 1; }
  .site-header .flyout-toggle {
    display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px;
    color: var(--color-ocean); background: transparent; border-radius: 999px;
  }
  .site-header .flyout-toggle:hover { background: var(--color-mist); }
  .site-header .has-flyout > .nav-flyout { flex: 0 0 100%; padding-inline-start: 16px; }
  html.nav-open { overflow: hidden; }

  /* ---- Bar (1024px and up, when it fits) ---- */
  @media (min-width: 1024px) {
    .site-header:not([data-collapsed]) .menu-toggle { display: none; }
    .site-header:not([data-collapsed]) .site-nav {
      position: static; height: auto; overflow: visible; padding: 0; visibility: visible; opacity: 1; transition: none; background: none;
    }
    .site-header:not([data-collapsed]) .nav-list { display: flex; align-items: center; flex-wrap: nowrap; gap: 26px; max-width: none; }
    .site-header:not([data-collapsed]) .nav-list > .nav-item { position: relative; border: 0; }
    .site-header:not([data-collapsed]) .nav-top {
      position: relative; width: auto; min-height: 44px; padding: 8px 0; white-space: nowrap;
      font-size: 1rem; font-weight: 600; justify-content: center;
    }
    .site-header:not([data-collapsed]) .nav-top::after {
      content: ''; position: absolute; inset-inline: 0; bottom: 4px; height: 2px; border-radius: 2px;
      background: var(--color-inspire); opacity: 0; transition: opacity 0.2s;
    }
    .site-header:not([data-collapsed]) .nav-top:hover::after,
    .site-header:not([data-collapsed]) .nav-top[aria-expanded='true']::after,
    .site-header:not([data-collapsed]) .nav-top[aria-current]::after,
    .site-header:not([data-collapsed]) .nav-top[data-section-current]::after { opacity: 1; }
    .site-header:not([data-collapsed]) .nav-top:hover, .site-header:not([data-collapsed]) .nav-top[aria-current] { color: var(--color-ocean); }
    .site-header:not([data-collapsed]) .sub-arrow svg { width: 14px; height: 14px; }
    .site-header:not([data-collapsed]) .nav-search .nav-top, .site-header:not([data-collapsed]) .nav-lang .nav-top { min-width: 44px; }
    .site-header:not([data-collapsed]) .search-icon { margin: 0; }
    .site-header:not([data-collapsed]) .nav-lang .sub-arrow { margin-inline-start: 2px; }
    .site-header:not([data-collapsed]) .nav-search-label, .site-header:not([data-collapsed]) .lang-long {
      position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
    }
    .site-header:not([data-collapsed]) .lang-short { display: inline; font-size: 0.9375rem; }
    .site-header:not([data-collapsed]) .lang-globe { width: 18px; height: 18px; margin-inline-end: 5px; }

    /* Dropdown panels: a raised white card. */
    .site-header:not([data-collapsed]) .nav-sub {
      position: absolute; top: calc(100% + 12px); inset-inline-start: -16px; z-index: 3;
      width: max-content; min-width: 220px; max-width: 360px; padding: 8px;
      background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius-card); box-shadow: var(--shadow-raised);
    }
    .site-header:not([data-collapsed]) .nav-item > .nav-sub::before {
      /* Bridge the gap so the pointer can travel to the panel. */
      content: ''; position: absolute; inset-inline: 0; bottom: 100%; height: 14px;
    }
    .site-header:not([data-collapsed]) .nav-sub.align-end, .site-header:not([data-collapsed]) .nav-lang > .nav-sub { inset-inline-start: auto; inset-inline-end: -16px; }
    .site-header:not([data-collapsed]) .nav-lang > .nav-sub { max-height: calc(100vh - 100px); overflow-y: auto; }
    .site-header:not([data-collapsed]) .nav-sub-link { min-height: 40px; padding: 8px 14px; font-size: 0.9375rem; white-space: nowrap; }
    .site-header:not([data-collapsed]) .has-flyout { position: relative; flex-wrap: nowrap; }
    .site-header:not([data-collapsed]) .has-flyout > .nav-sub-link { padding-inline-end: 4px; }
    .site-header:not([data-collapsed]) .flyout-toggle { width: 36px; height: 36px; }
    .site-header:not([data-collapsed]) .flyout-toggle svg { transform: rotate(-90deg); }
    [dir='rtl'] .site-header:not([data-collapsed]) .flyout-toggle svg { transform: rotate(90deg); }
    .site-header:not([data-collapsed]) .nav-flyout { top: -9px; inset-inline-start: calc(100% + 8px); padding: 8px; }
  }

  /* Myanmar glyphs need more line height. */
  html[data-script='myanmar'] .site-header .nav-top, html[data-script='myanmar'] .site-header .nav-sub-link { line-height: 1.8; }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const nav = header?.querySelector<HTMLElement>('#site-nav');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const isBar = () => header?.dataset.mode === 'bar';

  // Anchor links scroll their target below the sticky header. global.css
  // reads its height from --header-h (5rem until this runs).
  if (header && 'ResizeObserver' in window) {
    new ResizeObserver(([entry]) => {
      document.documentElement.style.setProperty('--header-h', `${Math.ceil(entry.borderBoxSize[0].blockSize)}px`);
    }).observe(header);
  }

  function setMenu(open: boolean) {
    if (!nav || !toggle) return;
    nav.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
    toggle.querySelector('[data-label-open]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-label-close]')?.classList.toggle('hidden', !open);
    document.documentElement.classList.toggle('nav-open', open && !isBar());
    setPageInert(open && !isBar());
  }

  // While the full-height panel is open it covers the page: the rest of the
  // page is made inert, and Tab wraps between the header's first and last
  // controls (logo ... menu toggle), so focus never lands on hidden content.
  const madeInert: Element[] = [];
  function setPageInert(on: boolean) {
    for (const el of madeInert.splice(0)) el.removeAttribute('inert');
    if (!on || !header) return;
    for (let node: Element | null = header; node && node !== document.body; node = node.parentElement) {
      for (const sib of node.parentElement?.children ?? []) {
        if (sib === node || sib.hasAttribute('inert') || sib.tagName === 'SCRIPT' || sib.tagName === 'STYLE') continue;
        sib.setAttribute('inert', '');
        madeInert.push(sib);
      }
    }
  }
  const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
  header?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || nav?.dataset.open !== 'true' || isBar()) return;
    const items = [...header!.querySelectorAll<HTMLElement>(FOCUSABLE)].filter((el) => el.getClientRects().length > 0);
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
  toggle?.addEventListener('click', () => {
    const open = nav?.dataset.open !== 'true';
    setMenu(open);
    if (open) nav?.querySelector<HTMLElement>('.nav-top')?.focus();
  });

  // Every disclosure button in the menu: top-level sections, the language
  // item, and the "For translators" flyout.
  const tops = [...(nav?.querySelectorAll<HTMLButtonElement>('button.nav-top') ?? [])];
  const flyouts = [...(nav?.querySelectorAll<HTMLButtonElement>('button.flyout-toggle') ?? [])];
  const panelOf = (b: HTMLButtonElement) => document.getElementById(b.getAttribute('aria-controls')!);
  const hoverOpened = new WeakSet<HTMLButtonElement>();

  function set(b: HTMLButtonElement, open: boolean) {
    b.setAttribute('aria-expanded', String(open));
    const panel = panelOf(b);
    if (!panel) return;
    panel.hidden = !open;
    if (!open) {
      hoverOpened.delete(b);
      panel.querySelectorAll<HTMLButtonElement>('button.flyout-toggle').forEach((f) => set(f, false));
      return;
    }
    // Keep a dropdown on screen: align it to the item's end if it would overflow.
    if (isBar() && panel.classList.contains('nav-sub') && !panel.classList.contains('nav-flyout')) {
      panel.classList.remove('align-end');
      const r = panel.getBoundingClientRect();
      if (r.right > document.documentElement.clientWidth || r.left < 0) panel.classList.add('align-end');
    }
  }
  function closeAll(except?: HTMLButtonElement) {
    for (const b of tops) if (b !== except) set(b, false);
  }

  for (const b of tops) {
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') === 'true';
      if (isBar()) {
        closeAll(b);
        // A click on a panel the pointer just opened keeps it open.
        if (open && hoverOpened.has(b)) {
          hoverOpened.delete(b);
          return;
        }
      }
      set(b, !open);
    });
  }
  for (const f of flyouts) f.addEventListener('click', () => set(f, f.getAttribute('aria-expanded') !== 'true'));

  // Bar layout: open on hover, close 250ms after the pointer leaves.
  function hover(li: HTMLElement, b: HTMLButtonElement, single: boolean) {
    let timer: number | undefined;
    li.addEventListener('pointerenter', (e) => {
      if (!isBar() || e.pointerType !== 'mouse') return;
      clearTimeout(timer);
      if (b.getAttribute('aria-expanded') !== 'true') {
        if (single) closeAll(b);
        set(b, true);
        hoverOpened.add(b);
      }
    });
    li.addEventListener('pointerleave', (e) => {
      if (!isBar() || e.pointerType !== 'mouse') return;
      timer = window.setTimeout(() => {
        if (!li.contains(document.activeElement) || hoverOpened.has(b)) set(b, false);
      }, 250);
    });
  }
  for (const b of tops) hover(b.parentElement!, b, true);
  for (const f of flyouts) hover(f.parentElement!, f, false);

  // Bar layout: close a dropdown when keyboard focus leaves it.
  nav?.addEventListener('focusout', (e) => {
    if (!isBar()) return;
    const to = e.relatedTarget as Node | null;
    for (const b of tops) {
      if (b.getAttribute('aria-expanded') === 'true' && to && !b.parentElement!.contains(to)) set(b, false);
    }
  });
  document.addEventListener('click', (e) => {
    if (isBar() && nav && !nav.contains(e.target as Node)) closeAll();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openFly = flyouts.find((f) => f.getAttribute('aria-expanded') === 'true' && f.parentElement!.contains(document.activeElement));
    if (openFly) {
      set(openFly, false);
      openFly.focus();
      return;
    }
    const openTop = tops.find((b) => b.getAttribute('aria-expanded') === 'true');
    if (isBar() && openTop) {
      closeAll();
      openTop.focus();
    } else if (nav?.dataset.open === 'true') {
      setMenu(false);
      toggle?.focus();
    }
  });
  header?.addEventListener('header:mode', () => {
    setMenu(false);
    closeAll();
  });
</script>
