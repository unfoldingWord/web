---
// Language switcher, rendered as the last item of the header's main menu
// (Header.astro styles it and its script opens it). Every locale links to
// this page's URL in that locale; where the page has no translation yet the
// link still works (the fallback page shows the interface in that language
// and the body in English).
//
// In the bar layout the item shows a globe and the short code ("EN"); in the
// menu panel it reads "Language: English". The accessible name always
// contains the visible text, so voice-control users can say "click EN" or
// "click Language" (WCAG 2.5.3).
import { locales, localizePath, ui, byCode } from '../../i18n';

interface Props {
  locale: string;
  basePath: string;
  translations?: string[];
}
const { locale, basePath } = Astro.props;
const t = ui(locale);
const current = byCode(locale);
const CHEVRON = 'm6 9 6 6 6-6';
---

<li class="nav-item nav-lang">
  <button type="button" class="nav-top" aria-expanded="false" aria-controls="lang-menu">
    <svg class="lang-globe" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
    <span class="lang-short"><span class="sr-only">{t.language}: </span><span lang="en">{current.code.toUpperCase()}</span><span class="sr-only"> (<span lang={current.tag}>{current.name}</span>)</span></span>
    <span class="lang-long">{t.language}: <span lang={current.tag}>{current.name}</span></span>
    <span class="sub-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={CHEVRON} /></svg></span>
  </button>
  <ul id="lang-menu" class="nav-sub" hidden>
    {
      locales.map((l) => (
        <li>
          <a class="nav-sub-link" href={localizePath(basePath, l.code)} lang={l.tag} hreflang={l.tag} aria-current={l.code === locale ? 'true' : undefined}>
            <span dir={l.dir}>{l.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</li>
