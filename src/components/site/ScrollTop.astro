---
// Back-to-top button: a round Ocean button fixed near the bottom corner,
// shown after 100px of scrolling, hidden on phones (640px and below).
import { ui } from '../../i18n';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = ui(locale);
---

<button type="button" class="scroll-top" aria-label={t.footer.backToTop} title={t.footer.backToTop} data-scroll-top>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path d="m6 15 6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</button>

<style>
  .scroll-top {
    position: fixed;
    inset-inline-end: 24px;
    bottom: 32px;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    color: #fff;
    background: var(--color-ocean);
    box-shadow: var(--shadow-raised);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s, background-color 0.2s, visibility 0s linear 0.2s;
  }
  .scroll-top.is-visible {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.2s, background-color 0.2s;
  }
  .scroll-top:hover {
    background: var(--color-ocean-700);
  }
  @media (max-width: 640px) {
    .scroll-top,
    .scroll-top.is-visible {
      visibility: hidden;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-scroll-top]');
  if (btn) {
    const update = () => btn.classList.toggle('is-visible', window.scrollY > 100);
    update();
    window.addEventListener('scroll', update, { passive: true });
    btn.addEventListener('click', (e) => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      // Keyboard users (detail 0: Enter or Space) continue from the top of
      // the page, not from a button that is about to hide.
      if (e.detail === 0) document.querySelector<HTMLElement>('.skip-link')?.focus({ preventScroll: true });
    });
  }
</script>
