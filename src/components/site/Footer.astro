---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-horizontal-reversed.png';
import { SITE, FOOTER_LINKS } from '../../lib/site';
import { ui, localizePath, fmt } from '../../i18n';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = ui(locale);
const nav = t.nav as Record<string, string>;
const year = new Date().getUTCFullYear();
const socials = [
  { name: 'Facebook', icon: 'facebook', href: SITE.social.facebook },
  { name: 'Instagram', icon: 'instagram', href: SITE.social.instagram },
  { name: 'YouTube', icon: 'youtube', href: SITE.social.youtube },
  { name: 'LinkedIn', icon: 'linkedin', href: SITE.social.linkedin },
  { name: 'X', icon: 'x', href: SITE.social.x },
];
---

<footer class="on-dark mt-auto bg-ocean-900 text-white">
  <div class="container-page grid gap-10 py-14 md:grid-cols-12 lg:py-20">
    <div class="md:col-span-5">
      <Image src={logo} alt="unfoldingWord" width={220} height={38} class="h-9 w-auto" />
      <p class="mt-5 max-w-md text-white/85">{t.footer.mission}</p>
      <p class="mt-6 text-sm font-bold uppercase tracking-wider text-cultivate">{t.footer.followUs}</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} rel="noopener me" class="inline-flex size-11 items-center justify-center rounded-full bg-white/10 !text-white hover:bg-inspire">
                <Icon name={s.icon} class="size-5" label={s.name} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <nav class="md:col-span-3" aria-label={t.footerNav}>
      <p class="text-sm font-bold uppercase tracking-wider text-cultivate">{t.footer.quickLinks}</p>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 md:grid-cols-1">
        {
          FOOTER_LINKS.map((l) => (
            <li>
              <a href={localizePath(l.href!, locale)} class="inline-flex min-h-10 items-center !text-white/90 no-underline hover:!text-white hover:underline">
                {nav[l.key] ?? l.key}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="md:col-span-4">
      <p class="text-white/85">{t.footer.thanks}</p>
      <address class="mt-5 text-white/85 not-italic">
        {SITE.address.streetAddress}<br />
        {SITE.address.addressLocality}, {SITE.address.addressRegion} {SITE.address.postalCode}<br />
        <a href={`tel:${SITE.telephone}`} class="inline-flex min-h-10 items-center">{SITE.telephoneDisplay}</a>
      </address>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          SITE.trust.map((b) => (
            <li>
              <a href={b.href} rel="noopener" class="inline-flex min-h-10 items-center rounded-full border border-white/30 px-3 text-sm !text-white no-underline hover:bg-white/10" title={b.label}>
                {b.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15">
    <div class="container-page flex flex-col gap-3 py-6 text-sm text-white/75 md:flex-row md:items-center md:justify-between">
      <p class="max-w-3xl">{t.footer.trust}</p>
      <div class="flex flex-wrap gap-x-5 gap-y-1">
        <span>{fmt(t.footer.copyright, { year })}</span>
        <a href="/privacy/" class="!text-white/85">{t.footer.privacy}</a>
        <a href="/terms-of-use/" class="!text-white/85">{t.footer.terms}</a>
        <a href="/charitable-solicitation-disclosures/" class="!text-white/85">{t.footer.disclosures}</a>
      </div>
    </div>
  </div>
</footer>
