---
// Site footer, matching production's Elementor footer: Tech background, a
// 1000px box with three equal, vertically centered columns (logo, mission and
// social icons; Quick Links and thank-you; accountability seals and the
// 501(c)3 text), then one centered copyright line. Our legal links (Privacy,
// Terms, Disclosures) sit in that line and are styled like it.
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-horizontal-reversed.png';
import ecfa from '../../assets/images/brand/ecfa-seal.png';
import ministrywatch from '../../assets/images/brand/ministrywatch-2026.jpg';
import { SITE, FOOTER_LINKS } from '../../lib/site';
import { ui, localizePath, fmt } from '../../i18n';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = ui(locale);
const nav = t.nav as Record<string, string>;
const footer = t.footer as Record<string, string>;
const year = new Date().getUTCFullYear();

// Brand glyphs in production's order (X, Instagram, Facebook, YouTube,
// LinkedIn), drawn on a 24×24 grid and filled with currentColor.
const socials = [
  {
    name: 'X',
    href: SITE.social.x,
    path: 'M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z',
  },
  {
    name: 'Instagram',
    href: SITE.social.instagram,
    path: 'M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.64-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98 1.28.06 1.69.07 4.95.07s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z',
  },
  {
    name: 'Facebook',
    href: SITE.social.facebook,
    path: 'M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.69.24 2.69.24v2.97h-1.51c-1.5 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.62 23.1 24 18.1 24 12.07z',
  },
  {
    name: 'YouTube',
    href: SITE.social.youtube,
    path: 'M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.81zM9.55 15.57V8.43L15.82 12z',
  },
  {
    name: 'LinkedIn',
    href: SITE.social.linkedin,
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
  },
];

const badgeImages = { ecfa, ministrywatch } as const;

// Production sets "Give With Confidence" in italics.
const trustParts = footer.trust.split(/(Give[\s ]With[\s ]Confidence)/);
const legal = [
  { href: '/privacy/', label: footer.privacy },
  { href: '/terms-of-use/', label: footer.terms },
  { href: '/charitable-solicitation-disclosures/', label: footer.disclosures },
];
---

<footer class="ft mt-auto">
  <div class="ft-main">
    <div class="ft-grid">
      <div class="ft-col ft-col-1">
        <Image src={logo} alt="unfoldingWord" widths={[250, 500]} sizes="250px" class="ft-logo" />
        <p class="ft-heading ft-lead">{footer.missionHeading}</p>
        <p class="ft-p">{footer.mission}</p>
        <ul class="ft-social">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener me" aria-label={s.name}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d={s.path} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav class="ft-col ft-col-2" aria-labelledby="footer-quick-links">
        <h2 id="footer-quick-links" class="ft-heading">{footer.quickLinks}</h2>
        <ul class="ft-links">
          {
            FOOTER_LINKS.map((l) => (
              <li>
                <a href={localizePath(l.href!, locale)}>{nav[l.key] ?? footer[l.key] ?? l.key}</a>
              </li>
            ))
          }
        </ul>
        <p class="ft-p ft-thanks"><em>{footer.thanks}</em></p>
      </nav>

      <div class="ft-col ft-col-3">
        <ul class="ft-badges">
          {
            SITE.trust.map((b) => (
              <li class={`ft-badge ft-badge-${b.name.toLowerCase()}`}>
                <a href={b.href} target={b.newTab ? '_blank' : undefined} rel={b.newTab ? 'noopener' : undefined} title={b.label}>
                  {b.badge in badgeImages ? (
                    <Image src={badgeImages[b.badge as keyof typeof badgeImages]} alt={b.alt} widths={[108, 216]} sizes="108px" loading="lazy" />
                  ) : (
                    <img src={b.badge} alt={b.alt} width="108" height="108" loading="lazy" decoding="async" />
                  )}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="ft-p ft-trust">
          {trustParts.map((part, i) => (i % 2 ? <i>{part}</i> : part))}
        </p>
      </div>
    </div>
  </div>

  <div class="ft-bottom">
    <p class="ft-copy">
      {fmt(footer.copyright, { year })} | <bdi dir="ltr">{SITE.addressDisplay}</bdi> | <bdi dir="ltr">{SITE.telephoneDisplay}</bdi>
      <span class="ft-legal">
        {legal.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> | </span>}
            <a href={localizePath(l.href, locale)}>{l.label}</a>
          </>
        ))}
      </span>
    </p>
  </div>
</footer>

<style>
  /* Production footer values (spec/footer.md). Sizes are fixed px, as on
     production; colors come from the brand tokens in global.css. */
  .ft {
    background: var(--color-tech);
    color: #fff;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
  }
  /* Every footer element below sets its own margins (global.css gives p,
     headings and lists theirs in @layer base, which these rules override). */
  .ft-heading,
  .ft-social,
  .ft-links,
  .ft-badges,
  .ft-copy {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ft a {
    color: #fff;
    font-weight: 400;
    text-decoration: none;
  }

  .ft-main {
    padding: 40px;
  }
  .ft-grid {
    max-width: 1000px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: center;
  }
  .ft-col {
    min-width: 0;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ft-heading {
    font-size: 24px;
    line-height: 24px;
    font-weight: 700;
    color: #fff;
    letter-spacing: normal;
    text-transform: none;
  }
  .ft-p {
    margin: 0 0 14.4px;
  }

  /* Column 1 */
  .ft-logo {
    display: block;
    width: 250px;
    max-width: 100%;
    height: auto;
  }
  .ft-lead {
    margin-block-start: 20px; /* 10 gap + 10 spacer + 10 gap */
  }
  .ft-social {
    margin-block-start: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 0 5px;
  }
  .ft-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #fff;
    color: var(--color-tech);
    transition: opacity 0.3s;
  }
  .ft-social a:hover {
    opacity: 0.9;
  }
  .ft-social svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Column 2 */
  .ft-col-2 {
    margin-block-start: 10px;
    text-align: center;
  }
  .ft-links a:hover {
    text-decoration: underline;
  }
  .ft-thanks {
    margin-block-start: 30px; /* 10 gap + 20 spacer + 10 gap */
    margin-block-end: 44.4px; /* 14.4 + 10 gap + 20 spacer */
  }

  /* Column 3 */
  .ft-col-3 {
    gap: 20px;
  }
  .ft-badges {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 20px;
  }
  .ft-badge {
    flex: 0 1 108px;
    min-width: 0;
  }
  .ft-badge a {
    display: block;
    transition: opacity 0.3s;
  }
  .ft-badge a:hover {
    opacity: 0.9;
  }
  .ft-badge img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Candid's seal is an inline image on production; its baseline gap makes
     the badge row 7px taller. */
  .ft-badge-candid img {
    display: inline;
    vertical-align: baseline;
  }
  .ft-trust {
    text-align: center;
  }

  /* Copyright line */
  .ft-bottom {
    padding: 0 20px 40px;
  }
  .ft-copy {
    max-width: 1000px;
    margin-inline: auto;
    font-size: 14px;
    line-height: 14px;
    text-align: center;
  }
  .ft-copy a:hover {
    text-decoration: underline;
  }
  /* Our legal links (production has none): a second, equally quiet line. */
  .ft-legal {
    display: block;
    margin-block-start: 8px;
  }

  /* Phones: one column; Quick Links and the thank-you go to the start edge. */
  @media (max-width: 767px) {
    .ft-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .ft-col-2 {
      text-align: start;
    }
  }

  /* Scripts whose glyphs need taller lines than production's Latin values. */
  :global(html[data-script='nastaliq']) .ft,
  :global(html[data-script='myanmar']) .ft {
    line-height: 1.9;
  }
  :global(html[data-script='nastaliq']) .ft-heading,
  :global(html[data-script='myanmar']) .ft-heading {
    line-height: 1.6;
  }
  :global(html[data-script='nastaliq']) .ft-copy,
  :global(html[data-script='myanmar']) .ft-copy {
    line-height: 1.9;
  }
</style>
