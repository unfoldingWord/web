---
// Site footer on a grainy Deep Ocean ground: the reversed logo, the
// tagline, a Give button and the social links; three link columns (the
// portfolios, ways to get involved, about); then the accountability seals,
// address and phone, the copyright and legal links, and the security phrase.
import { Image } from 'astro:assets';
import logo from '../../assets/brand/uw-logo-reversed.png';
import ecfa from '../../assets/images/brand/ecfa-seal.png';
import ministrywatch from '../../assets/images/brand/ministrywatch-2026.jpg';
import { SITE, FOOTER_LINKS, fallbackAttrs, ownsUiString } from '../../lib/site';
import { PORTFOLIOS } from '../../lib/portfolios';
import { ui, localizePath, fmt } from '../../i18n';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = ui(locale);
const nav = t.nav as Record<string, string>;
const footer = t.footer as Record<string, string>;
const year = new Date().getUTCFullYear();
// A string the locale lacks falls back to English; mark it so a right-to-left
// footer keeps its punctuation on the correct side.
const fa = (path: string) => fallbackAttrs(locale, path);

// The tagline marks the words that stand out: **white**, *Kindle*.
const tagline = (footer.tagline ?? '').split(/(\*\*[^*]+\*\*|\*[^*]+\*)/).filter(Boolean).map((part) =>
  part.startsWith('**') ? { text: part.slice(2, -2), cls: 'ft-tag-strong' } : part.startsWith('*') ? { text: part.slice(1, -1), cls: 'ft-tag-em' } : { text: part },
);

const columns = [
  { key: 'whatWeDo', links: PORTFOLIOS.map((p) => ({ label: nav[p.navKey] ?? p.key, href: p.href, attrs: fa(`nav.${p.navKey}`) })) },
  ...FOOTER_LINKS.map((c) => ({
    key: c.key,
    links: c.links.map((l) => {
      // The footer's own label, else the menu's, whichever this locale has.
      const path = ownsUiString(locale, `footer.${l.key}`) || !ownsUiString(locale, `nav.${l.key}`) ? `footer.${l.key}` : `nav.${l.key}`;
      const label = path.startsWith('nav.') ? nav[l.key] : (footer[l.key] ?? nav[l.key] ?? l.key);
      return { label, href: l.href!, attrs: fa(path) };
    }),
  })),
];

// Brand glyphs in production's order (X, Instagram, Facebook, YouTube,
// LinkedIn), drawn on a 24×24 grid and filled with currentColor.
const socials = [
  {
    name: 'X',
    href: SITE.social.x,
    path: 'M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z',
  },
  {
    name: 'Instagram',
    href: SITE.social.instagram,
    path: 'M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.64-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98 1.28.06 1.69.07 4.95.07s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z',
  },
  {
    name: 'Facebook',
    href: SITE.social.facebook,
    path: 'M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.69.24 2.69.24v2.97h-1.51c-1.5 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.62 23.1 24 18.1 24 12.07z',
  },
  {
    name: 'YouTube',
    href: SITE.social.youtube,
    path: 'M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.81zM9.55 15.57V8.43L15.82 12z',
  },
  {
    name: 'LinkedIn',
    href: SITE.social.linkedin,
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
  },
];

const badgeImages = { ecfa, ministrywatch } as const;
const legal = [
  { href: '/privacy/', label: footer.privacy, attrs: fa('footer.privacy') },
  { href: '/terms-of-use/', label: footer.terms, attrs: fa('footer.terms') },
  { href: '/charitable-solicitation-disclosures/', label: footer.disclosures, attrs: fa('footer.disclosures') },
];
---

<footer class="ft uw-grain-deep on-dark mt-auto">
  <div class="container-page ft-inner">
    <div class="ft-top">
      <div class="ft-brand">
        <Image src={logo} alt="unfoldingWord" height={40} width={Math.round((40 * logo.width) / logo.height)} densities={[1, 2]} class="ft-logo" />
        <p class="ft-tagline">
          <span {...fa('footer.tagline')}>{tagline.map((p) => (p.cls ? <span class={p.cls}>{p.text}</span> : p.text))}</span>
        </p>
        <div>
          <a href={localizePath('/give/', locale)} class="uw-btn uw-btn-give"><span {...fa('giveNow')}>{t.giveNow ?? 'Give now'}</span></a>
        </div>
        <ul class="ft-social" aria-label={footer.social}>
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener me" aria-label={s.name}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d={s.path} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        columns.map((c) => (
          <nav class="ft-col" aria-labelledby={`ft-h-${c.key}`}>
            <h2 id={`ft-h-${c.key}`} class="ft-heading"><span {...fa(`footer.${c.key}`)}>{footer[c.key]}</span></h2>
            <ul>
              {c.links.map((l) => (
                <li>
                  <a class="ft-link" href={localizePath(l.href, locale)}><span {...l.attrs}>{l.label}</span></a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="ft-bottom">
      <div class="ft-row">
        <ul class="ft-badges" aria-label={footer.trustSeals}>
          {
            SITE.trust.map((b) => (
              <li>
                <a href={b.href} target={b.newTab ? '_blank' : undefined} rel={b.newTab ? 'noopener' : undefined} title={b.label}>
                  {b.badge in badgeImages ? (
                    <Image src={badgeImages[b.badge as keyof typeof badgeImages]} alt={b.alt} widths={[56, 112]} sizes="56px" loading="lazy" />
                  ) : (
                    <img src={b.badge} alt={b.alt} width="56" height="56" loading="lazy" decoding="async" />
                  )}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="ft-contact">
          <bdi dir="ltr">{SITE.addressDisplay}</bdi>
          <span aria-hidden="true"> · </span>
          <a class="ft-link" href={`tel:${SITE.telephone}`}><bdi dir="ltr">{SITE.telephoneDisplay}</bdi></a>
        </p>
      </div>
      <div class="ft-row">
        <p><span {...fa('footer.copyright')}>{fmt(footer.copyright, { year })}</span></p>
        <ul class="ft-legal">
          {legal.map((l) => (
            <li>
              <a class="ft-link" href={localizePath(l.href, locale)}><span {...l.attrs}>{l.label}</span></a>
            </li>
          ))}
        </ul>
      </div>
      <p class="ft-security"><span {...fa('footer.security')}>{footer.security}</span></p>
    </div>
  </div>
</footer>

<style>
  .ft { color: var(--color-inspire-100); font-size: 1rem; line-height: 1.6; }
  .ft-inner { display: flex; flex-direction: column; gap: 40px; padding-block: 64px 32px; }
  .ft-top { display: flex; flex-wrap: wrap; gap: 40px 64px; }
  .ft-brand { flex: 2 1 380px; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .ft-logo { display: block; height: 40px; width: auto; }
  .ft-tagline { margin: 0; max-width: 420px; font-family: var(--font-heading); font-size: 1.625rem; line-height: 1.2; font-weight: 900; color: var(--color-inspire); }
  .ft-tag-strong { color: #fff; }
  .ft-tag-em { color: var(--color-kindle); }
  .ft-col { flex: 1 1 160px; min-width: 0; }
  .ft-heading { margin: 0 0 6px; font-family: var(--font-heading); font-size: 1rem; line-height: 1.6; font-weight: 900; color: var(--color-cultivate); }
  .ft ul { list-style: none; margin: 0; padding: 0; }
  .ft-link { color: #fff; font-weight: 400; text-decoration: none; }
  .ft-link:hover { color: var(--color-cultivate); text-decoration: underline; text-underline-offset: 3px; }
  .ft-col .ft-link { display: inline-block; padding-block: 6px; }
  .ft :focus-visible { outline-color: #fff; }

  .ft-social { display: flex; flex-wrap: wrap; gap: 4px; margin-inline-start: -10px !important; }
  .ft-social a { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 999px; color: #fff; }
  .ft-social a:hover { color: var(--color-cultivate); background: rgb(255 255 255 / 0.08); }
  .ft-social svg { width: 20px; height: 20px; fill: currentColor; }

  .ft-bottom { display: flex; flex-direction: column; gap: 12px; padding-top: 20px; border-top: 1px solid var(--color-ocean-700); font-size: 0.875rem; }
  .ft-bottom p { margin: 0; }
  .ft-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 32px; }
  .ft-badges { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .ft-badges a { display: block; border-radius: 999px; }
  .ft-badges img { display: block; width: 56px; height: 56px; object-fit: contain; border-radius: 999px; background: #fff; }
  .ft-legal { display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .ft-legal .ft-link, .ft-contact .ft-link { display: inline-flex; align-items: center; min-height: 32px; }
  .ft-security { font-style: italic; }
</style>
